---
/**
 * The whole site is one macOS window that never navigates away.
 * Titlebar, sidebar and status bar persist; only the content pane swaps.
 */
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import Titlebar from "@/components/Titlebar.astro";
import Tabs from "@/components/Tabs.astro";
import Sidebar from "@/components/Sidebar.astro";
import StatusBar from "@/components/StatusBar.astro";
import Terminal from "@/components/Terminal.astro";
import Explore from "@/components/Explore.astro";
import JsonLd from "@/components/JsonLd.astro";
import { SITE } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  ogSlug?: string;
  /** Loads the self-hosted KaTeX stylesheet, only on pages that need it. */
  math?: boolean;
  /** The "keep exploring" list at the foot of the page, on narrow screens. */
  explore?: boolean;
  /** og:type article — writing, not a landing page. */
  article?: boolean;
  /** ISO dates, for article:published_time / article:modified_time. */
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  /** Keeps the page live at its URL, but out of the index. */
  noindex?: boolean;
  /** schema.org node(s); see src/lib/schema.ts. */
  schema?: object | object[];
}

const {
  title = "Phil Vishnevsky — Full-Stack Engineer in Hartford",
  description = "Phil Vishnevsky is a full-stack engineer in Hartford, CT building servers, web apps, and games that don't break in production. Guides on Tailscale, VPNs, and self-hosting, plus the projects behind them.",
  ogSlug = "home",
  math = false,
  explore = true,
  article = false,
  publishedTime,
  modifiedTime,
  articleTags,
  noindex = false,
  schema,
} = Astro.props;

const ogUrl = new URL(`/og/${ogSlug}.png`, Astro.site).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {article && articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Writing`} href="/rss.xml" />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin.woff2" as="font" type="font/woff2" crossorigin />
    {math && <link rel="stylesheet" href="/katex/katex.css" />}
    <script is:inline>
      // Blocking, so the correct theme — and the window's size and whether
      // the explorer is put away — are painted on the first frame. A swap
      // replaces <html>'s attributes, so they're restored after every one.
      (function () {
        var r = document.documentElement;
        r.classList.add("js");
        function restore() {
          try {
            var t = localStorage.getItem("theme");
            if (t === "light" || t === "dark") r.setAttribute("data-theme", t);
            else r.removeAttribute("data-theme");
            if (localStorage.getItem("window-rail") === "hidden") r.setAttribute("data-rail", "hidden");
            else r.removeAttribute("data-rail");
            if (localStorage.getItem("window-zoom") === "full") r.setAttribute("data-zoom", "full");
            else r.removeAttribute("data-zoom");
          } catch (e) {}
        }
        restore();
        document.addEventListener("astro:after-swap", restore);
      })();
    </script>
    <ClientRouter />
    {schema && <JsonLd schema={schema} />}
  </head>

  <body>
    <a href="#main-content" class="skip">Skip to main content</a>

    <div class="window">
      <Titlebar />
      <Tabs />
      <div class="shell-body">
        <Sidebar />
        <main id="main-content" class="pane" tabindex="-1" transition:name="pane">
          <slot />
          {explore && <Explore />}
        </main>
        <div class="scrim" hidden data-scrim></div>
      </div>
      <StatusBar />
    </div>

    <Terminal transition:persist="terminal" />

    <script>
      import "@/scripts/theme";
      import "@/scripts/shell";
      import "@/scripts/sidebar";
      import "@/scripts/tabs";
      import "@/scripts/window";
      import "@/scripts/clock";
      import "@/scripts/terminal";
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: var(--s-4);
    top: var(--s-4);
    z-index: 10;
    background: var(--c-raised);
    color: var(--c-text);
    border: 1px solid var(--c-accent);
    padding: var(--s-2) var(--s-4);
  }

  /*
   * The gutter lives on the body. `margin: 24px auto` on the window gives
   * no side gutter at all until max-width binds, so the window went
   * edge-to-edge everywhere between 640px and 1168px.
   */
  body { padding: var(--s-5); }

  /*
   * The desktop the window sits on. Without it the window and the page
   * behind it were the same paper, and the gutter read as empty margin
   * rather than as somewhere the window was.
   */
  html { background: var(--c-wallpaper); }

  /*
   * The app has edges, so the page doesn't rubber-band past them and show
   * what's behind it. Vertical only: horizontal overscroll is the browser's
   * swipe-to-go-back, and that should keep working.
   */
  html, body { overscroll-behavior-y: none; }

  /*
   * The window stays put and scrolls its own contents, the way an app
   * window does: titlebar, tabs, explorer and status bar never move, and
   * the pane is the scroller. Not on a phone, where the window is the
   * whole screen anyway and the page's own scroll is what collapses the
   * browser's toolbars and scrolls to the top on a tap of the status bar.
   * Screen only, so printing still gets every page.
   */
  @media screen and (min-width: 641px) {
    html, body { height: 100%; overflow: hidden; }
    .window { height: calc(100dvh - var(--s-5) * 2); }
    .pane {
      overflow-y: auto;
      overscroll-behavior-y: none;
    }
  }
  /* The pane takes focus so the keyboard scrolls it; it's a region, not
     a control, so it has no ring. */
  .pane:focus { outline: none; }
  body {
    background: var(--wallpaper);
    background-attachment: fixed;
  }

  .window {
    display: flex;
    flex-direction: column;
    max-width: var(--w-content);
    min-height: calc(100vh - var(--s-5) * 2);
    margin-inline: auto;
    background: var(--c-bg);
    border: 1px solid var(--c-hairline-strong);
    border-radius: var(--radius-window);
    transition: max-width var(--dur-pane) var(--ease);
    /* `clip`, not `hidden`: hidden makes the window a scroll container,
       which silently disables position:sticky for everything inside it —
       the post outline and the reading-progress rule both depend on it. */
    overflow: clip;
  }

  /* Zoom: the window fills the screen instead of stopping at --w-content. */
  html[data-zoom="full"] .window { max-width: 100%; }

  /* Minimize: the explorer is put away. Only where it's a column; as a
     drawer it's already away. */
  @media (min-width: 901px) {
    html[data-rail="hidden"] #sidebar { display: none; }
  }

  /* Sidebar + content. */
  .shell-body {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* min-width: 0 keeps long code blocks from blowing out the flex layout. */
  .pane {
    flex: 1 1 auto;
    min-width: 0;
    padding: var(--s-5) var(--s-6);
  }

  /* Route changes are a pane swap, not a page fade. */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(pane) {
      animation: pane-out var(--dur-pane) var(--ease) both;
    }
    ::view-transition-new(pane) {
      animation: pane-in var(--dur-pane) var(--ease) both;
    }
  }
  @keyframes pane-out {
    to { opacity: 0; transform: translateY(6px); }
  }
  @keyframes pane-in {
    from { opacity: 0; }
  }

  /* The scrim that dims the window behind the mobile drawer. */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 2;
    background: var(--c-scrim);
  }
  .scrim[hidden] { display: none; }

  @media (max-width: 640px) {
    body { padding: 0; }
    .window {
      border: 0;
      border-radius: 0;
      min-height: 100vh;
    }
    .pane { padding: var(--s-4); }
  }
</style>
