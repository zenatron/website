---
/**
 * Not found, said the way the tailnet would: no route to the host that
 * was asked for. The browser then matches the path against every page,
 * project and post and offers the closest; without JavaScript it offers
 * three places to start.
 */
import Plain from "@/layouts/Plain.astro";
import { PAGES } from "@/data/site";
import { getAllBlogPosts } from "@/lib/blog";
import { getAllProjects, projectSlug } from "@/lib/projects";

const [posts, projects] = await Promise.all([getAllBlogPosts(), getAllProjects()]);
const candidates = [
  ...PAGES.map((p) => ({ href: p.href, name: p.name, title: p.blurb, aliases: p.aliases ?? [] })),
  { href: "/projects/", name: "projects", title: "Things I built", aliases: ["project", "work", "portfolio"] },
  { href: "/blog/", name: "blog", title: "Writing", aliases: ["writing", "posts", "articles"] },
  ...projects.map((p) => ({ href: `/projects/${projectSlug(p)}/`, name: projectSlug(p), title: p.data.title, aliases: [] })),
  ...posts.map((p) => ({ href: `/blog/${p.slug}/`, name: p.slug, title: p.data.title, aliases: [] })),
];
const starters = candidates.filter((c) => ["/about/", "/projects/", "/blog/"].includes(c.href));
---

<Plain title="Not found — Phil Vishnevsky" description="That page doesn’t exist." noindex>
  <main class="page nf">
    <p class="motto">no route to host.<span class="cursor" aria-hidden="true"></span></p>
    <h1 class="lede">
      <span class="dim">$ tailscale ping pvi.sh<span data-nf-path></span></span><br />
      This page doesn’t exist. It may have moved, or the link has a typo.
    </h1>

    <p class="dim label" data-nf-label>try one of these</p>
    <ul class="rows" data-nf-list>
      {starters.map((c) => (
        <li><a href={c.href}><span>{c.name}</span><span class="rule" aria-hidden="true" /><span class="dim">{c.title}</span></a></li>
      ))}
    </ul>
    <script type="application/json" data-nf-candidates set:html={JSON.stringify(candidates)} />
  </main>
</Plain>

<script>
  type C = { href: string; name: string; title: string; aliases: string[] };
  const path = location.pathname;
  const pathEl = document.querySelector("[data-nf-path]");
  if (pathEl) pathEl.textContent = path.replace(/\/$/, "");
  const all: C[] = JSON.parse(document.querySelector("[data-nf-candidates]")?.textContent ?? "[]");
  const words = path.toLowerCase().split(/[\/\-_.\s]+/).filter((w) => w.length > 1);

  // Levenshtein on short strings is cheap enough to run on every candidate.
  const dist = (a: string, b: string) => {
    const d = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      let prev = d[0];
      d[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const t = d[j];
        d[j] = Math.min(d[j] + 1, d[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
        prev = t;
      }
    }
    return d[b.length];
  };
  const score = (c: C) => {
    const names = [c.name, ...c.aliases].map((n) => n.toLowerCase());
    const hay = `${c.name} ${c.title}`.toLowerCase();
    let s = 0;
    for (const w of words) {
      if (hay.includes(w)) s += 3;
      const best = Math.min(...names.map((n) => dist(w, n) / Math.max(w.length, n.length)));
      if (best < 0.4) s += 4 * (1 - best);
    }
    return s;
  };
  const ranked = all
    .map((c) => ({ c, s: score(c) }))
    .filter((r) => r.s > 1.5)
    .sort((a, b) => b.s - a.s)
    .slice(0, 5);
  const list = document.querySelector("[data-nf-list]");
  if (ranked.length && list) {
    document.querySelector("[data-nf-label]")!.textContent = "did you mean";
    list.replaceChildren(
      ...ranked.map(({ c }) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = c.href;
        const name = document.createElement("span");
        name.textContent = c.name;
        const rule = document.createElement("span");
        rule.className = "rule";
        const title = document.createElement("span");
        title.className = "dim";
        title.textContent = c.title;
        a.append(name, rule, title);
        li.append(a);
        return li;
      })
    );
  }
</script>

<style>
  .nf {
    max-width: 44rem;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  h1.lede {
    font-weight: 400;
    margin-bottom: 3.5rem;
  }
  h1 .dim {
    font-family: var(--mono);
    font-size: 13px;
  }
  .label {
    margin: 0 0 0.75rem;
    font-size: 12px;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows :global(a) {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    color: inherit;
    text-decoration: none;
  }
  .rows :global(.rule) {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--fg) 25%, transparent);
    transform: translateY(-0.3em);
  }
  .rows :global(.dim) {
    max-width: 50%;
    overflow: hidden;
    font-size: 13px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
</style>
