---
/**
 * Photos: three columns sized so they all end at the same height, each
 * shot captioned on hover. Clicking one opens it full-screen; arrows,
 * swipes and Escape work there. Phones get one column with captions
 * underneath.
 */
import Plain from "@/layouts/Plain.astro";
import PageCover from "@/components/plain/PageCover.astro";
import { PHOTOS, PHOTO_WIDTHS, type Photo } from "@/data/photos";

const src = (id: string, w: number, ext: "avif" | "webp") => `/images/photos/${id}-${w}.${ext}`;
const srcset = (id: string, ext: "avif" | "webp") =>
  PHOTO_WIDTHS.map((w) => `${src(id, w, ext)} ${w}w`).join(", ");

// Newest first, dealt into the shortest column each time.
const shots = [...PHOTOS].reverse();
const COLS = 3;
const GAP_REM = 1;
const columns: number[][] = Array.from({ length: COLS }, () => []);
const heights = new Array(COLS).fill(0);
shots.forEach((p, i) => {
  const c = heights.indexOf(Math.min(...heights));
  columns[c].push(i);
  heights[c] += p.height / p.width;
});
const most = Math.max(...columns.map((c) => c.length));
/**
 * Width grows with 1/(sum of height/width); the basis makes up for
 * columns with fewer gaps. Scaled up because grow factors that sum
 * below 1 only hand out part of the free space.
 */
const flex = (col: number[]) => {
  const ratio = col.reduce((s, i) => s + shots[i].height / shots[i].width, 0);
  return `${100 / ratio} 1 ${((most - col.length) * GAP_REM) / ratio}rem`;
};
/** The order they read in and step through in the viewer. */
const hang = columns.flat();

const settings = (p: Photo) =>
  [
    p.focal && `${p.focal}mm`,
    p.aperture && `ƒ/${p.aperture}`,
    p.shutter && (p.shutter < 1 ? `1/${Math.round(1 / p.shutter)}s` : `${p.shutter}s`),
    p.iso && `ISO ${p.iso}`,
  ]
    .filter(Boolean)
    .join(" · ");
const when = (p: Photo) =>
  p.taken ? new Date(p.taken).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" }) : "";
const data = hang.map((i) => {
  const p = shots[i];
  return { id: p.id, title: p.title, alt: p.alt, place: p.place ?? "", when: when(p), settings: settings(p), note: p.note ?? "" };
});
---

<Plain title="Photos — Phil Vishnevsky" ogSlug="photos" description="Photos by Phil Vishnevsky, shot and edited on iPhone.">
  <PageCover motif="aperture" seed="photos" hue="green" />
  <main class="page photos">
    <header class="page-head">
      <div>
        <h1 class="sr-only">Photos</h1>
        <p class="motto">look up more often.<span class="cursor" aria-hidden="true"></span></p>
        <p class="lede">Shot on iPhone, edited on iPhone and Mac.</p>
      </div>
      <p class="dim count">{shots.length} photos</p>
    </header>

    <section class="wall" aria-label="Photos">
      {
        columns.map((col) => (
          <div class="col" style={{ flex: flex(col) }}>
            {col.map((i) => {
              const p = shots[i];
              return (
                <figure>
                  <button type="button" data-open={hang.indexOf(i)} aria-label={`View ${p.title} larger`} style={{ background: p.tone }}>
                    <picture>
                      <source type="image/avif" srcset={srcset(p.id, "avif")} sizes="(min-width: 1024px) 33vw, 100vw" />
                      <img
                        src={src(p.id, 960, "webp")}
                        srcset={srcset(p.id, "webp")}
                        sizes="(min-width: 1024px) 33vw, 100vw"
                        width={p.width}
                        height={p.height}
                        alt={p.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </button>
                  <figcaption>
                    <span class="t">{p.title}</span>
                    <span class="m">{[p.place, when(p)].filter(Boolean).join(" · ")}</span>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        ))
      }
    </section>
  </main>

  <dialog class="viewer" data-viewer aria-label="Photo">
    <div class="v-top">
      <button type="button" class="ink" data-close>close</button>
      <span class="v-nav">
        <button type="button" data-step="-1" aria-label="Previous photo">←</button>
        <span class="dim" data-index aria-live="polite"></span>
        <button type="button" data-step="1" aria-label="Next photo">→</button>
      </span>
    </div>
    <div class="v-stage" data-stage>
      <picture>
        <source type="image/avif" data-v-avif sizes="90vw" />
        <img data-v-img alt="" sizes="90vw" />
      </picture>
    </div>
    <div class="v-cap" data-stay>
      <span data-v-title></span> <span class="dim" data-v-meta></span>
      <span class="dim v-settings" data-v-settings></span>
      <span class="v-note" data-v-note></span>
    </div>
  </dialog>
</Plain>

<script define:vars={{ data, widths: [...PHOTO_WIDTHS] }}>
  const dialog = document.querySelector("[data-viewer]");
  const img = dialog.querySelector("[data-v-img]");
  const avif = dialog.querySelector("[data-v-avif]");
  const set = (id, ext) => widths.map((w) => `/images/photos/${id}-${w}.${ext} ${w}w`).join(", ");
  let at = 0;

  function show(i) {
    at = (i + data.length) % data.length;
    const p = data[at];
    avif.srcset = set(p.id, "avif");
    img.srcset = set(p.id, "webp");
    img.src = `/images/photos/${p.id}-${widths[widths.length - 1]}.webp`;
    img.alt = p.alt;
    dialog.querySelector("[data-v-title]").textContent = p.title;
    dialog.querySelector("[data-v-meta]").textContent = [p.place, p.when].filter(Boolean).join(" · ");
    dialog.querySelector("[data-v-settings]").textContent = p.settings;
    dialog.querySelector("[data-v-note]").textContent = p.note;
    dialog.querySelector("[data-index]").textContent = `${at + 1} / ${data.length}`;
  }

  document.querySelectorAll("[data-open]").forEach((b) =>
    b.addEventListener("click", () => {
      show(Number(b.dataset.open));
      dialog.showModal();
      document.documentElement.style.overflow = "hidden";
    })
  );
  dialog.addEventListener("close", () => (document.documentElement.style.overflow = ""));
  dialog.querySelector("[data-close]").addEventListener("click", () => dialog.close());
  dialog.querySelectorAll("[data-step]").forEach((b) => b.addEventListener("click", () => show(at + Number(b.dataset.step))));
  // A click on the background, beside the photo, closes it.
  dialog.addEventListener("click", (e) => {
    if (!e.target.closest("img, button, [data-stay]")) dialog.close();
  });
  addEventListener("keydown", (e) => {
    if (!dialog.open) return;
    if (e.key === "ArrowRight") show(at + 1);
    else if (e.key === "ArrowLeft") show(at - 1);
  });
  let start = null;
  dialog.addEventListener("touchstart", (e) => (start = { x: e.touches[0].clientX, y: e.touches[0].clientY }), { passive: true });
  dialog.addEventListener("touchend", (e) => {
    if (!start) return;
    const dx = e.changedTouches[0].clientX - start.x, dy = e.changedTouches[0].clientY - start.y;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(at + (dx < 0 ? 1 : -1));
    start = null;
  });
</script>

<style>
  .photos {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: max(1.5rem, 6vw);
    padding-right: max(1.5rem, 6vw);
  }
  .count {
    margin: 0;
    font-size: 13px;
  }
  .wall {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }
  figure {
    position: relative;
    margin: 0;
  }
  figure button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 3px;
    overflow: hidden;
    cursor: zoom-in;
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.5s ease-out;
  }
  figure:hover img {
    transform: scale(1.02);
  }
  figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    max-width: calc(100% - 1.5rem);
    display: flex;
    gap: 0.75rem;
    padding: 0.4rem 0.75rem;
    background: rgb(0 0 0 / 0.55);
    color: #f6f3ed;
    font-size: 12px;
    backdrop-filter: blur(12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  figure:hover figcaption,
  figure:focus-within figcaption {
    opacity: 1;
  }
  /* The title wins the room; the place and date give way, then drop
     to a second line when even the title needs the whole pill. */
  figcaption {
    flex-wrap: wrap;
    row-gap: 0.1rem;
    border-radius: 14px !important;
  }
  figcaption .t {
    flex-shrink: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  figcaption .m {
    flex: 1 1 0;
    min-width: 8ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.6;
  }
  @media (max-width: 1023px) {
    .wall {
      flex-direction: column;
      gap: 3rem;
    }
    .col {
      display: contents;
    }
    /* One shape for every shot on a phone, so the column reads evenly;
       the viewer still shows each one whole. */
    figure button {
      aspect-ratio: 4 / 5;
    }
    figure img {
      height: 100%;
      object-fit: cover;
    }
    figcaption {
      position: static;
      max-width: none;
      justify-content: space-between;
      padding: 0.75rem 0 0;
      background: none;
      color: inherit;
      opacity: 1;
      backdrop-filter: none;
    }
  }

  /* The viewer */
  .viewer {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ground);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 13px;
  }
  .viewer[open] {
    display: flex;
    flex-direction: column;
    cursor: zoom-out;
  }
  .viewer button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .v-top {
    display: flex;
    justify-content: space-between;
    padding: 1.25rem max(1.5rem, 6vw);
  }
  .v-nav {
    display: flex;
    gap: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .v-nav button {
    opacity: 0.5;
  }
  .v-nav button:hover {
    opacity: 1;
  }
  .v-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
  }
  .v-stage picture {
    display: contents;
  }
  .v-stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    cursor: auto;
  }
  .v-cap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 1.25rem max(1.5rem, 6vw) 1.5rem;
    cursor: auto;
  }
  .v-settings {
    flex-basis: 100%;
    font-size: 12px;
  }
  .v-note {
    flex-basis: 100%;
    max-width: 60ch;
    font-family: var(--sans);
    font-size: 13px;
    opacity: 0.7;
  }
  .v-note:empty {
    display: none;
  }
</style>
