---
/**
 * About, in the quiet layout: a few lines of who, then the timeline, what
 * I'm on now, the machines, and four principles. Plain rows throughout,
 * the same rhythm as /blog.
 */
import Plain from "@/layouts/Plain.astro";
import PageCover from "@/components/plain/PageCover.astro";
import { LOCATION, SITE, STATUS } from "@/data/site";
import { profilePageSchema } from "@/lib/schema";
import { MACHINES, NOW, NOW_UPDATED, PRINCIPLES, TIMELINE } from "@/data/about";

const nowUpdated = new Date(NOW_UPDATED).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<Plain
  title="About — Phil Vishnevsky"
  ogSlug="about"
  description="Phil Vishnevsky: software engineer, homelab tinkerer and game studio co-founder in ${LOCATION}."
  schema={profilePageSchema()}
>
  <PageCover motif="timeline" seed="about" hue="violet" />
  <main class="page about">
    <header class="page-head">
      <div>
        <h1 class="sr-only">About</h1>
        <p class="motto">write code, break things,<br />occasionally ship.<span class="cursor" aria-hidden="true"></span></p>
        <p class="lede">
          By day, a full-time software engineer. By night, a homelab at 99.99% uptime and card games with the studio
          I co-founded, all from a desk in {LOCATION}.
        </p>
      </div>
      <p class="dim side">
        <span class="status"></span>{STATUS}<br />
        <a class="ink" href={SITE.resume}>resume</a>
        <span class="sep"> / </span>
        <a class="ink" href="/dock/">dock</a>
        <span class="sep"> / </span>
        <a class="ink" href="/say-hi/">say hi</a>
      </p>
    </header>

    <section>
      <h2>timeline</h2>
      <ol class="rows">
        {
          TIMELINE.map((t) => (
            <li class="row">
              <span class="when dim">{t.year}</span>
              <div>
                <p class="what">
                  {t.title}
                  {t.role && <span class="dim"> · {t.role}</span>}
                </p>
                <p class="desc">{t.description}</p>
                {t.links && t.links.filter((l) => l.href.startsWith("http")).length > 0 && (
                  <p class="links">
                    {t.links
                      .filter((l) => l.href.startsWith("http"))
                      .map((l) => (
                        <a class="ink dim" href={l.href} target="_blank" rel="noopener">{l.label}</a>
                      ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section>
      <h2>now <span class="dim">· {nowUpdated}</span></h2>
      <div class="now">
        {
          NOW.map((g) => (
            <div>
              <p class="dim group">{g.heading.toLowerCase()}</p>
              <ul>
                {g.items.map((i) => (
                  <li>
                    {i.href ? <a class="ink" href={i.href}>{i.name}</a> : i.name}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>machines</h2>
      <div class="machines">
        {
          MACHINES.map((m) => (
            <div class="machine">
              <p class="host">
                {SITE.user}@<span>{m.name}</span>
              </p>
              <dl>
                {m.fields.map(([k, v]) => (
                  <>
                    <dt class="dim">{k}</dt>
                    <dd>{v}</dd>
                  </>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>principles</h2>
      <ol class="principles">
        {PRINCIPLES.map((p) => <li>{p}</li>)}
      </ol>
      <p><a class="ink dim" href="/blog/principles/">the long version →</a></p>
    </section>
  </main>
</Plain>

<style>
  .about {
    font-size: 14px;
  }
  .side {
    margin: 0;
    font-size: 13px;
    line-height: 2;
    text-align: right;
  }
  .status {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.5rem;
    background: var(--c-hue-green);
    transform: translateY(-1px);
  }
  .sep {
    opacity: 0.4;
  }
  section {
    margin-top: 4.5rem;
  }
  h2 {
    margin: 0 0 1.5rem;
    font-size: 13px;
    font-weight: 400;
    text-transform: lowercase;
    opacity: 0.6;
  }
  /* Not the lede: scoped, this would outrank the shared .lede spacing. */
  p:not(.lede) {
    margin: 0;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-top: 1px dotted color-mix(in srgb, var(--fg) 18%, transparent);
  }
  .when {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .desc {
    max-width: 60ch;
    margin-top: 0.35rem;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-muted);
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.4rem;
    font-size: 12px;
  }
  .now {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
  }
  .now ul,
  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 2;
  }
  .group {
    margin-bottom: 0.5rem;
    font-size: 12px;
  }
  .machines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem;
  }
  .host {
    margin-bottom: 0.75rem;
  }
  .host span {
    color: var(--c-accent);
  }
  dl {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0.2rem 1rem;
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
  }
  dd {
    margin: 0;
  }
  .principles {
    margin-bottom: 1rem;
    counter-reset: p;
  }
  .principles li::before {
    counter-increment: p;
    content: counter(p, decimal-leading-zero) "  ";
    opacity: 0.4;
  }
  @media (max-width: 640px) {
    .side {
      text-align: left;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
