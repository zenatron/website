---
/**
 * The dock: the apps I actually use, as a shelf. Small icons, a name,
 * a line on what it's for, grouped the way favorites.ts groups them.
 */
import Plain from "@/layouts/Plain.astro";
import PageCover from "@/components/plain/PageCover.astro";
import AppIcon from "@/components/AppIcon.astro";
import { CATEGORY_LABELS, FAVORITES } from "@/data/favorites";
import "@/styles/glass.css";

const order = ["apps", "tools", "hobbies", "lifestyle", "fun"] as const;
const groups = order
  .map((c) => ({ key: c, label: CATEGORY_LABELS[c], items: FAVORITES.filter((f) => f.category === c) }))
  .filter((g) => g.items.length > 0);
const count = FAVORITES.filter((f) => f.logo).length;
---

<Plain title="Dock — Phil Vishnevsky" description="The stuff I actually use." ogSlug="dock">
  <PageCover motif="dock" seed="dock" hue="orange" />
  <main class="page dock">
    <header class="page-head">
      <div>
        <h1 class="sr-only">Dock</h1>
        <p class="motto">good tools disappear.<span class="cursor" aria-hidden="true"></span></p>
        <p class="lede">{count} things I actually use, and what I do when I’m not using them. The hardware is on <a class="ink" href="/about/">about</a>.</p>
      </div>
    </header>

    {
      groups.map((g) => (
        <section>
          <h2>{g.label.toLowerCase()}</h2>
          <ul class="shelf">
            {g.items.map((f) => {
              const body = (
                <>
                  {f.logo ? (
                    <span class="icon"><AppIcon item={f} /></span>
                  ) : (
                    <span class="icon none" aria-hidden="true" />
                  )}
                  <span class="text">
                    <span class="name">{f.name}</span>
                    {f.description && <span class="dim note">{f.description}</span>}
                  </span>
                </>
              );
              return (
                <li>
                  {f.url ? <a href={f.url} rel="noopener noreferrer">{body}</a> : <div>{body}</div>}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </main>
</Plain>

<style>
  section + section {
    margin-top: 4rem;
  }
  h2 {
    margin: 0 0 1.25rem;
    font-size: 13px;
    font-weight: 400;
    opacity: 0.6;
  }
  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shelf a,
  .shelf div {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem 0;
    color: inherit;
    text-decoration: none;
  }
  .icon {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
  }
  .icon.none {
    width: 28px;
    background:
      radial-gradient(circle, color-mix(in srgb, var(--fg) 35%, transparent) 2px, transparent 2.5px) center / 100% 100%
        no-repeat;
  }
  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-size: 14px;
    transition: opacity 150ms ease;
  }
  .note {
    overflow: hidden;
    font-family: var(--sans);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .shelf:hover a .name {
    opacity: 0.45;
  }
  .shelf a:hover .name {
    opacity: 1;
  }
</style>
