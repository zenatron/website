---
import Shell from "@/layouts/Shell.astro";
import AppIcon from "@/components/AppIcon.astro";
import FileIcon from "@/components/FileIcon.astro";
import { DESK } from "@/data/desk";
import { FAVORITES } from "@/data/favorites";
import { MACHINES, NOW, PRINCIPLES } from "@/data/about";
import { FORTUNES } from "@/data/site";

/**
 * The dock (it was the desk): the apps I use and the things worth opening,
 * scattered on it. Icons are shown exactly as they ship — full color,
 * no tint — because an app icon is already a designed object.
 */

/** Deterministic jitter, so the scatter is organic but never moves. */
function seed(s: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return (h >>> 0) / 0xffffffff;
}
function jitter(name: string) {
  const a = seed(name), b = seed(name + "y"), c = seed(name + "r"), d = seed(name + "s");
  return {
    x: (a - 0.5) * 46,          // percent of a cell
    y: (b - 0.5) * 34,
    rot: (c - 0.5) * 13,        // degrees
    scale: 0.86 + d * 0.32,
  };
}

const apps = FAVORITES.filter((f) => f.logo);

type Item =
  | { kind: "app"; name: string; note?: string; href?: string; logo: string; appIcon: boolean; darkTile: boolean }
  | { kind: "file"; name: string; note?: string; file: string; href?: string; deskKind: string; icon: (typeof DESK)[number]["icon"] };

const items: Item[] = [
  ...DESK.map((o) => ({
    kind: "file" as const,
    name: o.file,
    note: o.note,
    file: o.file,
    href: o.href,
    deskKind: o.kind,
    icon: o.icon,
  })),
  ...apps.map((a) => ({
    kind: "app" as const,
    name: a.name,
    note: a.description,
    href: a.url,
    logo: a.logo!,
    appIcon: Boolean(a.appIcon),
    darkTile: Boolean(a.darkTile),
  })),
];
---

<Shell title="Dock | Phil Vishnevsky" description="The apps I actually use, and the things worth opening." ogSlug="dock">
  <header class="pagehead">
    <h1>Dock</h1>
    <p>
      {apps.length} apps I actually use, and a few things worth opening.
      <span class="hint-hover">Hover</span><span class="hint-tap">Tap</span> for what they are.
      The hardware they run on is on <a href="/about/#setup">the desk</a>.
    </p>
  </header>

  <div class="surface">
    <ul class="objects">
      {items.map((item) => {
        const j = jitter(item.name);
        const style = `--x:${j.x}%; --y:${j.y}%; --rot:${j.rot}deg; --scale:${j.scale}`;
        return (
          <li style={style}>
            {item.kind === "app" ? (
              <a href={item.href} rel="noopener noreferrer" class="obj">
                <span class="icon"><AppIcon item={item} /></span>
                <span class="label">
                  <span class="lname">{item.name}</span>
                  {item.note && <span class="lnote">{item.note}</span>}
                </span>
              </a>
            ) : item.deskKind === "link" ? (
              <a href={item.href} class="obj">
                <span class="icon"><FileIcon {...item.icon} /></span>
                <span class="label">
                  <span class="lname">{item.file}</span>
                  {item.note && <span class="lnote">{item.note}</span>}
                </span>
              </a>
            ) : (
              <button
                type="button"
                class="obj"
                data-open-file={item.deskKind}
                data-file-name={item.file}
                data-file-note={item.note}
              >
                <span class="icon"><FileIcon {...item.icon} /></span>
                <span class="label">
                  <span class="lname">{item.file}</span>
                  {item.note && <span class="lnote">{item.note}</span>}
                </span>
              </button>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <dialog class="win" data-win>
    <div class="win-bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="win-name" data-win-name></span>
    </div>
    {/*
      Every window's contents ship rendered and hidden inside the dialog;
      the script only switches between them. It used to build them from a
      JSON payload on click, which put the desk's only text where neither
      a crawler nor a no-JS visitor could read it.
    */}
    <div class="win-body" data-win-body>
      <div data-win-variant="neofetch" hidden>
        {MACHINES.map((m) => (
          <Fragment>
            <p class="host">phil@{m.name}</p>
            <dl class="spec">
              {m.fields.map(([k, v]) => (<Fragment><dt>{k}</dt><dd>{v}</dd></Fragment>))}
            </dl>
          </Fragment>
        ))}
      </div>
      <div data-win-variant="list" hidden>
        {NOW.map((g) => (
          <div class="group">
            <p class="group-head">{g.heading}</p>
            {g.items.map((it) => (
              <div class="row"><span>{it.name}</span><span>{it.status}</span></div>
            ))}
          </div>
        ))}
      </div>
      <div data-win-variant="text" hidden>
        {PRINCIPLES.map((line) => <p class="line">{line}</p>)}
      </div>
      <div data-win-variant="fortune" hidden>
        {FORTUNES.map((f) => <p class="quote">{f}</p>)}
      </div>
    </div>
    <div class="win-foot" data-win-foot></div>
  </dialog>
</Shell>

<style>
  /* "Hover" where you can, "Tap" where you can't. */
  .hint-tap { display: none; }
  @media (hover: none) {
    .hint-hover { display: none; }
    .hint-tap { display: inline; }
  }

  .pagehead { margin-bottom: var(--s-5); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }

  /*
   * The desk surface: a dot grid, like graph paper under the objects.
   * Not called `.table` — that's a Tailwind display utility, and it wins.
   */
  .surface {
    position: relative;
    padding: var(--s-6) var(--s-5) var(--s-8);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    background-color: var(--c-chrome);
    background-image: radial-gradient(var(--c-hairline) 1.4px, transparent 1.4px);
    background-size: 22px 22px;
    background-position: -11px -11px;
  }

  .objects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(112px, 1fr));
    gap: var(--s-5) var(--s-3);
  }
  /* The grid keeps it responsive; the jitter keeps it from looking like
     a grid. Positions are seeded by name, so nothing ever moves. */
  .objects li {
    position: relative;
    display: grid;
    place-items: center;
    transform: translate(var(--x), var(--y)) rotate(var(--rot));
  }
  /*
   * Each item's transform makes it its own stacking context, so a label's
   * z-index only ever applied inside its own object — later siblings
   * painted straight over it. Lift the whole object instead.
   */
  .objects li:hover,
  .objects li:focus-within {
    z-index: 5;
  }

  .obj {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }

  .icon {
    display: grid;
    place-items: center;
    width: calc(64px * var(--scale));
    height: calc(64px * var(--scale));
    transition: transform var(--dur-state) var(--ease);
  }

  /* The label is absolutely placed so revealing it moves nothing. */
  .label {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) rotate(calc(var(--rot) * -1));
    width: max-content;
    max-width: 150px;
    display: grid;
    gap: 1px;
    justify-items: center;
    text-align: center;
    padding: 5px 9px;
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    border: 1px solid var(--c-hairline);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-state) var(--ease);
    z-index: 2;
  }
  .lname {
    font-size: var(--t-sans-xs);
    font-weight: 600;
    line-height: 1.25;
  }
  .lnote {
    font-size: var(--t-mono-xs);
    font-family: var(--font-mono);
    color: var(--c-muted);
    line-height: 1.3;
  }

  .obj:focus-visible .label { opacity: 1; }
  .obj:focus-visible .icon { transform: translateY(-6px) scale(1.08); }
  @media (hover: hover) {
    .obj:hover .label { opacity: 1; }
    .obj:hover .icon { transform: translateY(-6px) scale(1.08); }
  }

  /* Window */
  .win {
    padding: 0;
    width: min(560px, calc(100vw - var(--s-6)));
    max-height: min(70vh, 620px);
    background: var(--c-bg);
    color: var(--c-text);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .win::backdrop { background: var(--c-scrim); }
  .win:focus, .win:focus-visible { outline: none; }
  .win-bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: var(--h-titlebar);
    padding-inline: var(--s-3);
    background: var(--c-chrome);
    border-bottom: 1px solid var(--c-hairline);
  }
  .lights { display: flex; gap: var(--s-2); }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: var(--c-trafficlight); }
  .win-name {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-muted);
  }
  .win-body {
    padding: var(--s-4);
    overflow-y: auto;
    max-height: calc(70vh - var(--h-titlebar) - 44px);
  }
  .win-foot {
    padding: var(--s-2) var(--s-3);
    border-top: 1px solid var(--c-hairline);
    background: var(--c-chrome);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-muted);
  }
  .win-foot:empty { display: none; }

  .win-body :global(.spec) {
    display: grid;
    grid-template-columns: 9ch minmax(0, 1fr);
    gap: 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: 1.95;
  }
  .win-body :global(.spec dt) { color: var(--c-dim); }
  .win-body :global(.spec dd) { margin: 0; color: var(--c-text); }
  .win-body :global(.host) {
    font-family: var(--font-mono);
    font-size: var(--t-mono-md);
    color: var(--c-accent);
    margin-bottom: var(--s-2);
  }
  .win-body :global(.host + .spec) { margin-bottom: var(--s-5); }
  .win-body :global(.group-head) {
    font-size: var(--t-sans-sm);
    font-weight: 600;
    margin-bottom: var(--s-2);
  }
  .win-body :global(.group + .group) { margin-top: var(--s-5); }
  .win-body :global(.row) {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: 3px;
    font-size: var(--t-sans-sm);
  }
  .win-body :global(.row span:last-child) {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    flex: 0 0 auto;
  }
  .win-body :global(.line) { font-size: var(--t-sans-lg); line-height: 1.6; }
  .win-body :global(.quote) { font-size: var(--t-sans-md); line-height: 1.6; }

  @media (max-width: 640px) {
    .surface { padding: var(--s-5) var(--s-3); }
    .objects {
      grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
      gap: var(--s-5) var(--s-2);
    }
    /* Touch has no hover, so the labels sit under every object. */
    .label { opacity: 1; position: static; transform: none; border: 0; background: none; padding: 4px 0 0; max-width: 92px; }
    .lnote { display: none; }
  }
</style>

<script>
  import "@/scripts/desk";
</script>
