---
import Shell from "@/layouts/Shell.astro";
import { FAVORITES, CATEGORY_LABELS, type Favorite } from "@/data/favorites";

/**
 * The wall renders each logo twice from one vendored file:
 *
 *   at rest  — as a `mask-image`, which discards the source artwork's own
 *              colours entirely and paints with background-color. That is
 *              the only treatment that normalises this set, which mixes
 *              flat fills, gradients and currentColor.
 *   on hover — as a plain <img>, for true brand colour.
 */
const HUES = ["violet", "orange", "blue", "green", "accent", "link"] as const;
function hueFor(s: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return HUES[(h >>> 0) % HUES.length];
}

const withLogos = FAVORITES.filter((f): f is Favorite & { logo: string } => Boolean(f.logo));
const categories = [...new Set(withLogos.map((f) => f.category))];
---

<Shell title="Stack | Phil Vishnevsky" description="The tools and apps I actually use." ogSlug="stack">
  <header class="pagehead">
    <h1>Stack</h1>
    <p>{withLogos.length} tools and apps I actually use. Hover for the details.</p>
  </header>

  <div class="filters" role="group" aria-label="Filter by category">
    <button type="button" data-filter="all" aria-pressed="true">All</button>
    {categories.map((c) => (
      <button type="button" data-filter={c} aria-pressed="false">{CATEGORY_LABELS[c]}</button>
    ))}
  </div>

  <ul class="wall" data-wall>
    {withLogos.map((item) => {
      const hue = hueFor(item.name);
      const Tag = item.url ? "a" : "div";
      return (
        <li
          class="tile"
          data-category={item.category}
          data-flat={item.flat ? "" : undefined}
          style={`--fg: var(--c-hue-${hue}, var(--c-${hue})); --bg: var(--c-tint-${hue});`}
        >
          <Tag
            {...(item.url ? { href: item.url, rel: "noopener noreferrer" } : {})}
            aria-label={item.description ? `${item.name} — ${item.description}` : item.name}
          >
            <span class="glyph">
              {!item.flat && <span class="mono" style={`--src: url(/logos/${item.logo})`}></span>}
              <img src={`/logos/${item.logo}`} alt="" width="40" height="40" loading="lazy" decoding="async" />
            </span>
            <span class="name">{item.name}</span>
            {item.description && <span class="desc">{item.description}</span>}
          </Tag>
        </li>
      );
    })}
  </ul>

  <p class="empty" data-empty hidden>Nothing in that category yet.</p>
</Shell>

<style>
  .pagehead { margin-bottom: var(--s-5); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }
  .filters button {
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
    padding: 5px 14px;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background var(--dur-state) var(--ease), color var(--dur-state) var(--ease),
      border-color var(--dur-state) var(--ease);
  }
  @media (hover: hover) {
    .filters button:hover {
    color: var(--c-text); background: var(--c-chrome);
    }
  }
  .filters button[aria-pressed="true"] {
    color: var(--c-accent);
    background: var(--c-tint-accent);
    border-color: transparent;
  }

  .wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: var(--s-3);
  }

  .tile { min-width: 0; }
  .tile[hidden] { display: none; }

  .tile > :global(*) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-3);
    height: 100%;
    text-align: center;
    color: inherit;
    background: var(--c-chrome);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    transition: background var(--dur-state) var(--ease), border-color var(--dur-state) var(--ease);
  }
  .tile > :global(*:focus-visible) {
    background: var(--bg);
    border-color: transparent;
  }
  @media (hover: hover) {
    .tile > :global(*:hover) {
      background: var(--bg);
      border-color: transparent;
    }
  }

  .glyph {
    position: relative;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
  }

  /* Monochrome: the mask ignores whatever colours the source SVG carries. */
  .mono {
    position: absolute;
    inset: 0;
    background: var(--fg);
    -webkit-mask-image: var(--src);
    mask-image: var(--src);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    transition: opacity var(--dur-state) var(--ease);
  }
  .glyph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity var(--dur-state) var(--ease), filter var(--dur-state) var(--ease);
  }
  .tile > :global(*:focus-visible) .mono { opacity: 0; }
  .tile > :global(*:focus-visible) .glyph img { opacity: 1; }
  @media (hover: hover) {
    .tile > :global(*:hover) .mono { opacity: 0; }
    .tile > :global(*:hover) .glyph img { opacity: 1; }
  }

  /*
   * Backplate logos can't be masked into a silhouette, so they desaturate
   * at rest and come back to full colour on hover — same behaviour, a
   * different mechanism.
   */
  .tile[data-flat] .glyph img {
    opacity: 1;
    filter: grayscale(1) contrast(0.85) opacity(0.55);
  }
  .tile[data-flat] > :global(*:focus-visible) .glyph img { filter: none; }
  @media (hover: hover) {
    .tile[data-flat] > :global(*:hover) .glyph img { filter: none; }
  }

  .name {
    font-size: var(--t-sans-sm);
    font-weight: 600;
    line-height: 1.3;
  }
  .desc {
    font-size: var(--t-sans-xs);
    color: var(--c-muted);
    line-height: 1.4;
  }

  .empty { color: var(--c-muted); }

  /* Touch has no hover, so show brand colour outright. */
  @media (hover: none) {
    .mono { opacity: 0; }
    .glyph img { opacity: 1; }
    .tile[data-flat] .glyph img { filter: none; }
  }
</style>

<script>
  import "@/scripts/stack";
</script>
