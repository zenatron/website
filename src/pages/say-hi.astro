---
/**
 * Say hi (it was "elsewhere").
 *
 * Two kinds of link, and the page says so. The ways to reach me lead, as
 * two big cards, because for someone deciding whether to get in touch
 * they're the point of the page. The profiles follow as one grouped list,
 * the way System Settings groups rows, with the same icons as the dock.
 */
import Shell from "@/layouts/Shell.astro";
import AppIcon from "@/components/AppIcon.astro";
import ReachCards from "@/components/ReachCards.astro";
import { links } from "@/lib/links";

const profiles = links.filter((l) => !l.reach);
/* rel=me: these are Phil's profiles, and this page is his — the rel ties them together. */
const rel = (url: string) => (url.startsWith("http") ? "me noopener noreferrer" : undefined);
---

<Shell title="Say hi | Phil Vishnevsky" description="Email, book a call, or find me on the rest of the internet." ogSlug="say-hi">
  <header class="pagehead">
    <h1>Say hi</h1>
    <p>
      Where to find me. For what I <em>use</em> rather than where I am, that's
      <a href="/dock/">the dock</a>.
    </p>
  </header>

  <p class="label">get in touch</p>
  <div class="reach"><ReachCards /></div>

  <p class="label">around the web</p>
  <ul class="group">
    {profiles.map((l) => (
      <li>
        <a class="glint-host" href={l.url} rel={rel(l.url)}>
          <span class="icon"><AppIcon item={l} /></span>
          <span class="text">
            <span class="title">{l.title}</span>
            {l.description && <span class="desc">{l.description}</span>}
          </span>
          {l.handle && <span class="handle">{l.handle}</span>}
          <svg class="go" aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 11 11 5" /><path d="M6 5h5v5" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</Shell>

<style>
  .pagehead { margin-bottom: var(--s-6); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }
  .pagehead em { font-style: italic; }
  .pagehead a {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The homepage's "currently" label, for the same job. */
  .label {
    margin-bottom: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: 0.08em;
    color: var(--c-dim);
  }

  ul { list-style: none; margin: 0; padding: 0; }

  .go {
    flex: 0 0 auto;
    color: var(--c-dim);
    transition: color var(--dur-state) var(--ease), transform var(--dur-state) var(--ease);
  }

  .reach { margin-bottom: var(--s-7); }

  /* Profiles: one grouped list, separators inset past the icon. */
  .group {
    background: var(--c-chrome);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .group li { position: relative; }
  .group li + li::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: calc(var(--s-4) + 40px + var(--s-4));
    height: 1px;
    background: var(--c-hairline);
  }
  .group a {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto 16px;
    grid-template-areas: "icon text handle go";
    align-items: center;
    column-gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    color: inherit;
    transition: background var(--dur-state) var(--ease);
  }
  .group .icon { grid-area: icon; width: 40px; height: 40px; }
  .text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .title {
    font-size: var(--t-sans-md);
    font-weight: 600;
    line-height: 1.35;
  }
  .desc {
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
    line-height: 1.4;
  }
  .handle {
    grid-area: handle;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-dim);
    white-space: nowrap;
  }
  .group .go { grid-area: go; }

  @media (hover: hover) {
    .group a:hover { background: var(--c-raised); }
    .group a:hover .title { color: var(--c-link); }
    .group a:hover .go { color: var(--c-text); transform: translate(2px, -2px); }
  }
  .group a:focus-visible { outline-offset: -2px; }

  /* Narrow: the handle drops under the description instead of competing
     with it for a line. */
  @media (max-width: 600px) {
    .group a {
      grid-template-columns: 40px minmax(0, 1fr) 16px;
      grid-template-areas:
        "icon text go"
        "icon handle go";
      row-gap: 2px;
    }
    .handle { font-size: var(--t-mono-xs); white-space: normal; overflow-wrap: anywhere; }
  }
</style>
