---
/**
 * Say hi: the ways to reach me first, then where else I am, as plain
 * rows of name, what it's for, and the handle you'd type.
 */
import Plain from "@/layouts/Plain.astro";
import { links } from "@/lib/links";

const reach = links.filter((l) => l.reach);
const profiles = links.filter((l) => !l.reach);
/* rel=me: these are my profiles, and this page is mine. */
const rel = (url: string) => (url.startsWith("http") ? "me noopener noreferrer" : undefined);
---

<Plain title="Say hi — Phil Vishnevsky" description="Email, book a call, or find me on the rest of the internet." ogSlug="say-hi">
  <main class="page hi">
    <header class="page-head">
      <div>
        <h1 class="sr-only">Say hi</h1>
        <p class="motto">ping me.<span class="cursor" aria-hidden="true"></span></p>
        <p class="lede">Email is the reliable way. For what I use rather than where I am, see <a class="ink" href="/dock/">the dock</a>.</p>
      </div>
    </header>

    <ul class="reach">
      {
        reach.map((l) => (
          <li>
            <a href={l.url} rel={rel(l.url)}>
              <span class="dim">{l.description?.toLowerCase()}</span>
              <span class="big">{l.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2>elsewhere</h2>
    <ul class="rows">
      {
        profiles.map((l) => (
          <li>
            <a href={l.url} rel={rel(l.url)}>
              <span class="name">{l.title}</span>
              <span class="dim desc">{l.description}</span>
              <span class="rule" aria-hidden="true" />
              <span class="handle">{l.handle} ↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Plain>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    text-decoration: none;
  }
  .reach {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2.5rem;
    margin-bottom: 5rem;
  }
  .reach a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .reach .dim {
    font-size: 12px;
  }
  .big {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: color-mix(in srgb, currentColor 25%, transparent);
    transition: text-decoration-color 150ms ease;
  }
  .reach a:hover .big {
    text-decoration-color: currentColor;
  }
  h2 {
    margin: 0 0 1rem;
    font-size: 13px;
    font-weight: 400;
    opacity: 0.6;
  }
  .rows a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
  }
  .rows:hover .name {
    opacity: 0.45;
  }
  .rows a:hover .name {
    opacity: 1;
  }
  .name {
    transition: opacity 150ms ease;
  }
  .desc {
    font-family: var(--sans);
    font-size: 13px;
  }
  .rule {
    flex: 1;
    min-width: 2rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--fg) 25%, transparent);
    transform: translateY(-0.3em);
  }
  .handle {
    font-size: 13px;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .rows a {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
    .desc,
    .rule {
      display: none;
    }
  }
</style>
