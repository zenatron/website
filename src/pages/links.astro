---
import Shell from "@/layouts/Shell.astro";
import { links } from "@/lib/links";

const HUES = ["violet", "orange", "blue", "green", "accent", "link"] as const;
function hueFor(s: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return HUES[(h >>> 0) % HUES.length];
}
---

<Shell title="Elsewhere | Phil Vishnevsky" description="Where to find me on the rest of the internet." ogSlug="links">
  <header class="pagehead">
    <h1>Elsewhere</h1>
    <p>
      Where to find me. For what I <em>use</em> rather than where I am, that's
      <a href="/stack">the stack</a>.
    </p>
  </header>

  <ul class="places">
    {links.map((link) => {
      const hue = hueFor(link.title);
      return (
        <li style={`--fg: var(--c-hue-${hue}, var(--c-${hue})); --bg: var(--c-tint-${hue})`}>
          <a href={link.url} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}>
            <span class="mark" aria-hidden="true">
              {link.logo ? (
                link.flat
                  ? <img src={`/logos/${link.logo}`} alt="" width="28" height="28" loading="lazy" />
                  : <span class="mono" style={`--src: url(/logos/${link.logo})`}></span>
              ) : (
                <span class="initial">{link.title.charAt(0)}</span>
              )}
            </span>
            <span class="text">
              <span class="title">{link.title}</span>
              {link.handle && <span class="handle">{link.handle}</span>}
              {link.description && <span class="desc">{link.description}</span>}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</Shell>

<style>
  .pagehead { margin-bottom: var(--s-6); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }
  .pagehead em { font-style: italic; }
  .pagehead a {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .places {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--s-3);
    margin: 0;
    padding: 0;
  }
  .places li {
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    transition: background var(--dur-state) var(--ease), border-color var(--dur-state) var(--ease);
  }
  .places li:hover {
    background: var(--bg);
    border-color: transparent;
  }
  .places a {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-4);
    color: inherit;
  }

  .mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-card);
    background: var(--bg);
    position: relative;
  }
  .places li:hover .mark { background: var(--c-bg); }
  .mono {
    position: absolute;
    inset: 8px;
    background: var(--fg);
    -webkit-mask-image: var(--src);
    mask-image: var(--src);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }
  .mark img { width: 28px; height: 28px; object-fit: contain; }
  .initial {
    font-family: var(--font-mono);
    font-size: var(--t-sans-lg);
    color: var(--fg);
    line-height: 1;
  }

  .text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .title { font-size: var(--t-sans-md); font-weight: 600; }
  .handle {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--fg);
    word-break: break-all;
  }
  .desc { font-size: var(--t-sans-sm); color: var(--c-muted); }
</style>
