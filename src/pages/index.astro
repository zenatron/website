---
/**
 * Home: one screen, the tailnet behind it, a few lines of who I am in
 * the bottom-left corner.
 */
import Plain from "@/layouts/Plain.astro";
import Tailnet from "@/components/plain/Tailnet.astro";
import { SITE, STATUS } from "@/data/site";
import { personSchema, websiteSchema } from "@/lib/schema";

const SOCIALS = [
  { label: "github", href: SITE.github },
  { label: "linkedin", href: "https://www.linkedin.com/in/philvishnevsky/" },
  { label: "email", href: `mailto:${SITE.email}` },
  { label: "resume", href: SITE.resume },
  { label: "say hi", href: "/say-hi/" },
];
---

<Plain fixed schema={[personSchema(), websiteSchema()]}>
  <main class="home">
    <Tailnet />
    <header class="intro">
      <p class="motto" data-mesh-avoid>
        small machines,<br />quietly talking<span class="cursor" aria-hidden="true"></span>
      </p>
      <div class="bio" data-mesh-frost>
        {/* A shell prompt opens the panel, its three lights in the mesh's own cells. */}
        <p class="prompt" aria-hidden="true">
          <span class="lights"><i></i><i></i><i></i></span>
          <span>{SITE.user}@{SITE.host} ~ % whoami</span>
        </p>
        <h1>Hi, I’m <span class="name">Phil</span>.</h1>
        <p>Software engineer @ RTX, out of {SITE.city}, CT.</p>
        {/* Each mention wears its own colour, the project's where it has one. */}
        <p class="past">
          Before that, <a class="ink tag" style="--h: var(--c-hue-violet)" href="/about/">CEM</a> (intern), Shortlist, and co-founding
          <a class="ink tag" style="--h: var(--c-hue-ember)" href="https://underscore.games" target="_blank" rel="noopener">Underscore Games</a>.
        </p>
        <p>
          Currently building <a class="ink tag" style="--h: var(--c-hue-teal)" href="/projects/preamble/">preamble</a>, and self-hosting
          <a class="ink tag" style="--h: var(--c-hue-blue)" href="/blog/">everything I can</a>.
        </p>
        <p class="status"><i aria-hidden="true"></i>{STATUS}</p>
        <p class="socials">
          {
            SOCIALS.map(({ label, href }, i) => (
              <>
                {i > 0 && <span class="sep"> / </span>}
                {/* The label hugs its tags: whitespace inside a link would be underlined too. */}
                <a class="ink" href={href} {...(href.startsWith("http") && { target: "_blank", rel: "noopener" })}>{label}</a>
              </>
            ))
          }
        </p>
      </div>
    </header>
  </main>
</Plain>

<style>
  .home {
    position: relative;
    height: 100dvh;
    overflow: hidden;
  }
  .intro {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(3rem, 14vh, 8rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: min(54rem, calc(100vw - 3rem));
    pointer-events: none;
  }
  .intro > * {
    pointer-events: auto;
    width: fit-content;
  }
  /* Frosted, so packets crossing behind the words stay visible, softened. The
     negative margin keeps the text lined up with the motto above it. */
  .bio {
    margin-left: -1.5rem;
    padding: 1.25rem 1.5rem;
    font-size: 15px;
    line-height: max(22px, 3vh);
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);
    background: color-mix(in srgb, var(--ground) 52%, transparent);
    -webkit-backdrop-filter: blur(3px) saturate(1.4);
    backdrop-filter: blur(3px) saturate(1.4);
  }
  .bio h1,
  .bio p {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
  }
  .socials {
    margin-top: 0.35rem !important;
  }

  /* The prompt: three cells for the window's lights, then the command. */
  .prompt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem !important;
    font-size: 12px;
    color: var(--fg-muted);
  }
  .lights {
    display: flex;
    gap: 4px;
  }
  .lights i {
    width: 6px;
    height: 6px;
    background: var(--c-hue-ember);
  }
  .lights i:nth-child(2) {
    background: var(--c-hue-orange);
  }
  .lights i:nth-child(3) {
    background: var(--c-hue-green);
  }
  .bio h1 {
    margin-bottom: 0.35rem !important;
    font-size: 22px !important;
    letter-spacing: -0.01em;
  }
  /* The name in the accent, underlined with a row of cells. */
  .name {
    color: var(--c-accent);
    background: radial-gradient(circle, var(--c-accent) 0 1.5px, transparent 1.6px) 0 100% / 6px 3px repeat-x;
    padding-bottom: 4px;
  }
  /* A mention: a square of its colour before it, its underline in that colour. */
  .tag {
    text-decoration-color: color-mix(in srgb, var(--h) 55%, transparent) !important;
  }
  .tag::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.4em;
    transform: translateY(-2px);
    background: var(--h);
  }
  .tag:hover,
  .tag:focus-visible {
    color: var(--h);
    text-decoration-color: var(--h) !important;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem !important;
    font-size: 13px;
    color: var(--fg-muted);
  }
  .status i {
    width: 6px;
    height: 6px;
    background: var(--c-hue-green);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status i {
      animation: none;
    }
  }
  .socials a {
    opacity: 0.6;
  }
  .socials a:hover,
  .socials a:focus-visible {
    opacity: 1;
  }
  .sep {
    opacity: 0.4;
  }
  /* On a phone the intro keeps to the bottom third or so, so the mesh above it
     has room to make sense: the name, the role, what's on now, and the links.
     The motto, the prompt, the history and the status wait for a wider screen. */
  @media (max-width: 640px) {
    .intro {
      left: 1.5rem;
      right: 1.5rem;
      bottom: 1.5rem;
      gap: 0;
    }
    .motto,
    .prompt,
    .past,
    .status {
      display: none;
    }
    .bio {
      margin-left: -0.75rem;
      padding: 0.85rem 0.75rem;
      font-size: 13px;
      line-height: 1.55;
    }
    .bio h1 {
      font-size: 18px !important;
      margin-bottom: 0.2rem !important;
    }
    .socials {
      margin-top: 0.5rem !important;
    }
  }
</style>
