---
/**
 * Home: one screen, the tailnet behind it, a few lines of who I am in
 * the bottom-left corner.
 */
import Plain from "@/layouts/Plain.astro";
import Tailnet from "@/components/plain/Tailnet.astro";
import { SITE } from "@/data/site";
import { personSchema, websiteSchema } from "@/lib/schema";

const SOCIALS = [
  { label: "github", href: SITE.github },
  { label: "linkedin", href: "https://www.linkedin.com/in/philvishnevsky/" },
  { label: "email", href: `mailto:${SITE.email}` },
  { label: "resume", href: SITE.resume },
  { label: "say hi", href: "/say-hi/" },
];
---

<Plain fixed schema={[personSchema(), websiteSchema()]}>
  <main class="home">
    <Tailnet />
    <header class="intro">
      <p class="motto" data-mesh-avoid>
        small machines,<br />quietly talking<span class="cursor" aria-hidden="true"></span>
      </p>
      <div class="bio" data-mesh-frost>
        <h1>Hi, I’m Phil.</h1>
        <p>Software engineer @ RTX, out of {SITE.city}, CT.</p>
        <p>
          Before that, <a class="ink" href="/about/">CEM</a> (intern), Shortlist, and co-founding
          <a class="ink" href="https://underscore.games" target="_blank" rel="noopener">Underscore Games</a>.
        </p>
        <p>
          Currently building <a class="ink" href="/projects/preamble/">preamble</a>, and self-hosting
          <a class="ink" href="/blog/">everything I can</a>.
        </p>
        <p class="socials">
          {
            SOCIALS.map(({ label, href }, i) => (
              <>
                {i > 0 && <span class="sep"> / </span>}
                <a class="ink" href={href} {...(href.startsWith("http") && { target: "_blank", rel: "noopener" })}>
                  {label}
                </a>
              </>
            ))
          }
        </p>
      </div>
    </header>
  </main>
</Plain>

<style>
  .home {
    position: relative;
    height: 100dvh;
    overflow: hidden;
  }
  .intro {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(3rem, 14vh, 8rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: min(54rem, calc(100vw - 3rem));
    pointer-events: none;
  }
  .intro > * {
    pointer-events: auto;
    width: fit-content;
  }
  /* Frosted, so packets crossing behind the words stay visible, softened. The
     negative margin keeps the text lined up with the motto above it. */
  .bio {
    margin-left: -1.5rem;
    padding: 1.25rem 1.5rem;
    font-size: 15px;
    line-height: max(22px, 3vh);
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);
    background: color-mix(in srgb, var(--ground) 52%, transparent);
    -webkit-backdrop-filter: blur(3px) saturate(1.4);
    backdrop-filter: blur(3px) saturate(1.4);
  }
  .bio h1,
  .bio p {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
  }
  .socials {
    margin-top: 1.5vh !important;
  }
  .socials a {
    opacity: 0.6;
  }
  .socials a:hover,
  .socials a:focus-visible {
    opacity: 1;
  }
  .sep {
    opacity: 0.4;
  }
  @media (max-width: 640px) {
    .intro {
      left: 1.5rem;
      bottom: 2.5rem;
      gap: 1.75rem;
    }
    .bio {
      margin-left: -1rem;
      padding: 1rem;
      font-size: 14px;
      line-height: 1.6;
    }
  }
</style>
