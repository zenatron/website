---
import Shell from "@/layouts/Shell.astro";
import { cardArt } from "@/lib/cardart";
import Cells from "@/components/Cells.astro";
import Contact from "@/components/Contact.astro";
import Mark from "@/components/Mark.astro";
import HeroArt from "@/components/HeroArt.astro";
import { SITE } from "@/data/site";
import { getAllBlogPosts } from "@/lib/blog";
import { getAllProjects, projectSlug } from "@/lib/projects";

const [posts, projects] = await Promise.all([getAllBlogPosts(), getAllProjects()]);

const monthYear = (v: string | Date | undefined) => {
  if (!v) return undefined;
  const d = new Date(v);
  return Number.isNaN(d.getTime())
    ? undefined
    : d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

const latestProjects = await Promise.all(projects.slice(0, 3).map(async (p) => ({
  title: p.data.title,
  href: `/projects/${projectSlug(p)}`,
  slug: projectSlug(p),
  description: p.data.description || undefined,
  tags: p.data.tags ?? [],
  meta: monthYear(p.data.date),
  art: await cardArt({
    slug: projectSlug(p),
    title: p.data.title,
    thumbnail: p.data.thumbnail,
    collection: "projects",
  }),
})));

const latestPosts = await Promise.all(posts.slice(0, 3).map(async (p) => ({
  title: p.data.title,
  href: `/blog/${p.slug}`,
  slug: p.slug,
  description: p.data.excerpt || undefined,
  tags: p.data.tags ?? [],
  meta: monthYear(p.data.date),
  art: await cardArt({ slug: p.slug, title: p.data.title, collection: "blog" }),
})));
---

<Shell>
  <section class="hero">
    <div class="intro">
      <h1>{SITE.name}</h1>
      <p class="statement">
        a full-stack engineer in <Mark hue="violet">Hartford</Mark>
        building <Mark hue="blue">servers,</Mark>
        <Mark hue="green">web apps,</Mark> and
        <Mark hue="orange">games</Mark> that don't break in production.
      </p>

      <p class="currently-label">currently</p>
      <dl class="currently">
        <div class="row">
          <dt style="--fg: var(--c-accent); --bg: var(--c-tint-accent)">open</dt>
          <dd>to <Mark hue="accent">opportunities</Mark></dd>
        </div>
        <div class="row">
          <dt style="--fg: var(--c-hue-green); --bg: var(--c-tint-green)">building</dt>
          <dd>a <Mark hue="link">FLAC organizer</Mark>, and tools for card games</dd>
        </div>
        <div class="row">
          <dt style="--fg: var(--c-hue-blue); --bg: var(--c-tint-blue)">running</dt>
          <dd>a <Mark hue="blue">homelab</Mark> with <span class="nines" title="four nines">99.99%</span> uptime</dd>
        </div>
      </dl>
    </div>

    <div class="art"><HeroArt /></div>
  </section>

  <section class="band">
    <div class="bandhead">
      <h2>Projects</h2>
      <a href="/projects">All projects</a>
    </div>
    <Cells cells={latestProjects} />
  </section>

  <section class="band">
    <div class="bandhead">
      <h2>Writing</h2>
      <a href="/blog">All posts</a>
    </div>
    <Cells cells={latestPosts} />
  </section>

  <Contact />
</Shell>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--s-7);
    align-items: center;
    padding-block: var(--s-5) var(--s-6);
  }

  h1 {
    font-size: var(--t-sans-3xl);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .statement {
    margin-top: var(--s-4);
    font-size: var(--t-sans-xl);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  /*
   * Each line gets a real labelled column instead of a loose asterisk:
   * the state is a mono chip, the thing itself stays in the author's
   * voice, and the sentences align down the list.
   */
  .currently-label {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: 0.08em;
    color: var(--c-dim);
  }
  /* One grid for the whole list, shared by every row through subgrid, so
     the chip column is exactly as wide as the widest chip and the
     sentences line up at any width. */
  .currently {
    margin: var(--s-3) 0 0;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--s-2) var(--s-3);
  }
  .currently .row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
  }
  .currently dt {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--fg);
    background: var(--bg);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    line-height: 1.4;
  }
  .currently dd {
    margin: 0;
    font-size: var(--t-sans-sm);
    line-height: 1.6;
    color: var(--c-muted);
  }

  /* The figure is the claim, so it's set like one: the machine's voice,
     in the text colour, with figures that don't jiggle. */
  .nines {
    font-family: var(--font-mono);
    font-size: 0.92em;
    font-variant-numeric: tabular-nums;
    color: var(--c-text);
    letter-spacing: -0.01em;
  }

  /*
   * Narrow: the chips keep their column rather than stacking over their
   * sentences — stacked, the three rows came apart into six loose lines.
   * Hairlines hold each row together as one line of a list.
   */
  @media (max-width: 480px) {
    .currently { row-gap: 0; }
    .currently .row { padding-block: var(--s-3); }
    .currently .row + .row { border-top: 1px solid var(--c-hairline); }
    .currently dd { font-size: var(--t-sans-xs); line-height: 1.55; }
  }

  /* min-width: 0, or the dock strip on a phone sizes the column to all
     sixteen icons instead of scrolling inside the screen. */
  .art { max-width: 100%; min-width: 0; }

  .band { padding-block: var(--s-6); }
  .band + .band { border-top: 1px solid var(--c-hairline); }

  .bandhead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }
  .bandhead h2 {
    font-size: var(--t-sans-xl);
    font-weight: 600;
  }
  .bandhead a {
    font-size: var(--t-sans-sm);
    color: var(--c-link);
  }
  @media (hover: hover) {
    .bandhead a:hover {
    text-decoration: underline; text-underline-offset: 3px;
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
      padding-block: var(--s-5) var(--s-6);
    }
    .statement { max-width: none; font-size: var(--t-sans-lg); }
    h1 { font-size: var(--t-sans-2xl); }
  }
</style>
