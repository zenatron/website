---
import Shell from "@/layouts/Shell.astro";
import { getAllProjects, projectSlug } from "@/lib/projects";
const projects = await getAllProjects();
---
<Shell title="Projects | Phil Vishnevsky" ogSlug="projects">
  <h1>Projects</h1>
  <ul>{projects.map((p) => <li><a href={`/projects/${projectSlug(p)}`}>{p.data.title}</a></li>)}</ul>
</Shell>
