---
import Shell from "@/layouts/Shell.astro";
import PageHead from "@/components/PageHead.astro";
import { cardArt } from "@/lib/cardart";
import Cells from "@/components/Cells.astro";
import Archive from "@/components/Archive.astro";
import { getAllProjects, projectHue, projectSlug } from "@/lib/projects";

const projects = await getAllProjects();

const monthYear = (v: string | Date | undefined) => {
  if (!v) return undefined;
  const d = new Date(v);
  return Number.isNaN(d.getTime())
    ? undefined
    : d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
};

/**
 * The things I built get cards; the data mining coursework gets the same
 * numbered index it has on /blog. As cards, seven exercises outnumbered
 * the four projects people actually come here for.
 */
const isCoursework = (p: (typeof projects)[number]) => p.data.type === "data";
const built = projects.filter((p) => !isCoursework(p));
const coursework = projects
  .filter(isCoursework)
  .reverse()
  .map((p, i) => ({
    slug: projectSlug(p),
    href: `/projects/${projectSlug(p)}/`,
    title: p.data.title.replace(/^Intro to Data Mining:\s*/, ""),
    note: p.data.description || undefined,
    order: i + 1,
    date: p.data.date,
  }));

const cells = await Promise.all(built.map(async (p) => ({
  title: p.data.title,
  href: `/projects/${projectSlug(p)}/`,
  slug: projectSlug(p),
  description: p.data.description || undefined,
  meta: monthYear(p.data.date),
  hue: projectHue(p),
  art: await cardArt({
    slug: projectSlug(p),
    title: p.data.title,
    thumbnail: p.data.thumbnail,
    collection: "projects",
  }),
})));
---
<Shell title="Projects | Phil Vishnevsky" description="My experiments, projects, and failures." ogSlug="projects">
  <PageHead title="Projects">
    Experiments, coursework, and things I built because they didn’t exist yet.
  </PageHead>
  <Cells cells={cells} layout="pairs" />

  {coursework.length > 0 && (
    <Archive
      title="Data mining coursework"
      blurb="Exercises and projects from an intro data mining course, in the order they were assigned — from Python basics to clustering wines."
      entries={coursework}
      initial={coursework.length}
    />
  )}
</Shell>

