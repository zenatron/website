---
/**
 * The things I built, side by side in one strip that starts on the
 * page's column and runs off the right edge. A vertical wheel or swipe
 * glides it sideways (see the script). Phones get a plain list.
 * Coursework is listed under the strip, out of the way.
 */
import Plain from "@/layouts/Plain.astro";
import PixelArt from "@/components/plain/PixelArt.astro";
import PageCover from "@/components/plain/PageCover.astro";
import sharp from "sharp";
import { join } from "node:path";
import { getAllProjects, projectHue, projectSlug } from "@/lib/projects";

const projects = await getAllProjects();
const isCoursework = (p: (typeof projects)[number]) => p.data.type === "data";
const year = (v?: string) => (v ? new Date(v).getUTCFullYear() : "");

/** Whether a screenshot is a phone's (tall) or a window's (wide), so the tile can frame it right. */
const shape = async (src?: string) => {
  if (!src) return undefined;
  try {
    const { width = 1, height = 1 } = await sharp(join(process.cwd(), "public", src)).metadata();
    return height > width ? "tall" : "wide";
  } catch {
    return "wide";
  }
};

const built = await Promise.all(projects
  .filter((p) => !isCoursework(p))
  .map(async (p) => ({
    slug: projectSlug(p),
    title: p.data.title,
    description: p.data.tagline ?? p.data.description,
    year: year(p.data.date),
    thumb: p.data.thumbnail,
    motif: p.data.motif,
    hue: projectHue(p) ?? "blue",
    shape: await shape(p.data.thumbnail),
  })));
const coursework = projects.filter(isCoursework).map((p) => ({
  slug: projectSlug(p),
  title: p.data.title.replace(/^Intro to Data Mining:\s*/, ""),
}));
---

<Plain title="Projects — Phil Vishnevsky" ogSlug="projects" fixed>
  <PageCover motif="commits" seed="projects" hue="rose" />
  <main class="projects">
    <h1 class="sr-only">Projects</h1>
    <div class="strip" data-strip>
      {
        built.map((p, i) => (
          <a class="tile" href={`/projects/${p.slug}/`} data-vt="forward" data-slug={p.slug}>
            {/* The project's pixel art, in its own colour, with the screenshot whole on top of it. */}
            <div class="frame" style={`--tile-hue: var(--c-hue-${p.hue})`}>
              <PixelArt motif={p.motif} seed={p.slug} hue={p.hue} dim={!!p.thumb} />
              {p.thumb && (
                <img
                  class:list={["shot", p.shape]}
                  src={p.thumb}
                  alt=""
                  loading={i < 2 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                />
              )}
              <span class="pill">view project</span>
            </div>
            <div class="caption">
              <span class="name">{p.title}</span>
              <span class="year">{p.year}</span>
            </div>
            {p.description && <p class="tagline">{p.description}</p>}
          </a>
        ))
      }
      <aside class="coursework">
        <p class="year">coursework · data mining</p>
        <ul>
          {coursework.map((c) => (
            <li><a class="ink" href={`/projects/${c.slug}/`}>{c.title}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </main>
</Plain>

<script>
  /**
   * A vertical wheel turns into a sideways glide that eases toward its
   * target; sideways swipes over the strip are left to the browser.
   * Arrow and page keys step it. Below 1024px the strip is a list and
   * none of this runs.
   */
  const GLIDE = 0.18;
  const STEPS: Record<string, number> = {
    ArrowRight: 0.1, ArrowDown: 0.1, ArrowLeft: -0.1, ArrowUp: -0.1,
    PageDown: 0.8, PageUp: -0.8, " ": 0.8, End: Infinity, Home: -Infinity,
  };
  const strip = document.querySelector<HTMLElement>("[data-strip]");
  const desktop = matchMedia("(min-width: 1024px)");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (strip) {
    // Back from a project, open on the one just viewed.
    const lastKey = "projects-last";
    try {
      const last = sessionStorage.getItem(lastKey);
      const el = last && strip.querySelector<HTMLElement>(`[data-slug="${CSS.escape(last)}"]`);
      if (el && desktop.matches) strip.scrollLeft = el.offsetLeft - parseFloat(getComputedStyle(strip).paddingLeft);
    } catch {}
    strip.addEventListener("click", (e) => {
      const tile = (e.target as Element).closest<HTMLElement>("[data-slug]");
      try { if (tile) sessionStorage.setItem(lastKey, tile.dataset.slug!); } catch {}
    });

    let target = strip.scrollLeft;
    let raf = 0;
    const glide = () => {
      const before = strip.scrollLeft;
      strip.scrollLeft += (target - before) * GLIDE;
      // Scroll positions round to whole pixels and stall short of the target.
      if (strip.scrollLeft === before) {
        strip.scrollLeft = target;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(glide);
    };
    const glideBy = (delta: number) => {
      const max = strip.scrollWidth - strip.clientWidth;
      target = Math.max(0, Math.min(max, (raf ? target : strip.scrollLeft) + delta));
      if (still) strip.scrollLeft = target;
      else if (!raf) raf = requestAnimationFrame(glide);
    };

    addEventListener("wheel", (e) => {
      if (!desktop.matches) return;
      const sideways = Math.abs(e.deltaX) > Math.abs(e.deltaY);
      if (sideways && strip.contains(e.target as Node)) {
        cancelAnimationFrame(raf);
        raf = 0;
        return;
      }
      e.preventDefault();
      const d = sideways ? e.deltaX : e.deltaY;
      glideBy(e.deltaMode === 1 ? d * 16 : d);
    }, { passive: false });

    addEventListener("keydown", (e) => {
      const step = STEPS[e.key];
      if (!desktop.matches || step === undefined || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === " " && e.target instanceof HTMLButtonElement) return;
      e.preventDefault();
      glideBy((e.key === " " && e.shiftKey ? -step : step) * strip.clientWidth);
    });
  }
</script>

<style>
  /* The strip fills what the cover leaves, centred in it. */
  .projects {
    height: calc(100dvh - clamp(140px, 14vw, 210px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 2rem;
  }
  .strip {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    /* The column's left edge, but on a very wide screen no more than 12vw in. */
    padding: 0 max(1.5rem, min(var(--gutter), 12vw));
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .tile {
    display: block;
    width: min-content;
    flex-shrink: 0;
    color: inherit;
    text-decoration: none;
  }
  /* Sized by the window's height, but never a wall: a big screen gets more
     tiles in view, not bigger ones. */
  .frame {
    position: relative;
    aspect-ratio: 3 / 2;
    height: clamp(15rem, 46vh, 27rem);
    overflow: hidden;
    border-radius: 6px;
    background: color-mix(in srgb, var(--tile-hue) 9%, var(--ground));
  }
  /* The screenshot sits whole on the art, never cropped: a window's wide,
     a phone's tall. */
  .shot {
    position: absolute;
    top: 50%;
    left: 50%;
    max-width: 82%;
    max-height: 74%;
    width: auto;
    height: auto;
    border-radius: 8px;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent),
      0 18px 40px rgb(0 0 0 / 0.35);
    transform: translate(-50%, -50%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shot.tall {
    max-height: 86%;
    border-radius: 14px;
  }
  .tile:hover .shot,
  .tile:focus-visible .shot {
    transform: translate(-50%, -52%) scale(1.03);
  }
  .pill {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    color: #f6f3ed;
    font-size: 12px;
    opacity: 0;
    transform: translateY(4px);
    backdrop-filter: blur(12px);
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
    pointer-events: none;
  }
  .tile:hover .pill,
  .tile:focus-visible .pill {
    opacity: 1;
    transform: none;
  }
  .caption {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.75rem;
    white-space: nowrap;
  }
  .year {
    margin: 0;
    font-size: 12px;
    color: var(--fg-muted);
  }
  .tagline {
    margin: 0.25rem 0 0;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .coursework {
    flex-shrink: 0;
    align-self: flex-end;
    width: 18rem;
    padding-left: 2rem;
    font-size: 13px;
  }
  .coursework ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    line-height: 2;
  }
  .coursework a {
    opacity: 0.7;
  }

  /* Phones and narrow windows: a plain list, scrolling the page. */
  @media (max-width: 1023px) {
    :global(html.fixed) {
      overflow: auto;
    }
    .projects {
      height: auto;
      padding: 1rem 1.5rem 4rem;
    }
    .strip {
      flex-direction: column;
      gap: 3.5rem;
      overflow: visible;
      padding: 0;
    }
    .tile,
    .coursework {
      width: 100%;
    }
    .frame {
      height: auto;
      width: 100%;
      aspect-ratio: 3 / 2;
      border-radius: 1rem;
    }
    .pill {
      display: none;
    }
    .coursework {
      align-self: auto;
      padding: 0;
    }
  }
</style>
