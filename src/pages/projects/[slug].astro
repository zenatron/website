---
import Shell from "@/layouts/Shell.astro";
import { cardArt } from "@/lib/cardart";
import PostMeta from "@/components/PostMeta.astro";
import Tags from "@/components/Tags.astro";
import CardArt from "@/components/CardArt.astro";
import Cells from "@/components/Cells.astro";
import { getAllProjects, getSuggestedProjects, projectSlug } from "@/lib/projects";

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((entry) => ({
    params: { slug: projectSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = projectSlug(entry);
const { Content } = await entry.render();
const heroArt = await cardArt({
  slug,
  title: entry.data.title,
  thumbnail: entry.data.thumbnail,
  collection: "projects",
  context: "hero",
});

const hasMath = /\$\$|\\\(|\\\[|\$[^$\n]+\$/.test(entry.body ?? "");

const external = [
  entry.data.github && { label: "Source", href: entry.data.github },
  (entry.data.live || entry.data.demoUrl) && {
    label: "Live",
    href: entry.data.live || entry.data.demoUrl,
  },
].filter(Boolean) as { label: string; href: string }[];

const downloads = entry.data.downloads ?? [];

const suggested = await Promise.all((await getSuggestedProjects(slug, 3)).map(async (p) => ({
  title: p.data.title,
  href: `/projects/${projectSlug(p)}`,
  slug: projectSlug(p),
  description: p.data.description || undefined,
  tags: p.data.tags ?? [],
  art: await cardArt({
    slug: projectSlug(p),
    title: p.data.title,
    thumbnail: p.data.thumbnail,
    collection: "projects",
  }),
})));
---

<Shell
  title={`${entry.data.title} | Phil Vishnevsky`}
  description={entry.data.description}
  ogSlug={`projects/${slug}`}
  math={hasMath}
>
  <article>
    <div class="hero"><CardArt art={heroArt} slug={slug} crop /></div>
    <header>
      <h1>{entry.data.title}</h1>
      <PostMeta date={entry.data.date} />
      {entry.data.tags && entry.data.tags.length > 0 && (
        <div class="tagrow"><Tags tags={entry.data.tags} /></div>
      )}
      {(external.length > 0 || downloads.length > 0) && (
        <ul class="actions">
          {external.map((link) => (
            <li><a href={link.href} rel="noopener noreferrer">{link.label}</a></li>
          ))}
          {downloads.map((d) => (
            <li>
              <a href={`/downloads/${d.filename}`} download>{d.label ?? d.filename}</a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose"><Content /></div>
  </article>

  {suggested.length > 0 && (
    <section class="more">
      <h2>More projects</h2>
      <Cells cells={suggested} />
    </section>
  )}
</Shell>

<style>
  .hero {
    container-type: inline-size;
    aspect-ratio: 21 / 7;
    overflow: hidden;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    margin-bottom: var(--s-5);
  }
  header {
    padding-bottom: var(--s-5);
    margin-bottom: var(--s-6);
    border-bottom: 1px solid var(--c-hairline);
  }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: 26ch;
  }
  .tagrow { margin-top: var(--s-4); }
  .actions {
    list-style: none;
    display: flex;
    gap: var(--s-2);
    margin: var(--s-4) 0 0;
    padding: 0;
    width: fit-content;
    flex-wrap: wrap;
  }
  .actions li {
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .actions a {
    display: block;
    padding: var(--s-2) var(--s-4);
    font-size: var(--t-sans-sm);
    color: var(--c-link);
    transition: background var(--dur-state) var(--ease);
  }
  @media (hover: hover) {
    .actions a:hover {
    background: var(--c-raised);
    }
  }
  .more {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-hairline);
  }
  .more h2 {
    font-size: var(--t-sans-xl);
    font-weight: 600;
    margin-bottom: var(--s-5);
  }
</style>
