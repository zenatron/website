---
/**
 * A project, in the quiet layout: a way back to the strip, what kind of
 * thing it is and when, its name and one line, where to use it, a banner
 * when there's a real landscape image, then the writing. The way back
 * plays the strip's slide in reverse.
 */
import Plain from "@/layouts/Plain.astro";
import { cardArt } from "@/lib/cardart";
import { getAllProjects, projectSlug, PROJECT_KIND } from "@/lib/projects";
import { creativeWorkSchema, isoDate } from "@/lib/schema";
import "@/styles/article.css";

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((entry) => ({ params: { slug: projectSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const slug = projectSlug(entry);
const { Content } = await entry.render();
const hero = await cardArt({
  slug,
  title: entry.data.title,
  thumbnail: entry.data.thumbnail,
  collection: "projects",
  context: "hero",
});
const banner = hero.kind === "image" ? hero.src : null;
const hasMath = /\$\$|\\\(|\\\[|\$[^$\n]+\$/.test(entry.body ?? "");

const kind = PROJECT_KIND[entry.data.type]?.label ?? "project";
const coursework = entry.data.type === "data";
const made = entry.data.date
  ? new Date(entry.data.date).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" })
  : undefined;
const source = entry.data.github || entry.data.githubRepo;
const live = entry.data.live || entry.data.demoUrl;
const downloads = entry.data.downloads ?? [];

// Next and previous among the same group (built things, or coursework).
const peers = (await getAllProjects()).filter((p) => (p.data.type === "data") === coursework);
const i = peers.findIndex((p) => projectSlug(p) === slug);
const at = (n: number) => (peers[n] ? { slug: projectSlug(peers[n]), title: peers[n].data.title } : null);
const newer = at(i - 1);
const older = at(i + 1);
---

<Plain
  title={`${entry.data.title} — Phil Vishnevsky`}
  description={entry.data.description}
  ogSlug={`projects/${slug}`}
  math={hasMath}
  schema={creativeWorkSchema({
    name: entry.data.title,
    description: entry.data.description,
    path: `/projects/${slug}/`,
    date: isoDate(entry.data.date),
    image: new URL(`/og/projects/${slug}.png`, Astro.site).href,
    tags: entry.data.tags,
    repo: source,
    live,
  })}
>
  <main class="article project" data-pagefind-body>
    <a class="a-back" href="/projects/" data-vt={coursework ? undefined : "back"}>← projects</a>
    <header class="a-head">
      <p class="a-meta kicker">
        <span>{kind}</span>
        {made && <span>{made}</span>}
        {entry.data.tags.length > 0 && <span>{entry.data.tags.join(", ")}</span>}
      </p>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="desc">{entry.data.description}</p>}
      {
        (live || source || downloads.length > 0) && (
          <p class="a-meta links">
            {live && <a class="ink" href={live} rel="noopener noreferrer">live ↗</a>}
            {source && <a class="ink" href={source} rel="noopener noreferrer">source ↗</a>}
            {downloads.map((d) => (
              <a class="ink" href={`/downloads/${d.filename}`} download>
                {d.label ?? d.filename} ↓
              </a>
            ))}
          </p>
        )
      }
    </header>

    {banner && (
      <figure class="banner">
        <img src={banner} alt="" />
      </figure>
    )}

    <div class="prose"><Content /></div>

    {
      (newer || older) && (
        <nav class="a-foot a-pager" aria-label="More projects">
          {older && (
            <a class="prev" href={`/projects/${older.slug}/`}>
              <small>← older</small>
              {older.title}
            </a>
          )}
          {newer && (
            <a class="next" href={`/projects/${newer.slug}/`}>
              <small>newer →</small>
              {newer.title}
            </a>
          )}
        </nav>
      )
    }
  </main>
</Plain>

<script>
  import "@/scripts/code";
</script>

<style>
  .kicker {
    margin: 0 0 0.75rem !important;
  }
  .desc {
    max-width: 36rem;
    margin-top: 1rem;
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.5rem !important;
    font-size: 13px;
  }
  .links a {
    color: var(--fg) !important;
  }
  /* Wider than the column, the way the strip's tiles are big. */
  .banner {
    margin: 0 -4rem 3.5rem !important;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 960px) {
    .banner {
      margin: 0 0 2.5rem !important;
      border-radius: 1rem;
    }
  }
</style>
