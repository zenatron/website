---
/**
 * A project, the way the strip promised it: a pixel-art cover in the
 * project's own colour, then its name and the one line, a paragraph on
 * what it is, where to use it, the lead image, and the story told
 * between galleries. Previous and next wrap around the strip's order, so
 * there's always somewhere to go, and the way back slides to the strip.
 */
import Plain from "@/layouts/Plain.astro";
import PageCover from "@/components/plain/PageCover.astro";
import { cardArt } from "@/lib/cardart";
import { getAllProjects, projectHue, projectSlug, PROJECT_KIND } from "@/lib/projects";
import { creativeWorkSchema, isoDate } from "@/lib/schema";
import "@/styles/article.css";

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((entry) => ({ params: { slug: projectSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const slug = projectSlug(entry);
const { Content } = await entry.render();
const hero = await cardArt({
  slug,
  title: entry.data.title,
  thumbnail: entry.data.thumbnail,
  collection: "projects",
  context: "hero",
});
const lead = hero.kind === "image" ? hero.src : null;
/** A demo loop leads instead of the still, when there is one; the still is its poster. */
const video = entry.data.video;
const hasMath = /\$\$|\\\(|\\\[|\$[^$\n]+\$/.test(entry.body ?? "");

const coursework = entry.data.type === "data";
const kind = PROJECT_KIND[entry.data.type]?.label ?? "project";
const hue = projectHue(entry) ?? "blue";
const motif = entry.data.motif ?? (coursework ? "clusters" : "clusters");

/** "Fall 2026", the way a term or a season of work is remembered. */
const season = (v?: string) => {
  if (!v) return undefined;
  const d = new Date(v);
  const m = d.getUTCMonth();
  const name = m < 2 || m === 11 ? "Winter" : m < 5 ? "Spring" : m < 8 ? "Summer" : "Fall";
  return `${name} ${m === 11 ? d.getUTCFullYear() + 1 : d.getUTCFullYear()}`;
};

const source = entry.data.github || entry.data.githubRepo;
const live = entry.data.live || entry.data.demoUrl;
const downloads = entry.data.downloads ?? [];
const host = (u: string) => {
  try {
    const url = new URL(u);
    return `${url.host.replace(/^www\./, "")}${url.pathname}`.replace(/\/+$/, "");
  } catch {
    return u;
  }
};

// Pager: the same group, in the strip's order, wrapping around.
const peers = (await getAllProjects()).filter((p) => (p.data.type === "data") === coursework);
const i = peers.findIndex((p) => projectSlug(p) === slug);
const card = (p: (typeof peers)[number]) => ({
  slug: projectSlug(p),
  title: p.data.title,
  line: p.data.tagline ?? p.data.description,
  thumb: p.data.thumbnail,
  hue: projectHue(p) ?? "blue",
});
const prev = peers.length > 1 ? card(peers[(i - 1 + peers.length) % peers.length]) : null;
const next = peers.length > 1 ? card(peers[(i + 1) % peers.length]) : null;
---

<Plain
  title={`${entry.data.title} — Phil Vishnevsky`}
  description={entry.data.description}
  ogSlug={`projects/${slug}`}
  math={hasMath}
  schema={creativeWorkSchema({
    name: entry.data.title,
    description: entry.data.description,
    path: `/projects/${slug}/`,
    date: isoDate(entry.data.date),
    image: new URL(`/og/projects/${slug}.png`, Astro.site).href,
    tags: entry.data.tags,
    repo: source,
    live,
  })}
>
  <PageCover motif={motif} seed={slug} hue={hue} tall />

  <main class="article project" data-pagefind-body>
    <a class="a-back" href="/projects/" data-vt={coursework ? undefined : "back"}>← projects</a>
    <header class="p-head">
      <h1>{entry.data.title}</h1>
      {entry.data.tagline && <p class="tagline">{entry.data.tagline}</p>}
      {entry.data.description && <p class="about">{entry.data.description}</p>}
      <p class="a-meta facts">
        <span>{kind}</span>
        {season(entry.data.date) && <span>{season(entry.data.date)}</span>}
        {entry.data.tags.length > 0 && <span>{entry.data.tags.join(", ")}</span>}
      </p>
      {
        (live || source || downloads.length > 0) && (
          <p class="links">
            {live && <a class="ink" href={live} rel="noopener noreferrer">{host(live)} ↗</a>}
            {source && <a class="ink" href={source} rel="noopener noreferrer">{host(source)} ↗</a>}
            {downloads.map((d) => (
              <a class="ink" href={`/downloads/${d.filename}`} download>
                {d.label ?? d.filename} ↓
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      video ? (
        <figure class="lead">
          <video
            src={video}
            poster={lead ?? undefined}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={`${entry.data.title} demo`}
            data-loop
          />
        </figure>
      ) : lead && (
        <figure class="lead">
          <img src={lead} alt={`${entry.data.title}${entry.data.tagline ? `, ${entry.data.tagline}` : ""}`} />
        </figure>
      )
    }

    <div class="prose story"><Content /></div>

    {
      prev && next && (
        <nav class="pager" aria-label="More projects">
          {[
            { p: prev, dir: "← previous", cls: "prev" },
            { p: next, dir: "next →", cls: "next" },
          ].map(({ p, dir, cls }) => (
            <a class={cls} href={`/projects/${p.slug}/`} data-peek-link data-preview={p.thumb} data-hue={p.hue} data-name={p.title}>
              <small>{dir}</small>
              <span class="pt">{p.title}</span>
              {p.line && <span class="pl">{p.line}</span>}
            </a>
          ))}
        </nav>
      )
    }
  </main>
  <div class="peek" data-peek aria-hidden="true"><img alt="" /><span class="peek-name"></span></div>
</Plain>

<script>
  import "@/scripts/code";

  // The demo loop plays like a gif; with reduced motion it waits for the viewer to press play,
  // and off screen it pauses.
  document.querySelectorAll<HTMLVideoElement>("video[data-loop]").forEach((v) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      v.removeAttribute("autoplay");
      v.pause();
      v.controls = true;
      return;
    }
    new IntersectionObserver(([e]) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())).observe(v);
  });


  // A preview of the neighbouring project trails the cursor over the pager.
  const peek = document.querySelector<HTMLElement>("[data-peek]");
  const peekImg = peek?.querySelector("img");
  const peekName = peek?.querySelector<HTMLElement>(".peek-name");
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (peek && fine) {
    let x = 0, y = 0, px = 0, py = 0, raf = 0, on = false;
    const follow = () => {
      px += (x - px) * 0.25;
      py += (y - py) * 0.25;
      peek.style.transform = `translate(${px}px, ${py}px) translate(-50%, calc(-100% - 18px))`;
      raf = on || Math.abs(x - px) > 0.5 ? requestAnimationFrame(follow) : 0;
    };
    document.querySelectorAll<HTMLAnchorElement>("[data-peek-link]").forEach((a) => {
      a.addEventListener("pointerenter", (e) => {
        // Its screenshot when it has one, otherwise its name, set in its colour.
        const src = a.dataset.preview;
        peek.classList.toggle("bare", !src);
        if (src) peekImg!.src = src;
        peekName!.textContent = a.dataset.name ?? "";
        peek.style.setProperty("--peek-hue", `var(--c-hue-${a.dataset.hue ?? "blue"})`);
        x = px = e.clientX;
        y = py = e.clientY;
        on = true;
        peek.classList.add("on");
        if (!raf) raf = requestAnimationFrame(follow);
      });
      a.addEventListener("pointermove", (e) => {
        x = e.clientX;
        y = e.clientY;
      });
      a.addEventListener("pointerleave", () => {
        on = false;
        peek.classList.remove("on");
      });
    });
  }
</script>

<style>
  .project {
    max-width: 56rem;
    padding-top: 2.5rem;
  }
  .p-head h1 {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .tagline {
    margin-top: 0.25rem !important;
    font-size: 16px;
    color: var(--fg-muted);
  }
  .about {
    max-width: 42rem;
    margin-top: 2rem !important;
    font-size: 16px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .facts {
    margin-top: 1.5rem !important;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.75rem !important;
    font-family: var(--mono);
    font-size: 13px;
  }
  .links a {
    color: var(--fg) !important;
  }
  .lead {
    margin: 4rem 0 0 !important;
    overflow: hidden;
    border-radius: 6px;
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }
  .lead img,
  .lead video {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The story: prose at a reading measure, galleries and images at the frame's width. */
  .story {
    max-width: none;
    margin-top: 4rem;
  }
  .story > :global(:not(figure, .mwin, .codewrap, .codegroup, p:has(> img))) {
    max-width: 42rem;
  }
  .story :global(img) {
    border-radius: 6px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 6rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    max-width: 22rem;
    color: var(--fg) !important;
  }
  .pager .next {
    align-items: flex-end;
    text-align: right;
  }
  .pager small {
    margin-bottom: 0.35rem;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-muted);
  }
  .pt {
    font-size: 16px;
  }
  .pl {
    font-size: 14px;
    color: var(--fg-muted);
  }
  /* A small card in the neighbour's own colour, its screenshot whole inside:
     always the same size, whatever the shot's shape. */
  .peek {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 15rem;
    height: 10rem;
    padding: 0.85rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--peek-hue, var(--c-accent)) 22%, var(--ground));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent),
      0 14px 36px rgb(0 0 0 / 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .peek img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 5px;
  }
  .peek-name {
    display: none;
    font-family: var(--mono);
    font-size: 20px;
    color: var(--fg);
  }
  .peek.bare img {
    display: none;
  }
  .peek.bare .peek-name {
    display: block;
  }
  .peek.on {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .project {
      padding-top: 1.5rem;
    }
    .pager {
      flex-direction: column;
    }
    .pager .next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
