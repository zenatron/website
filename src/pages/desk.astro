---
import Shell from "@/layouts/Shell.astro";
import { DESK } from "@/data/desk";
import { FAVORITES } from "@/data/favorites";
import { MACHINES, NOW, PRINCIPLES } from "@/data/about";
import { FORTUNES } from "@/data/site";

/**
 * The desk is one table: the apps I use and the things worth opening,
 * scattered on it. Icons are shown exactly as they ship — full colour,
 * no tint — because an app icon is already a designed object.
 */

/** Deterministic jitter, so the scatter is organic but never moves. */
function seed(s: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return (h >>> 0) / 0xffffffff;
}
function jitter(name: string) {
  const a = seed(name), b = seed(name + "y"), c = seed(name + "r"), d = seed(name + "s");
  return {
    x: (a - 0.5) * 46,          // percent of a cell
    y: (b - 0.5) * 34,
    rot: (c - 0.5) * 13,        // degrees
    scale: 0.86 + d * 0.32,
  };
}

const apps = FAVORITES.filter((f) => f.logo);

type Item =
  | { kind: "app"; name: string; note?: string; href?: string; logo: string; appIcon: boolean; darkTile: boolean }
  | { kind: "file"; name: string; note?: string; file: string; href?: string; deskKind: string; badge: string; hue: string };

const items: Item[] = [
  ...DESK.map((o) => ({
    kind: "file" as const,
    name: o.file,
    note: o.note,
    file: o.file,
    href: o.href,
    deskKind: o.kind,
    badge: o.badge,
    hue: o.hue,
  })),
  ...apps.map((a) => ({
    kind: "app" as const,
    name: a.name,
    note: a.description,
    href: a.url,
    logo: a.logo!,
    appIcon: Boolean(a.appIcon),
    darkTile: Boolean(a.darkTile),
  })),
];

const windows = {
  neofetch: MACHINES.map((m) => ({ name: m.name, fields: m.fields })),
  now: NOW,
  principles: PRINCIPLES,
  fortunes: FORTUNES,
};
---

<Shell title="Desk | Phil Vishnevsky" description="The apps I use and the things worth opening, on one table." ogSlug="desk">
  <header class="pagehead">
    <h1>Desk</h1>
    <p>
      {apps.length} apps I actually use, and a few things worth opening.
      Hover for what they are.
    </p>
  </header>

  <div class="surface">
    <ul class="objects">
      {items.map((item) => {
        const j = jitter(item.name);
        const style = `--x:${j.x}%; --y:${j.y}%; --rot:${j.rot}deg; --scale:${j.scale}`;
        return (
          <li style={style}>
            {item.kind === "app" ? (
              <a href={item.href} rel="noopener noreferrer" class="obj">
                <span class:list={["icon", !item.appIcon && "tiled", item.darkTile && "ondark"]}>
                  <img src={`/logos/${item.logo}`} alt="" width="64" height="64" loading="lazy" decoding="async" />
                </span>
                <span class="label">
                  <span class="lname">{item.name}</span>
                  {item.note && <span class="lnote">{item.note}</span>}
                </span>
              </a>
            ) : item.deskKind === "link" ? (
              <a href={item.href} class="obj" style={`--fg: var(--c-hue-${item.hue}, var(--c-${item.hue})); --bg: var(--c-tint-${item.hue})`}>
                <span class="icon file"><span class="badge" aria-hidden="true">{item.badge}</span></span>
                <span class="label">
                  <span class="lname">{item.file}</span>
                  {item.note && <span class="lnote">{item.note}</span>}
                </span>
              </a>
            ) : (
              <button
                type="button"
                class="obj"
                data-open-file={item.deskKind}
                data-file-name={item.file}
                data-file-note={item.note}
                style={`--fg: var(--c-hue-${item.hue}, var(--c-${item.hue})); --bg: var(--c-tint-${item.hue})`}
              >
                <span class="icon file">
                  <span class="badge" aria-hidden="true">{item.badge}</span>
                </span>
                <span class="label">
                  <span class="lname">{item.file}</span>
                  {item.note && <span class="lnote">{item.note}</span>}
                </span>
              </button>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <dialog class="win" data-win>
    <div class="win-bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="win-name" data-win-name></span>
    </div>
    <div class="win-body" data-win-body></div>
    <div class="win-foot" data-win-foot></div>
  </dialog>

  <script type="application/json" data-desk-windows set:html={JSON.stringify(windows)} />
</Shell>

<style>
  .pagehead { margin-bottom: var(--s-5); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }

  /*
   * The desk surface: a dot grid, like graph paper under the objects.
   * Not called `.table` — that's a Tailwind display utility, and it wins.
   */
  .surface {
    position: relative;
    padding: var(--s-6) var(--s-5);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    background-color: var(--c-chrome);
    background-image: radial-gradient(var(--c-hairline) 1.4px, transparent 1.4px);
    background-size: 22px 22px;
    background-position: -11px -11px;
  }

  .objects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(112px, 1fr));
    gap: var(--s-5) var(--s-3);
  }
  /* The grid keeps it responsive; the jitter keeps it from looking like
     a grid. Positions are seeded by name, so nothing ever moves. */
  .objects li {
    display: grid;
    place-items: center;
    transform: translate(var(--x), var(--y)) rotate(var(--rot));
  }

  .obj {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }

  .icon {
    display: grid;
    place-items: center;
    width: calc(64px * var(--scale));
    height: calc(64px * var(--scale));
    transition: transform var(--dur-state) var(--ease), filter var(--dur-state) var(--ease);
  }
  .icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Glyph logos get a tile so they read as an app icon like the rest. */
  .tiled {
    background: var(--c-bg);
    border: 1px solid var(--c-hairline);
    border-radius: 22%;
    padding: 19%;
  }
  /* Artwork drawn in white needs a dark tile, or it vanishes. Declared
     after .tiled, and compounded, so the cascade can't undo it. */
  .tiled.ondark {
    background: var(--c-tile-dark);
    border-color: transparent;
  }

  .file {
    background: var(--bg);
    border-radius: 22%;
    color: var(--fg);
  }
  .badge {
    font-family: var(--font-mono);
    font-size: calc(20px * var(--scale));
    line-height: 1;
  }

  /* The label is absolutely placed so revealing it moves nothing. */
  .label {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) rotate(calc(var(--rot) * -1));
    width: max-content;
    max-width: 150px;
    display: grid;
    gap: 1px;
    justify-items: center;
    text-align: center;
    padding: 5px 9px;
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    border: 1px solid var(--c-hairline);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-state) var(--ease);
    z-index: 2;
  }
  .lname {
    font-size: var(--t-sans-xs);
    font-weight: 600;
    line-height: 1.25;
  }
  .lnote {
    font-size: var(--t-mono-xs);
    font-family: var(--font-mono);
    color: var(--c-muted);
    line-height: 1.3;
  }

  .obj:focus-visible .label { opacity: 1; }
  .obj:focus-visible .icon { transform: translateY(-6px) scale(1.08); }
  @media (hover: hover) {
    .obj:hover .label { opacity: 1; }
    .obj:hover .icon { transform: translateY(-6px) scale(1.08); }
    /* Everything else settles back while one object is picked up. */
    .objects:hover li:not(:hover) .icon { filter: saturate(0.82) opacity(0.86); }
  }

  /* Window */
  .win {
    padding: 0;
    width: min(560px, calc(100vw - var(--s-6)));
    max-height: min(70vh, 620px);
    background: var(--c-bg);
    color: var(--c-text);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .win::backdrop { background: var(--c-scrim); }
  .win:focus, .win:focus-visible { outline: none; }
  .win-bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: var(--h-titlebar);
    padding-inline: var(--s-3);
    background: var(--c-chrome);
    border-bottom: 1px solid var(--c-hairline);
  }
  .lights { display: flex; gap: var(--s-2); }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: var(--c-trafficlight); }
  .win-name {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-muted);
  }
  .win-body {
    padding: var(--s-4);
    overflow-y: auto;
    max-height: calc(70vh - var(--h-titlebar) - 44px);
  }
  .win-foot {
    padding: var(--s-2) var(--s-3);
    border-top: 1px solid var(--c-hairline);
    background: var(--c-chrome);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-muted);
  }
  .win-foot:empty { display: none; }

  .win-body :global(.spec) {
    display: grid;
    grid-template-columns: 9ch minmax(0, 1fr);
    gap: 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: 1.95;
  }
  .win-body :global(.spec dt) { color: var(--c-dim); }
  .win-body :global(.spec dd) { margin: 0; color: var(--c-text); }
  .win-body :global(.host) {
    font-family: var(--font-mono);
    font-size: var(--t-mono-md);
    color: var(--c-accent);
    margin-bottom: var(--s-2);
  }
  .win-body :global(.host + .spec) { margin-bottom: var(--s-5); }
  .win-body :global(.group-head) {
    font-size: var(--t-sans-sm);
    font-weight: 600;
    margin-bottom: var(--s-2);
  }
  .win-body :global(.group + .group) { margin-top: var(--s-5); }
  .win-body :global(.row) {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: 3px;
    font-size: var(--t-sans-sm);
  }
  .win-body :global(.row span:last-child) {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    flex: 0 0 auto;
  }
  .win-body :global(.line) { font-size: var(--t-sans-lg); line-height: 1.6; }
  .win-body :global(.quote) { font-size: var(--t-sans-md); line-height: 1.6; }

  @media (max-width: 640px) {
    .surface { padding: var(--s-5) var(--s-3); }
    .objects {
      grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
      gap: var(--s-5) var(--s-2);
    }
    /* Touch has no hover, so the labels sit under every object. */
    .label { opacity: 1; position: static; transform: none; border: 0; background: none; padding: 4px 0 0; max-width: 92px; }
    .lnote { display: none; }
  }
</style>

<script>
  import "@/scripts/desk";
</script>
