---
/**
 * Writing, as a plain list: everything that isn't coursework, newest
 * first, then the coursework folded away at the bottom.
 */
import Plain from "@/layouts/Plain.astro";
import { getAllBlogPosts } from "@/lib/blog";

const posts = await getAllBlogPosts();
const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric", timeZone: "UTC" });
const writing = posts.filter((p) => p.data.series !== "data-mining");
const coursework = posts
  .filter((p) => p.data.series === "data-mining")
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
---

<Plain title="Blog — Phil Vishnevsky" ogSlug="blog" description="Writing by Phil Vishnevsky on Tailscale, VPNs, self-hosting and building things.">
  <main class="page blog">
    <header class="page-head">
      <div>
        <h1 class="sr-only">Blog</h1>
        <p class="motto">notes from the homelab.<span class="cursor" aria-hidden="true"></span></p>
        <p class="lede">Tailscale, VPNs, self-hosting, and whatever I’m building.</p>
      </div>
      <a class="ink dim rss" href="/rss.xml">rss</a>
    </header>

    <ol class="list">
      {
        writing.map((p) => (
          <li>
            <a href={`/blog/${p.slug}/`}>
              <span class="title">{p.data.title}</span>
              <span class="rule" aria-hidden="true" />
              <time class="dim" datetime={p.data.date}>{fmt(p.data.date)}</time>
            </a>
          </li>
        ))
      }
    </ol>

    <details class="course">
      <summary class="dim">data mining coursework · {coursework.length} posts</summary>
      <ol class="list">
        {
          coursework.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`}>
                <span class="title">{p.data.title}</span>
                <span class="rule" aria-hidden="true" />
                <time class="dim" datetime={p.data.date}>{fmt(p.data.date)}</time>
              </a>
            </li>
          ))
        }
      </ol>
    </details>
  </main>
</Plain>

<style>
  .rss {
    font-size: 13px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    color: inherit;
    text-decoration: none;
  }
  .title {
    transition: opacity 150ms ease;
  }
  .list:hover .title {
    opacity: 0.45;
  }
  .list a:hover .title,
  .list a:focus-visible .title {
    opacity: 1;
  }
  .rule {
    flex: 1;
    min-width: 2rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--fg) 25%, transparent);
    transform: translateY(-0.3em);
  }
  time {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .course {
    margin-top: 4rem;
  }
  .course summary {
    cursor: pointer;
    font-size: 13px;
    margin-bottom: 1rem;
  }
  @media (max-width: 640px) {
    .list a {
      flex-direction: column;
      gap: 0.15rem;
    }
    .rule {
      display: none;
    }
  }
</style>
