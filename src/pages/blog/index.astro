---
import Shell from "@/layouts/Shell.astro";
import { getAllBlogPosts } from "@/lib/blog";
const posts = await getAllBlogPosts();
---
<Shell title="Blog | Phil Vishnevsky" ogSlug="blog">
  <h1>Blog</h1>
  <ul>{posts.map((p) => <li><a href={`/blog/${p.slug}`}>{p.data.title}</a></li>)}</ul>
</Shell>
