---
import Shell from "@/layouts/Shell.astro";
import Cells from "@/components/Cells.astro";
import { getAllBlogPosts } from "@/lib/blog";

const posts = await getAllBlogPosts();

const monthYear = (v: string | Date | undefined) => {
  if (!v) return undefined;
  const d = new Date(v);
  return Number.isNaN(d.getTime())
    ? undefined
    : d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

const cells = posts.map((p) => ({
  title: p.data.title,
  href: `/blog/${p.slug}`,
  slug: p.slug,
  description: p.data.excerpt || undefined,
  tags: p.data.tags ?? [],
  meta: monthYear(p.data.date),
}));
---
<Shell title="Blog | Phil Vishnevsky" description="Thoughts on code, tools, and building things." ogSlug="blog">
  <header class="pagehead">
    <h1>Writing</h1>
    <p>{posts.length} posts on homelabs, networking, tooling, and whatever I broke recently.</p>
  </header>
  <Cells cells={cells} />
</Shell>

<style>
  .pagehead { margin-bottom: var(--s-6); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }
</style>
