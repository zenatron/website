---
import Shell from "@/layouts/Shell.astro";
import Cells from "@/components/Cells.astro";
import Series from "@/components/Series.astro";
import { cardArt } from "@/lib/cardart";
import { getAllBlogPosts } from "@/lib/blog";

const posts = await getAllBlogPosts();

const monthYear = (v: string | Date | undefined) => {
  if (!v) return undefined;
  const d = new Date(v);
  return Number.isNaN(d.getTime())
    ? undefined
    : d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

/** Posts that belong to an ordered series get their own presentation. */
const SERIES = {
  "homelab-networking": {
    title: "Homelab & networking",
    blurb:
      "Five posts that build on each other, from what a VPN actually is up to a reverse proxy fronting the whole rack. Start at the top.",
  },
} as const;

const seriesKey = "homelab-networking";
const inSeries = posts
  .filter((p) => p.data.series === seriesKey)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    excerpt: p.data.excerpt,
    readingTime: p.data.readingTime,
    order: p.data.seriesOrder ?? 0,
  }));

const rest = posts.filter((p) => p.data.series !== seriesKey);

const cells = rest.map((p) => ({
  title: p.data.title,
  href: `/blog/${p.slug}`,
  slug: p.slug,
  description: p.data.excerpt || undefined,
  tags: p.data.tags ?? [],
  meta: monthYear(p.data.date),
  art: cardArt({ slug: p.slug, title: p.data.title, collection: "blog" }),
}));
---
<Shell title="Blog | Phil Vishnevsky" description="Thoughts on code, tools, and building things." ogSlug="blog">
  <header class="pagehead">
    <h1>Writing</h1>
    <p>{posts.length} posts on homelabs, networking, tooling, and whatever I broke recently.</p>
  </header>

  {inSeries.length > 0 && (
    <Series title={SERIES[seriesKey].title} blurb={SERIES[seriesKey].blurb} entries={inSeries} />
  )}

  <h2 class="rest-head">Everything else</h2>
  <Cells cells={cells} />
</Shell>

<style>
  .pagehead { margin-bottom: var(--s-6); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }
  .rest-head {
    font-size: var(--t-sans-lg);
    font-weight: 600;
    margin-bottom: var(--s-5);
  }
</style>
