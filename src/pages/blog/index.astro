---
import Shell from "@/layouts/Shell.astro";
import Cells from "@/components/Cells.astro";
import Series from "@/components/Series.astro";
import Archive from "@/components/Archive.astro";
import SectionHead from "@/components/SectionHead.astro";
import { cardArt } from "@/lib/cardart";
import { getAllBlogPosts } from "@/lib/blog";

const posts = await getAllBlogPosts();

const monthYear = (v: string | Date | undefined) => {
  if (!v) return undefined;
  const d = new Date(v);
  return Number.isNaN(d.getTime())
    ? undefined
    : d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

/**
 * Two series and a handful of standalone posts. The coursework is twelve
 * structurally identical entries; rendering those as cards buried the
 * five posts worth reading under thirteen that aren't.
 */
const SERIES = {
  "homelab-networking": {
    title: "Homelab & networking",
    blurb:
      "Five posts that build on each other, from what a VPN actually is up to a reverse proxy fronting the whole rack. Start at the top.",
  },
  "data-mining": {
    title: "Data mining coursework",
    blurb:
      "Weekly write-ups from an intro data mining course — the pipeline, classification, regression, clustering, and a midterm study guide.",
  },
} as const;

const inSeries = (key: string) =>
  posts
    .filter((p) => p.data.series === key)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
    .map((p) => ({
      slug: p.slug,
      title: p.data.title,
      excerpt: p.data.excerpt,
      readingTime: p.data.readingTime,
      date: p.data.date,
      order: p.data.seriesOrder ?? 0,
    }));

const homelab = inSeries("homelab-networking");
const coursework = inSeries("data-mining");

const standalone = posts.filter((p) => !p.data.series);
const cells = await Promise.all(
  standalone.map(async (p) => ({
    title: p.data.title,
    href: `/blog/${p.slug}/`,
    slug: p.slug,
    description: p.data.excerpt || undefined,
    meta: monthYear(p.data.date),
    art: await cardArt({ slug: p.slug, title: p.data.title, collection: "blog" }),
  }))
);
---

<Shell title="Writing | Phil Vishnevsky" description="Thoughts on code, tools, and building things." ogSlug="blog">
  <header class="pagehead">
    <h1>Writing</h1>
    <p>
      {posts.length} posts on homelabs, networking, tooling, and whatever I broke
      recently.
    </p>
  </header>

  {homelab.length > 0 && (
    <Series
      title={SERIES["homelab-networking"].title}
      blurb={SERIES["homelab-networking"].blurb}
      entries={homelab}
    />
  )}

  {cells.length > 0 && (
    <section class="loose">
      <SectionHead title="Posts" meta={`${cells.length}`} />
      <Cells cells={cells} />
    </section>
  )}

  {coursework.length > 0 && (
    <Archive
      title={SERIES["data-mining"].title}
      blurb={SERIES["data-mining"].blurb}
      entries={coursework}
    />
  )}
</Shell>

<style>
  .pagehead { margin-bottom: var(--s-6); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pagehead p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }
  .loose { margin-top: var(--s-7); }
</style>
