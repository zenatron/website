---
/**
 * A post, in the quiet layout: a way back, the title, the date, the
 * writing, and the next and previous posts. Series posts page through
 * their series; everything else pages by date.
 */
import { getCollection } from "astro:content";
import Plain from "@/layouts/Plain.astro";
import { SITE } from "@/data/site";
import { getAllBlogPosts, POST_SERIES, readingMinutes } from "@/lib/blog";
import { blogPostingSchema, isoDate } from "@/lib/schema";
import "@/styles/article.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const hasMath = /\$\$|\\\(|\\\[|\$[^$\n]+\$/.test(post.body ?? "");
const coursework = post.data.series === "data-mining";

const all = await getAllBlogPosts();
const seriesKey = post.data.series;
type Link = { slug: string; title: string } | null;
let prev: Link = null;
let next: Link = null;
let seriesTitle: string | undefined;
if (seriesKey) {
  const parts = all
    .filter((p) => p.data.series === seriesKey)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
  const i = parts.findIndex((p) => p.slug === post.slug);
  const at = (n: number) => (parts[n] ? { slug: parts[n].slug, title: parts[n].data.title } : null);
  prev = at(i - 1);
  next = at(i + 1);
  seriesTitle = POST_SERIES.find((s) => s.key === seriesKey)?.title;
} else {
  // Chronological; `all` is newest first.
  const standalone = all.filter((p) => !p.data.series || p.data.series === "homelab-networking");
  const i = standalone.findIndex((p) => p.slug === post.slug);
  const at = (n: number) => (standalone[n] ? { slug: standalone[n].slug, title: standalone[n].data.title } : null);
  prev = at(i + 1);
  next = at(i - 1);
}

const date = new Date(post.data.date).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const minutes = readingMinutes(post.data.readingTime);
---

<Plain
  title={`${post.data.title} — Phil Vishnevsky`}
  description={post.data.excerpt}
  ogSlug={`blog/${post.slug}`}
  math={hasMath}
  noindex={coursework}
  article
  publishedTime={isoDate(post.data.date)}
  modifiedTime={isoDate(post.data.updated) ?? isoDate(post.data.date)}
  articleTags={post.data.tags}
  schema={blogPostingSchema({
    title: post.data.title,
    description: post.data.excerpt,
    path: `/blog/${post.slug}/`,
    published: isoDate(post.data.date),
    modified: isoDate(post.data.updated) ?? isoDate(post.data.date),
    image: new URL(`/og/blog/${post.slug}.png`, Astro.site).href,
    tags: post.data.tags,
  })}
>
  <main class="article">
    <a class="a-back" href="/blog/">← blog</a>
    <header class="a-head" data-pagefind-body>
      <h1>{post.data.title}</h1>
      <p class="a-meta">
        <span><time datetime={post.data.date}>{date}</time></span>
        {minutes && <span>{minutes}</span>}
        {seriesTitle && <span>{seriesTitle.toLowerCase()}</span>}
        {post.data.tags?.length ? <span>{post.data.tags.join(", ")}</span> : null}
      </p>
    </header>

    <div class="prose" data-pagefind-body><Content /></div>

    {
      (prev || next) && (
        <nav class="a-foot a-pager" aria-label="More posts">
          {prev && (
            <a class="prev" href={`/blog/${prev.slug}/`}>
              <small>← {seriesKey ? "previous in series" : "older"}</small>
              {prev.title}
            </a>
          )}
          {next && (
            <a class="next" href={`/blog/${next.slug}/`}>
              <small>{seriesKey ? "next in series" : "newer"} →</small>
              {next.title}
            </a>
          )}
        </nav>
      )
    }
    {
      !coursework && (
        <p class="a-foot a-tip">
          Saved you an afternoon? <a class="ink" href={SITE.kofi} rel="noopener noreferrer">Buy me a tea ↗</a>
        </p>
      )
    }
  </main>
</Plain>

<script>
  import "@/scripts/code";
</script>
