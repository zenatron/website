---
/**
 * The homelab series is five posts that read in order and build on each
 * other. Showing them as five unrelated cards among twenty throws away
 * the one piece of narrative structure the blog has.
 */
import CardArt from "@/components/CardArt.astro";
import SectionHead from "@/components/SectionHead.astro";
import { cardArt } from "@/lib/cardart";

interface Entry { slug: string; title: string; excerpt?: string; order: number; readingTime?: string; }
interface Props { title: string; blurb: string; entries: Entry[]; }
const { title, blurb, entries } = Astro.props;
// Resolved up front: cardArt is async and the template can't await per row.
const withArt = await Promise.all(
  entries.map(async (e) => ({
    ...e,
    art: await cardArt({ slug: e.slug, title: e.title, collection: "blog" }),
  }))
);
---

<section class="series">
  <SectionHead title={title} meta={`series · ${entries.length}`} blurb={blurb} />

  <ol class="parts">
    {withArt.map((e, i) => (
      <li class:list={["part", i === 0 && "first"]}>
        <a href={`/blog/${e.slug}`}>
          <span class="n">{String(e.order).padStart(2, "0")}</span>
          <span class="art">
            <CardArt art={e.art} slug={e.slug} crop />
          </span>
          <span class="text">
            <span class="t">{e.title}</span>
            {e.excerpt && <span class="x">{e.excerpt}</span>}
            {e.readingTime && <span class="rt">{e.readingTime.replace(/(\d+)\s*min.*/i, "$1 min read")}</span>}
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .series { margin-bottom: var(--s-7); }

  .parts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .part a {
    position: relative;
    display: grid;
    grid-template-columns: 3.2ch 150px minmax(0, 1fr);
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3);
    border-radius: var(--radius-sm);
    color: inherit;
    transition: background var(--dur-state) var(--ease);
  }
  @media (hover: hover) {
    .part a:hover {
    background: var(--c-raised);
    }
  }

  /* The running number is what makes it read as one sequence. */
  .n {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-dim);
    text-align: right;
  }
  @media (hover: hover) {
    .part a:hover .n {
    color: var(--c-accent);
    }
  }

  .art {
    display: block;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--c-hairline);
  }

  .text { min-width: 0; }
  .t {
    display: block;
    font-size: var(--t-sans-md);
    font-weight: 600;
    line-height: 1.3;
  }
  @media (hover: hover) {
    .part a:hover .t {
    color: var(--c-link);
    }
  }
  .x {
    display: block;
    margin-top: 2px;
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
    line-height: 1.45;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .rt {
    display: block;
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
  }

  /* The first part gets a bigger preview — it's where you start. */
  .part.first a { grid-template-columns: 3.2ch 210px minmax(0, 1fr); }

  @media (max-width: 640px) {
    .series { padding: var(--s-4); }
    .part a,
    .part.first a {
      grid-template-columns: 3.2ch minmax(0, 1fr);
      gap: var(--s-3);
    }
    .art { display: none; }
  }
</style>
