---
/**
 * A page's title and the sentence under it. Every top-level page opens
 * with one; it used to be five pasted copies that had started to
 * disagree about the space beneath it and whether to shrink on a phone.
 */
interface Props { title: string }
const { title } = Astro.props;
---

<header class="pagehead">
  <h1>{title}</h1>
  {Astro.slots.has("default") && <p><slot /></p>}
</header>

<style>
  .pagehead { margin-bottom: var(--s-6); }
  h1 {
    font-size: var(--t-sans-2xl);
    font-weight: 700;
    letter-spacing: var(--track-display);
    line-height: var(--lh-display);
  }
  p {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--c-muted);
  }
  /* A link in the intro is a link in running text, so it's underlined, as in prose. */
  p :global(a) {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* A phone's column is 358px; 40px titles took two lines to say "Say hi". */
  @media (max-width: 640px) {
    h1 { font-size: var(--t-sans-xl); }
  }
</style>
