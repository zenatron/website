---
/**
 * A project's icon, drawn the way AppIcon draws a real app's: a squircle
 * with the same glass on it. Projects have no logos, so the face is the
 * first letter of the name, tinted by the project's kind — green for an
 * app, orange for a tool, as in the explorer. Coursework gets a chart
 * instead, because "Project 1", "Project 2" and "Project 3" would
 * otherwise all be a P.
 */
import { PROJECT_KIND } from "@/lib/projects";

interface Props { title: string; type?: string; icon?: string }
const { title, type = "other", icon } = Astro.props;

const kind = PROJECT_KIND[type];
const chart = type === "data";
const letter = Array.from(title.trim())[0] ?? "?";
const style = kind ? `--h: var(--c-hue-${kind.hue}); --t: var(--c-tint-${kind.hue})` : undefined;
---
<span class:list={["picon", "glass", { plain: !kind }]} style={style} aria-hidden="true">
  {icon ? (
    <img src={icon} alt="" width="96" height="96" />
  ) : chart ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20h16" /><path d="M7 16v-4" /><path d="M12 16V7" /><path d="M17 16v-7" />
    </svg>
  ) : (
    <span class="letter">{letter}</span>
  )}
</span>

<style>
  .picon {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 22.5%;
    color: var(--h);
    background: linear-gradient(160deg, var(--t), color-mix(in srgb, var(--t) 72%, var(--h)));
    container-type: inline-size;
  }
  .picon.plain {
    --h: var(--c-muted);
    background: linear-gradient(160deg, var(--c-chrome), var(--c-raised));
  }
  .letter {
    font-size: 52cqi;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    translate: 0 -0.03em;
  }
  .picon img { width: 100%; height: 100%; object-fit: cover; }
  .picon svg { width: 50%; height: 50%; }

  /* The glass is styles/glass.css, shared with AppIcon. */
</style>
