---
/**
 * VS Code's status bar as ambient, real information. Every value here is
 * true, with exactly one sanctioned joke.
 *
 * The bar is aria-hidden in its entirety: it carries nothing a screen
 * reader user needs, and announcing "Ln 1, Col 1" on every page load
 * would be hostile. The branch link is therefore tabindex="-1" too — the
 * repo is reachable from /say-hi, which is in the tab order.
 */
import { SITE } from "@/data/site";

const branch = __GIT_BRANCH__;
const buildTime = __BUILD_TIME__;
const buildLabel = new Date(buildTime).toLocaleString("en-US", {
  timeZone: SITE.timezone,
  dateStyle: "medium",
  timeStyle: "short",
});
---

<div class="statusbar" aria-hidden="true" transition:persist="statusbar">
  <a class="branch" href={SITE.repo} tabindex="-1" rel="noopener noreferrer" title="Built from this branch">{branch}</a>
  <span>Ln 1, Col 1</span>
  <span>UTF-8</span>

  <span class="spacer"></span>

  <span class="clock tabular" data-clock></span>
  <span class="deploy" title={`Built ${buildLabel}`}>
    <i aria-hidden="true"></i>deployed
  </span>
</div>

<style>
  .statusbar {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: var(--h-statusbar);
    flex: 0 0 var(--h-statusbar);
    padding-inline: var(--s-3);
    background: var(--c-chrome);
    border-top: 1px solid var(--c-hairline);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    user-select: none;
    white-space: nowrap;
  }

  .spacer { flex: 1 1 auto; }

  /* Amber means "you are here" — this is the branch the site was built from. */
  .branch {
    color: var(--c-accent);
    user-select: text;
  }

  /*
   * Width reserved so hydrating the clock cannot shift the layout.
   * "Hartford 12:00 AM" is the widest it gets with tabular figures.
   */
  .clock {
    min-width: 17ch;
    text-align: right;
  }

  .deploy {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-link);
  }
  .deploy i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-link);
  }

  /* Two items below 640px: branch and deploy status. */
  @media (max-width: 640px) {
    .statusbar > span:not(.spacer):not(.deploy),
    .statusbar > .clock {
      display: none;
    }
  }
</style>
