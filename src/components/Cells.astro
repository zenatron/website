---
/**
 * Shared-edge cells. Interior lines are 1px, not 2px, because neighbours
 * collapse their borders rather than each drawing their own.
 */
import Tags from "@/components/Tags.astro";

interface Cell {
  title: string;
  href: string;
  description?: string;
  tags?: string[];
}
interface Props { cells: Cell[]; }
const { cells } = Astro.props;
---

<ul class="cells">
  {cells.map((cell) => (
    <li>
      <a href={cell.href}>
        <span class="title">{cell.title}</span>
        {cell.description && <span class="desc">{cell.description}</span>}
      </a>
      {cell.tags && cell.tags.length > 0 && (
        <div class="tagrow"><Tags tags={cell.tags} max={3} /></div>
      )}
    </li>
  ))}
</ul>

<style>
  .cells {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0;
    border-top: 1px solid var(--c-hairline);
    border-left: 1px solid var(--c-hairline);
  }
  .cells li {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
    min-width: 0;
    border-right: 1px solid var(--c-hairline);
    border-bottom: 1px solid var(--c-hairline);
    transition: background var(--dur-state) var(--ease);
  }
  /* The entire hover state. No lift, no scale, no border change. */
  .cells li:hover { background: var(--c-raised); }

  .cells a {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
  }
  /* One link per cell; the tag row rides along rather than nesting inside. */
  .cells a::after { content: ""; position: absolute; inset: 0; }
  .cells li { position: relative; }

  .title {
    font-size: var(--t-sans-lg);
    font-weight: 500;
    line-height: 1.25;
  }
  .desc {
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
    line-height: 1.5;
  }
  .tagrow { margin-top: auto; }
</style>
