---
/**
 * Cards lead with artwork. Without it they read as a list of filenames.
 *
 * A card carries what you need to decide whether to open it: the picture,
 * the title, when it was made, and a sentence. Tags went under the
 * description once and did the opposite — three identical rows of chips
 * across a grid flattened the cards into one texture and buried the
 * sentence that actually distinguishes them. They live on the page
 * itself, where there's one set of them and room to read it.
 */
import CardArt from "@/components/CardArt.astro";
import type { CardArt as Art } from "@/lib/cardart";

interface Cell {
  title: string;
  href: string;
  description?: string;
  meta?: string;
  slug?: string;
  art?: Art;
}
interface Props {
  cells: Cell[];
  /**
   * `grid` fills columns as they fit, and a short list in an auto-filled
   * grid leaves a hole: three cards in two columns. `pairs` never does —
   * two columns, and when the count is odd the first card, the one you'd
   * open first, is set across the whole row with the rest paired under it.
   */
  layout?: "grid" | "pairs";
}
const { cells, layout = "grid" } = Astro.props;
const pairs = layout === "pairs";
const lead = pairs && cells.length % 2 === 1;
---

<div class="cellwrap">
<ul class:list={["cells", { pairs }]}>
  {cells.map((cell, i) => (
    <li class:list={["cell", lead && i === 0 && "first"]}>
      <a href={cell.href}>
        {cell.art && <span class="art"><CardArt art={cell.art} slug={cell.slug ?? cell.href} /></span>}
        <span class="body">
          <span class="head">
            <span class="title">{cell.title}</span>
            {cell.meta && <span class="meta">{cell.meta}</span>}
          </span>
          {cell.description && <span class="desc">{cell.description}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>
</div>

<style>
  .cellwrap { container-type: inline-size; }

  .cells {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--s-5);
  }

  .cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }

  .cell a {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    color: inherit;
    min-width: 0;
  }
  .cell a::after { content: ""; position: absolute; inset: 0; }

  .art {
    display: block;
    container-type: inline-size;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-hairline);
    transition: border-color var(--dur-state) var(--ease);
  }
  @media (hover: hover) {
    .cell:hover .art {
      border-color: var(--c-hairline-strong);
    }
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .title {
    font-size: var(--t-sans-lg);
    font-weight: 600;
    line-height: var(--lh-head);
    letter-spacing: var(--track-head);
    min-width: 0;
  }
  @media (hover: hover) {
    .cell:hover .title {
      color: var(--c-link);
    }
  }
  .title { transition: color var(--dur-state) var(--ease); }

  .meta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    white-space: nowrap;
  }
  .desc {
    display: block;
    margin-top: var(--s-2);
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
    line-height: var(--lh-ui);
  }

  /* Fixed layouts: two columns, one on a narrow pane. */
  .cells.pairs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .first { grid-column: 1 / -1; }

  /* The lead card: art and words side by side, the title a size up. */
  @container (min-width: 624px) {
    .first a {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--s-6);
    }
    .first .head {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--s-2);
    }
    .first .title {
      font-size: var(--t-sans-xl);
      letter-spacing: var(--track-display);
      line-height: var(--lh-head);
    }
    .first .desc {
      margin-top: var(--s-3);
      font-size: var(--t-sans-md);
    }
  }
  @container (max-width: 623px) {
    .cells.pairs { grid-template-columns: minmax(0, 1fr); }
  }
</style>
