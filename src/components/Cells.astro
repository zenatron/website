---
/**
 * Cards lead with artwork. Without it they read as a list of filenames.
 *
 * A card carries what you need to decide whether to open it: the picture,
 * the title, when it was made, and a sentence. Tags went under the
 * description once and did the opposite — three identical rows of chips
 * across a grid flattened the cards into one texture and buried the
 * sentence that actually distinguishes them. They live on the page
 * itself, where there's one set of them and room to read it.
 */
import CardArt from "@/components/CardArt.astro";
import type { CardArt as Art } from "@/lib/cardart";

interface Cell {
  title: string;
  href: string;
  description?: string;
  meta?: string;
  slug?: string;
  art?: Art;
}
interface Props { cells: Cell[]; }
const { cells } = Astro.props;
---

<ul class="cells">
  {cells.map((cell) => (
    <li class="cell">
      <a href={cell.href}>
        {cell.art && <span class="art"><CardArt art={cell.art} slug={cell.slug ?? cell.href} /></span>}
        <span class="body">
          <span class="head">
            <span class="title">{cell.title}</span>
            {cell.meta && <span class="meta">{cell.meta}</span>}
          </span>
          {cell.description && <span class="desc">{cell.description}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .cells {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--s-5);
  }

  .cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }

  .cell a {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    color: inherit;
    min-width: 0;
  }
  .cell a::after { content: ""; position: absolute; inset: 0; }

  .art {
    display: block;
    container-type: inline-size;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-hairline);
    transition: border-color var(--dur-state) var(--ease);
  }
  @media (hover: hover) {
    .cell:hover .art {
    border-color: var(--c-hairline-strong);
    }
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .title {
    font-size: var(--t-sans-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    min-width: 0;
  }
  @media (hover: hover) {
    .cell:hover .title {
    color: var(--c-link);
    }
  }
  .title { transition: color var(--dur-state) var(--ease); }

  .meta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    white-space: nowrap;
  }
  .desc {
    display: block;
    margin-top: var(--s-2);
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
    line-height: 1.5;
  }
</style>
