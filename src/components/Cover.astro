---
/**
 * Generative cover art. Colors are custom properties, so a cover follows
 * the theme rather than being baked to one palette.
 */
import { cover } from "@/lib/cover";

interface Props { slug: string; class?: string; cols?: number; rows?: number; }
const { slug, class: className, cols, rows } = Astro.props;
const c = cover(slug, { cols, rows });
const w = c.cols * 13 + 7;
const h = c.rows * 13 + 7;
---

<svg
  class:list={["cover", className]}
  viewBox={`0 0 ${w} ${h}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  style={`--hue: var(--c-hue-${c.hue}, var(--c-${c.hue})); --alt: var(--c-hue-${c.alt}, var(--c-${c.alt})); --tint: var(--c-tint-${c.hue});`}
>
  <rect width={w} height={h} fill="var(--tint)" />
  {c.dots.map((d) => (
    <circle
      cx={d.cx}
      cy={d.cy}
      r={d.r}
      fill={d.fill === "ghost" ? "var(--c-hairline)" : d.fill === "alt" ? "var(--alt)" : "var(--hue)"}
      opacity={d.fill === "ghost" ? 0.55 : 1}
    />
  ))}
</svg>

<style>
  .cover {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
