---
/** A shared-edge row: three tags form one continuous hairline, not three pills. */
interface Props { tags: string[]; max?: number; }
const { tags, max } = Astro.props;
const shown = max ? tags.slice(0, max) : tags;
---
{shown.length > 0 && (
  <ul class="tags">
    {shown.map((tag) => <li>{tag}</li>)}
  </ul>
)}

<style>
  /*
   * Shared edges that survive wrapping. The .hairline-row utility drops
   * the left border of every sibling, which leaves the first tag on each
   * wrapped line open-ended; overlapping by 1px instead keeps every box
   * closed and every interior line 1px.
   */
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    width: fit-content;
  }
  .tags li {
    border: 1px solid var(--c-hairline);
    margin-left: -1px;
    margin-top: -1px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-mint);
    padding: 3px 9px;
    line-height: 1.4;
  }
</style>
