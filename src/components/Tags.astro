---
/** Soft tinted pills. The tint is derived from the tag, so a given tag
    keeps its colour everywhere it appears on the site. */
interface Props { tags: string[]; max?: number; }
const { tags, max } = Astro.props;
const shown = max ? tags.slice(0, max) : tags;

const HUES = ["violet", "orange", "blue", "green", "accent", "link"];
function hueFor(tag: string): string {
  let h = 0x811c9dc5;
  for (let i = 0; i < tag.length; i++) { h ^= tag.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return HUES[(h >>> 0) % HUES.length];
}
---
{shown.length > 0 && (
  <ul class="tags">
    {shown.map((tag) => {
      const hue = hueFor(tag);
      return (
        <li style={`--fg: var(--c-hue-${hue}, var(--c-${hue})); --bg: var(--c-tint-${hue});`}>{tag}</li>
      );
    })}
  </ul>
)}

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: 1.5;
    color: var(--fg);
    background: var(--bg);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
</style>
