---
/**
 * A list of small facts: a post's topics, a project's stack.
 *
 * No color. Color on this site means category — a hue says "this is a
 * tool", "this is part of the homelab series" — and a tag is not a
 * category, so tinting one per tag spent the palette on decoration and
 * left six hues that meant nothing. These sit in the machine's voice,
 * quiet, and let the title lead.
 */
interface Props { tags: string[]; max?: number; }
const { tags, max } = Astro.props;
const shown = max ? tags.slice(0, max) : tags;
---
{shown.length > 0 && (
  <ul class="tags">
    {shown.map((tag) => <li>{tag}</li>)}
  </ul>
)}

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    margin: 0;
    padding: 0;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    line-height: 1.5;
    color: var(--c-muted);
    background: var(--c-sunken);
    border: 1px solid var(--c-hairline);
    padding: 2px 7px;
    border-radius: var(--radius-chip);
    white-space: nowrap;
  }
</style>
