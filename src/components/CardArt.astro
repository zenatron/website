---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import type { CardArt } from "@/lib/cardart";

interface Props {
  art: CardArt;
  slug: string;
  /** Crop into the artwork instead of shrinking all of it to fit. */
  crop?: boolean;
  /** The tint behind the art, when the caller knows what color the thing is. */
  hue?: "violet" | "orange" | "blue" | "green" | "ember" | "rose" | "teal" | "accent" | "link";
}
const { art, slug, crop = false, hue: fixedHue } = Astro.props;

/*
 * Art with no category of its own — a standalone post — still wants a
 * tint, but not one of the four hues: those say "app", "tool", "homelab
 * series", "coursework" in the explorer, and a hashed one claimed a
 * category the thing didn't have.
 */
const HUES = ["accent", "link"] as const;
function hueFor(s: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return HUES[(h >>> 0) % HUES.length];
}
const hue = fixedHue ?? hueFor(slug);

// Diagrams are inlined so they inherit the theme, same as in the post body.
let svg = "";
if (art.kind === "diagram") {
  svg = readFileSync(join(process.cwd(), "public", art.src.replace(/^\//, "")), "utf8")
    .replace(/<\?xml[\s\S]*?\?>/, "")
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<svg([^>]*)>/, (m, a) => {
      const cleaned = a
        .replace(/\s(width|height)="[^"]*"/g, "")
        .replace(/\srole="[^"]*"/g, "")
        .replace(/\spreserveAspectRatio="[^"]*"/g, "");
      // A whole diagram shrunk to thumbnail size is illegible noise, so
      // small cards crop into it instead.
      const par = crop ? ' preserveAspectRatio="xMidYMid slice"' : "";
      return `<svg${cleaned}${par} aria-hidden="true" focusable="false">`;
    });
}
---

<span
  class:list={["art", art.kind, crop && "crop"]}
  style={`--fg: var(--c-hue-${hue}, var(--c-${hue})); --bg: var(--c-tint-${hue});`}
  aria-hidden="true"
>
  {art.kind === "image" && <img src={art.src} alt="" loading="lazy" decoding="async" />}
  {art.kind === "diagram" && <span class="svgwrap" set:html={svg} />}
  {art.kind === "type" && (
    <span class="type-inner">
      <span class="lead">{art.lead}</span>
      {art.rest && <span class="rest">{art.rest}</span>}
    </span>
  )}
</span>

<style>
  /*
   * The ground is a small desktop: the card's tint with its hue blooming
   * in from two corners, the way the real wallpaper blooms behind the
   * window. A flat tint read as an empty slab wherever the art didn't
   * fill the card.
   */
  .art {
    display: block;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(90% 80% at 0% 0%, color-mix(in srgb, var(--fg) 20%, transparent), transparent 65%),
      radial-gradient(80% 70% at 100% 100%, color-mix(in srgb, var(--fg) 13%, transparent), transparent 65%),
      var(--bg);
    overflow: hidden;
  }

  /*
   * A screenshot or a chart sits on that desktop the way a window does:
   * inset, and lifted by the window shadow. drop-shadow rather than
   * box-shadow, so it follows the picture's own edges inside the
   * contain box — a phone screenshot casts a phone-shaped shadow.
   * Hero banners still crop, flat.
   */
  .art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--s-4);
    filter:
      drop-shadow(0 1px 2px rgba(0, 0, 0, 0.12))
      drop-shadow(0 10px 18px rgba(0, 0, 0, 0.18));
  }
  .art.crop img {
    object-fit: cover;
    padding: 0;
    filter: none;
  }

  /* Diagrams sit back a little so the card reads as a preview, not a crop. */
  .svgwrap {
    display: block;
    width: 100%;
    height: 100%;
    padding: var(--s-3);
  }
  .art.crop .svgwrap { padding: 0; }
  .svgwrap :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .type-inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding: var(--s-4);
    overflow: hidden;
  }
  .lead {
    font-size: clamp(38px, 13cqw, 76px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.92;
    color: var(--fg);
  }
  .rest {
    margin-top: var(--s-2);
    font-size: var(--t-sans-xs);
    color: var(--fg);
  }
</style>
