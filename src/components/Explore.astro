---
/**
 * Where else to go, at the foot of every page on a phone. There, with no
 * Dock and the sidebar put away in a drawer, nothing on screen says the
 * rest of the site exists; this does, so reading to the end of any page
 * leads on to the next place rather than stopping.
 *
 * It's the Dock, as a phone draws one: the same apps (data/apps.ts), the
 * same glass icons, the résumé and GitHub after them, laid out as a home
 * screen on the Dock's own glass shelf, with names under the icons and a
 * dot under the one you're in.
 *
 * Wider screens have the Dock itself.
 */
import { COPYRIGHT, SITE } from "@/data/site";
import { APPS } from "@/data/apps";
import PageIcon from "@/components/PageIcon.astro";
import AppIcon from "@/components/AppIcon.astro";
import FileIcon from "@/components/FileIcon.astro";

const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const here = norm(Astro.url.pathname);
// The app you're in: the page itself, or the index a post or project sits under.
const current = (href: string) => {
  const h = norm(href);
  return h === here || (h !== "/" && here.startsWith(`${h}/`));
};
---

<nav class="explore" aria-label="Keep exploring">
  <p class="glabel">Keep exploring</p>
  <ul class="springboard">
    {APPS.map((a) => (
      <li>
        <a class="glint-host" href={a.href} aria-current={current(a.href) ? "page" : undefined}>
          <span class="icon"><PageIcon glyph={a.glyph} hue={a.hue} /></span>
          <span class="name">{a.name}</span>
        </a>
      </li>
    ))}
    <li>
      <a class="glint-host" href={SITE.resume}>
        <span class="icon"><FileIcon form="doc" glyph="resume" ext="pdf" ink="red" /></span>
        <span class="name">Résumé</span>
      </a>
    </li>
    <li>
      <a class="glint-host" href={SITE.github} rel="me noopener noreferrer">
        <span class="icon"><AppIcon item={{ logo: "github.svg" }} /></span>
        <span class="name">GitHub</span>
      </a>
    </li>
  </ul>
  {/* Phones have no menu bar, so the colophon it keeps lands here. */}
  <p class="colophon">{COPYRIGHT} · v{__APP_VERSION__}</p>
</nav>

<style>
  .explore { display: none; }
  @media (max-width: 640px) {
    .explore {
      display: block;
      margin-top: var(--s-7);
    }
  }

  /* The Dock's shelf — same glass, edge and shadow — holding a home
     screen's grid. Three across: nine icons make a full square, where
     four across left GitHub alone on a row of its own. */
  .springboard {
    list-style: none;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5) var(--s-2);
    padding: var(--s-5) var(--s-3);
    background: var(--c-chrome-glass);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    backdrop-filter: blur(24px) saturate(1.8);
    border: 1px solid var(--c-hairline-strong);
    border-radius: 22px;
    box-shadow: var(--shadow-popover);
  }

  a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--c-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .icon {
    display: block;
    width: 62px;
    height: 62px;
    transition: transform var(--dur-state) var(--ease);
  }
  .icon :global(.fileicon) { width: 100%; height: 100%; }
  /* A press sinks the icon, the way a home screen answers a tap. */
  a:active .icon { transform: scale(0.9); }
  a:focus-visible { outline: none; }
  a:focus-visible .icon { outline: 1px solid var(--c-accent); outline-offset: 3px; border-radius: 22.5%; }

  .name {
    max-width: 100%;
    font-size: var(--t-sans-xs);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The app you're in, marked as the Dock marks it: a dot underneath. */
  a[aria-current="page"]::after {
    content: "";
    position: absolute;
    bottom: -9px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--c-text);
  }

  .colophon {
    margin-top: var(--s-5);
    font-size: var(--t-sans-xs);
    color: var(--c-dim);
    text-align: center;
  }
</style>
