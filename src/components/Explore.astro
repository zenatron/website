---
/**
 * Where else to go, at the foot of every page — on a screen narrow enough
 * that the explorer is a drawer. There, nothing on screen says the rest of
 * the site exists unless you open the menu; this does, so reading to the
 * end of any page leads on to the next place rather than stopping.
 *
 * Wide screens don't get it: the explorer is always there, listing the
 * same places.
 */
import { COPYRIGHT, PAGES } from "@/data/site";
import { FAVORITES } from "@/data/favorites";
import { getAllProjects } from "@/lib/projects";
import { getAllBlogPosts } from "@/lib/blog";
import { PHOTOS } from "@/data/photos";
import PageIcon, { type PageGlyph, type PageHue } from "@/components/PageIcon.astro";


const [projects, posts] = await Promise.all([getAllProjects(), getAllBlogPosts()]);
const apps = FAVORITES.filter((f) => f.logo).length;
const page = (href: string) => PAGES.find((p) => p.href === href);

const places: { href: string; name: string; blurb: string; glyph: PageGlyph; hue?: PageHue }[] = [
  { href: "/", name: "home", blurb: "Back to the start", glyph: "home" },
  { href: "/about/", name: "about", blurb: "The story, the desk, and the lid", glyph: "person", hue: page("/about/")?.hue },
  { href: "/dock/", name: "dock", blurb: `${apps} apps I use, and a few files`, glyph: "dock", hue: page("/dock/")?.hue },
  { href: "/projects/", name: "projects", blurb: `${projects.length} things I’ve built`, glyph: "folder", hue: "blue" },
  { href: "/blog/", name: "writing", blurb: `${posts.length} posts on homelabs and more`, glyph: "pen" },
  { href: "/photos/", name: "photos", blurb: `${PHOTOS.length} shot on iPhone, edited on iPhone & Mac`, glyph: "camera", hue: page("/photos/")?.hue },
  { href: "/say-hi/", name: "say hi", blurb: page("/say-hi/")?.blurb ?? "", glyph: "bubble", hue: page("/say-hi/")?.hue },
];

const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const shown = places.filter((p) => (p.href.replace(/\/+$/, "") || "/") !== here);
---

<nav class="explore" aria-label="Keep exploring">
  <p class="glabel">Keep exploring</p>
  <ul class="glist">
    {shown.map((p) => (
      <li>
        <a class="glint-host" href={p.href}>
          <span class="tile" aria-hidden="true"><PageIcon glyph={p.glyph} hue={p.hue} /></span>
          <span class="name">{p.name[0].toUpperCase() + p.name.slice(1)}</span>
          <span class="blurb">{p.blurb}</span>
          <svg class="go glist-go" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
        </a>
      </li>
    ))}
  </ul>
  {/* Phones have no menu bar, so the colophon it keeps lands here. */}
  <p class="colophon">{COPYRIGHT} · v{__APP_VERSION__}</p>
</nav>

<style>
  .explore { display: none; }

  @media (max-width: 900px) {
    .explore {
      display: block;
      margin-top: var(--s-7);
    }
  }

  /* Set as the sidebar sets its favorites: a tinted tile, the name, and
     here a line on what's there. */
  .glist { --glist-inset: calc(var(--s-4) + 32px + var(--s-3)); }
  a {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 14px;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: var(--s-3);
    row-gap: 1px;
    min-height: 60px;
    text-decoration: none;
  }
  .tile {
    grid-row: 1 / span 2;
    width: 32px;
    height: 32px;
  }
  .name { font-size: var(--t-sans-md); color: var(--c-text); }
  .blurb {
    grid-column: 2;
    min-width: 0;
    font-size: var(--t-sans-xs);
    color: var(--c-muted);
  }
  .go {
    grid-column: 3;
    grid-row: 1 / span 2;
  }
  a:active { background: var(--c-raised); }

  .colophon {
    display: none;
    margin-top: var(--s-5);
    font-size: var(--t-sans-xs);
    color: var(--c-dim);
    text-align: center;
  }
  @media (max-width: 640px) {
    .colophon { display: block; }
  }
</style>
