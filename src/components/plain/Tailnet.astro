---
/** The full-screen mesh behind the home page; see scripts/tailnet.ts. */
import { PEERS } from "@/data/tailnet";
---

<div class="mesh" data-mesh data-peers={JSON.stringify(PEERS)}>
  <canvas aria-hidden="true"></canvas>
  <div class="mesh-stats" aria-hidden="true" data-mesh-avoid>
    <div><span data-mesh-peers>0</span> peers</div>
    <div><span data-mesh-services>0</span> services</div>
    <div><span data-mesh-packets>0</span> packets</div>
  </div>
  <div class="mesh-log" aria-live="off" aria-hidden="true" data-mesh-log data-mesh-avoid></div>
</div>

<script>
  import { mountTailnet } from "@/scripts/tailnet";
  const root = document.querySelector<HTMLElement>("[data-mesh]");
  if (root) mountTailnet(root, JSON.parse(root.dataset.peers ?? "[]"));
</script>

<style>
  .mesh {
    position: absolute;
    inset: 0;
    cursor: crosshair;
    touch-action: manipulation;
  }
  canvas {
    display: block;
  }
  .mesh-stats {
    position: absolute;
    top: 5rem;
    right: max(1.5rem, 12vw);
    font-size: 11px;
    line-height: 1.7;
    min-width: 10ch;
    font-variant-numeric: tabular-nums;
    opacity: 0.35;
    pointer-events: none;
  }
  .mesh-log {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    min-width: 38ch;
    /* Four lines tall from the start, so the mesh keeps clear of it. */
    min-height: calc(11px * 1.7 * 4);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    font-size: 11px;
    line-height: 1.7;
    white-space: nowrap;
    text-align: right;
    opacity: 0.4;
    pointer-events: none;
  }
  .mesh-log :global(div:last-child) {
    opacity: 1;
  }
  .mesh-log :global(div:not(:last-child)) {
    opacity: 0.55;
  }
  @media (max-width: 900px) {
    .mesh-log {
      display: none;
    }
  }
  /* On a phone the counts give their corner back to the mesh. */
  @media (max-width: 640px) {
    .mesh-stats {
      display: none;
    }
  }
</style>
