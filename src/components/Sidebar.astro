---
/**
 * The explorer.
 *
 * Two levels, never three: sections, then files. A series is a labelled
 * run inside its section rather than another folder to open — the extra
 * depth cost a click and a chunk of width and bought nothing.
 *
 * Rhythm comes from three things the old flat list had none of: tracked
 * section labels, a right-hand metadata column the way a file browser
 * shows size and date, and a hue dot per file from the same hash the tags
 * and covers use.
 */
import { getAllBlogPosts } from "@/lib/blog";
import { getAllProjects, projectSlug } from "@/lib/projects";

const posts = await getAllBlogPosts();
const projects = await getAllProjects();

const HUES = ["violet", "orange", "blue", "green", "accent", "link"] as const;
function hue(s: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return HUES[(h >>> 0) % HUES.length];
}
const minutes = (v?: string) => (v ? `${v.match(/\d+/)?.[0] ?? ""}m` : "");
const year = (v?: string | Date) => {
  if (!v) return "";
  const d = new Date(v);
  return Number.isNaN(d.getTime()) ? "" : `'${String(d.getFullYear()).slice(2)}`;
};

interface Row { name: string; href: string; title: string; meta: string; run?: string }

const projectRows: Row[] = projects.map((p) => ({
  name: `${projectSlug(p)}.mdx`,
  href: `/projects/${projectSlug(p)}`,
  title: p.data.title,
  meta: year(p.data.date),
}));

const bySeries = (key: string, run: string): Row[] =>
  posts
    .filter((p) => p.data.series === key)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
    .map((p) => ({
      name: `${p.slug}.mdx`,
      href: `/blog/${p.slug}`,
      title: p.data.title,
      meta: minutes(p.data.readingTime),
      run,
    }));

const blogRows: Row[] = [
  ...posts
    .filter((p) => !p.data.series)
    .map((p) => ({
      name: `${p.slug}.mdx`,
      href: `/blog/${p.slug}`,
      title: p.data.title,
      meta: minutes(p.data.readingTime),
    })),
  ...bySeries("homelab-networking", "homelab & networking"),
  ...bySeries("data-mining", "data mining coursework"),
];

const sections = [
  { key: "projects", label: "projects", href: "/projects", rows: projectRows },
  { key: "blog", label: "writing", href: "/blog", rows: blogRows },
];

const pages = [
  { name: "home", href: "/" },
  { name: "about", href: "/about" },
  { name: "desk", href: "/desk" },
  { name: "elsewhere", href: "/links" },
];
---

<nav id="sidebar" class="sidebar" aria-label="Site" transition:persist="sidebar">
  <div class="head">
    <p class="explorer">explorer</p>
    <button class="close" type="button" data-drawer-close>
      <span class="sr-only">Close menu</span><span aria-hidden="true">&times;</span>
    </button>
  </div>

  <div class="searchbar">
    <label class="sr-only" for="tree-search">Search files</label>
    <input id="tree-search" type="search" placeholder="search" autocomplete="off" spellcheck="false" data-search />
  </div>

  <div class="tree" data-tree>
    <ul class="pages">
      {pages.map((f) => (
        <li class="row page"><a href={f.href} data-nav>{f.name}</a></li>
      ))}
    </ul>

    {sections.map((section) => {
      let lastRun: string | undefined;
      return (
        <section class="sect">
          <div class="sectlabel">
            <a href={section.href} data-nav>{section.label}</a>
            <span class="count" aria-hidden="true">{section.rows.length}</span>
          </div>
          <ul data-group={section.key}>
            {section.rows.map((r, i) => {
              const startsRun = r.run && r.run !== lastRun;
              lastRun = r.run;
              return (
                <>
                  {startsRun && <li class="runlabel" aria-hidden="true">{r.run}</li>}
                  <li class="row file" data-title={r.title} data-run={r.run}>
                    <span class="dot" aria-hidden="true" style={`--d: var(--c-hue-${hue(r.name)}, var(--c-${hue(r.name)}))`} />
                    <a href={r.href} data-nav>{r.name}</a>
                    <span class="rowmeta" aria-hidden="true">{r.meta}</span>
                  </li>
                </>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>

  <p class="empty" data-empty hidden>No match.</p>
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    flex: 0 0 var(--w-sidebar);
    width: var(--w-sidebar);
    background: var(--c-chrome);
    border-right: 1px solid var(--c-hairline);
    padding-block: var(--s-3) var(--s-6);
    overflow-y: auto;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--s-4) var(--s-3);
    margin-bottom: var(--s-2);
  }
  .explorer {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    letter-spacing: 0.08em;
  }
  .close {
    display: none;
    width: 30px; height: 30px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--c-muted);
    font-size: var(--t-sans-lg);
    line-height: 1;
    cursor: pointer;
  }

  .searchbar { padding-inline: var(--s-3); margin-bottom: var(--s-4); }
  .searchbar input {
    width: 100%;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-text);
    background: var(--c-bg);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
  }
  .searchbar input::-webkit-search-cancel-button { -webkit-appearance: none; }

  ul { list-style: none; margin: 0; padding: 0; }

  /* Section label: the loudest small thing in the rail. */
  .sect { margin-top: var(--s-5); }
  .sectlabel {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
    padding-inline: var(--s-4) var(--s-3);
    margin-bottom: var(--s-2);
  }
  .sectlabel a {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text);
    font-weight: 500;
  }
  .sectlabel .count {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
  }

  /* A series is a labelled run, not another folder. */
  .runlabel {
    padding: var(--s-3) var(--s-4) var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
  }
  .runlabel::before {
    content: "";
    display: block;
    width: 18px;
    border-top: 1px solid var(--c-hairline-strong);
    margin-bottom: var(--s-2);
  }

  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-inline: var(--s-1);
    padding-inline: var(--s-2);
    border-radius: var(--radius-sm);
    line-height: 2;
    transition: background var(--dur-state) var(--ease);
  }
  .row[hidden] { display: none; }

  .row a {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--dur-state) var(--ease);
  }

  /* Pages read as the top level: sans, a size up, no dot. */
  .page a {
    font-family: var(--font-sans);
    font-size: var(--t-sans-sm);
    color: var(--c-text);
  }

  .dot {
    flex: 0 0 auto;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--d);
    opacity: 0.9;
  }

  /* The metadata column is what breaks the monotony — a file browser
     shows size and date, so this shows reading time and year. */
  .rowmeta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) {
    .row:hover { background: var(--c-raised); }
    .row:hover a { color: var(--c-text); }
    .sectlabel a:hover { color: var(--c-link); }
  }

  .row[data-active] { background: var(--c-tint-accent); }
  .row[data-active] a { color: var(--c-accent); font-weight: 500; }
  .row[data-active] .dot { opacity: 1; }
  .row[data-active] .rowmeta { color: var(--c-accent); }

  .empty {
    padding-inline: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-dim);
  }

  @media (max-width: 900px) {
    .sidebar {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 3;
      flex-basis: min(86vw, 320px);
      width: min(86vw, 320px);
      transform: translateX(-100%);
      transition: transform var(--dur-state) var(--ease);
    }
    .sidebar[data-open="true"] { transform: translateX(0); }
    .close { display: grid; }
    .searchbar input { font-size: 16px; padding: 10px 12px; }
    .row { line-height: 1.4; min-height: 46px; }
    .row a { display: flex; align-items: center; min-height: 46px; }
  }
</style>
