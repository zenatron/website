---
/**
 * The sidebar, as Finder draws one.
 *
 * Favorites, then Projects and Writing, each item by its title with its
 * icon — a project's own app icon, a post's document. A series is a
 * folder that discloses its files in order; coursework starts folded,
 * because it's a syllabus and most of the list.
 *
 * Color is category, never decoration, and it's drawn the way Finder
 * draws a tag: a dot at the row's end. The hues say what the homepage
 * says — servers are blue, web apps are green — so a tag tells you what
 * an item is. Items that belong to nothing have no tag.
 *
 * The rail is pinned: who this is at the top, where else to find him at
 * the bottom, and the files scroll between them, so on a long post the
 * navigation is still where you left it.
 */
import { getAllBlogPosts, POST_SERIES, readingMinutes } from "@/lib/blog";
import { getAllProjects, projectSlug, PROJECT_KIND } from "@/lib/projects";
import { links } from "@/lib/links";
import { PAGES, SITE, STATUS } from "@/data/site";
import ProjectIcon from "@/components/ProjectIcon.astro";
import PageIcon from "@/components/PageIcon.astro";

const posts = await getAllBlogPosts();
const projects = await getAllProjects();

type Hue = "violet" | "orange" | "blue" | "green";
const vars = (hue: Hue) => `--h: var(--c-hue-${hue}); --t: var(--c-tint-${hue})`;

const SERIES = POST_SERIES;
const COURSEWORK = SERIES[1];

const time = (v?: string) => (v ? new Date(v).getTime() || 0 : 0);


interface Row {
  stem: string;
  href: string;
  title: string;
  meta: string;
  hue?: Hue;
  /** A project's app icon; posts get a document. */
  project?: { title: string; type?: string; icon?: string };
}
interface Group { run?: { label: string; title: string; hue: Hue }; rows: Row[] }

type ProjectEntry = (typeof projects)[number];
type PostEntry = (typeof posts)[number];

const projectRow = (p: ProjectEntry): Row => {
  const type = PROJECT_KIND[p.data.type];
  return {
    stem: projectSlug(p),
    href: `/projects/${projectSlug(p)}/`,
    title: p.data.title,
    meta: type && type.hue !== COURSEWORK.hue ? type.label : "",
    hue: type?.hue,
    project: { title: p.data.title, type: p.data.type, icon: p.data.icon },
  };
};
const postRow = (p: PostEntry, hue?: Hue): Row => ({
  stem: p.slug,
  href: `/blog/${p.slug}/`,
  title: p.data.title,
  meta: readingMinutes(p.data.readingTime),
  hue,
});

// Coursework is a syllabus, so it reads oldest first, like the series do.
const shipped = projects.filter((p) => p.data.type !== "data");
const coursework = projects
  .filter((p) => p.data.type === "data")
  .sort((a, b) => time(a.data.date) - time(b.data.date));

const sections: { key: string; label: string; href: string; groups: Group[] }[] = [
  {
    key: "projects",
    label: "Projects",
    href: "/projects/",
    groups: [
      { rows: shipped.map(projectRow) },
      { run: COURSEWORK, rows: coursework.map(projectRow) },
    ],
  },
  {
    key: "blog",
    label: "Writing",
    href: "/blog/",
    groups: [
      { rows: posts.filter((p) => !p.data.series).map((p) => postRow(p)) },
      ...SERIES.map((s) => ({
        run: s,
        rows: posts
          .filter((p) => p.data.series === s.key)
          .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
          .map((p) => postRow(p, s.hue)),
      })),
    ],
  },
];

const pages = PAGES;

const find = (title: string) => links.find((l) => l.title === title)?.url;
const socials = [
  { label: "GitHub", href: find("GitHub"), logo: "github.svg" },
  { label: "LinkedIn", href: find("LinkedIn"), glyph: "linkedin" },
  { label: "Bluesky", href: find("Bluesky"), logo: "bluesky.svg" },
  { label: "Email", href: `mailto:${SITE.email}`, glyph: "mail" },
].filter((s) => s.href);
---

<nav id="sidebar" class="sidebar" aria-label="Site" transition:persist="sidebar">
  <div class="rail">
    <div class="id">
      <a class="me glint-host" href="/" data-nav>
        <span class="mark glass" data-glint-only><img src="/favicon.svg" alt="" width="32" height="32" /></span>
        <span class="who">
          <span class="name">{SITE.name}</span>
          <span class="status"><i aria-hidden="true"></i>{STATUS}</span>
        </span>
      </a>
      <button class="close" type="button" data-drawer-close>
        <span class="sr-only">Close menu</span><span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="searchbar">
      <label class="sr-only" for="tree-search">Search files</label>
      <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="7" cy="7" r="4.5" /><path d="m10.4 10.4 3.1 3.1" />
      </svg>
      <input id="tree-search" type="search" placeholder="Search" autocomplete="off" spellcheck="false" data-search />
    </div>

    <div class="tree" data-tree>
      <p class="sbhead">Favorites</p>
      <ul class="pages">
        {pages.map((p) => (
          <li class="row page glint-host" style={vars(p.hue)}>
            <span class="tile" aria-hidden="true"><PageIcon glyph={p.glyph} hue={p.hue} /></span>
            {/* Named in lowercase everywhere they're typed; a sidebar
                capitalizes, as Finder's "Applications" does. */}
            <a href={p.href} data-nav>{p.name[0].toUpperCase() + p.name.slice(1)}</a>
          </li>
        ))}
      </ul>

      {sections.map((section) => (
        <section class="sect">
          <div class="sectlabel">
            <a href={section.href} data-nav>{section.label}</a>
            <span class="count" aria-hidden="true">
              {section.groups.reduce((n, g) => n + g.rows.length, 0)}
            </span>
          </div>
          <ul data-group={section.key}>
            {section.groups.map((group) => {
              // A series is a folder. Coursework starts folded: it's a
              // syllabus, and it's most of the list.
              const fold = group.run && `${section.key}:${group.run.label}`;
              const folded = group.run === COURSEWORK;
              return (
              <>
                {group.run && group.rows.length > 0 && (
                  <li class="runlabel" data-run={group.run.label} data-fold-key={fold} data-folded={folded || undefined} style={vars(group.run.hue)}>
                    <button type="button" class="fold" aria-expanded={folded ? "false" : "true"} data-fold-toggle>
                      <svg class="chev" aria-hidden="true" viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
                      <svg class="folder" aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M1.8 4.6A1.3 1.3 0 0 1 3.1 3.3h3.1l1.4 1.5h5.3a1.3 1.3 0 0 1 1.3 1.3v5.8a1.3 1.3 0 0 1-1.3 1.3H3.1a1.3 1.3 0 0 1-1.3-1.3z" /></svg>
                      <span class="runname">{group.run.title}</span>
                      <span class="runcount" aria-hidden="true">{group.rows.length}</span>
                    </button>
                  </li>
                )}
                {group.rows.map((r) => (
                  <li
                    class:list={["row", "file", "glint-host", { plain: !r.hue, inrun: group.run }]}
                    style={r.hue ? vars(r.hue) : undefined}
                    data-title={r.title}
                    data-run={group.run?.label}
                    data-fold={fold}
                    data-folded={folded || undefined}
                  >
                    <span class="ficon" aria-hidden="true">
                      {r.project ? (
                        <ProjectIcon {...r.project} />
                      ) : (
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M4 1.8h5.2L12.5 5v8.2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2.8a1 1 0 0 1 1-1z" /><path d="M9 1.9V5.2h3.4" /><path d="M5.3 8h5.4M5.3 10.4h5.4M5.3 12.6h3.4" stroke-linecap="round" /></svg>
                      )}
                    </span>
                    <a href={r.href} data-nav title={r.meta ? `${r.title} — ${r.meta}` : r.title}>{r.title}</a>
                    <span class="dot" aria-hidden="true"></span>
                  </li>
                ))}
              </>
              );
            })}
          </ul>
        </section>
      ))}

      {/* Hits inside the files, filled by scripts/sidebar.ts from the
          Pagefind index a build writes. Under `astro dev` there's no
          index, and this just never appears. */}
      <section class="sect hits" data-hits hidden>
        <div class="sectlabel">
          <span class="label">in files</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="count" aria-hidden="true" data-hits-count></span>
        </div>
        <ul data-hits-list aria-live="polite"></ul>
      </section>

      <p class="empty" data-empty hidden>No match.</p>
    </div>

    <div class="foot">
      <a class="resume" href={SITE.resume}>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M4 1.8h5.2L12.5 5v8.2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2.8a1 1 0 0 1 1-1z" /><path d="M9 1.9V5.2h3.4" /></svg>
        Résumé
      </a>
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.href} rel={s.href!.startsWith("http") ? "me noopener noreferrer" : undefined} aria-label={s.label} title={s.label}>
              {s.logo && <span class="logo" aria-hidden="true" style={`--src: url(/logos/${s.logo})`}></span>}
              {s.glyph === "linkedin" && (
                <svg aria-hidden="true" viewBox="0 0 128 128" width="15" height="15" fill="currentColor" fill-rule="evenodd">
                  <path d="M116 3H12a8.91 8.91 0 0 0-9 8.8v104.42a8.91 8.91 0 0 0 9 8.78h104a8.93 8.93 0 0 0 9-8.81V11.77A8.93 8.93 0 0 0 116 3ZM21.06 48.73h18.11V107H21.06zm9.06-29a10.5 10.5 0 1 1-10.5 10.49a10.5 10.5 0 0 1 10.5-10.49m20.41 29h17.36v8h.24c2.42-4.58 8.32-9.41 17.13-9.41C103.6 47.28 107 59.35 107 75v32H88.89V78.65c0-6.75-.12-15.44-9.41-15.44s-10.87 7.36-10.87 15V107H50.53z" />
                </svg>
              )}
              {s.glyph === "mail" && (
                <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
                  <rect x="2" y="3.5" width="12" height="9" rx="1.8" /><path d="m2.6 4.4 5.4 4.2 5.4-4.2" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style>
  /*
   * The column is as tall as the window's body and never taller:
   * `contain: size` stops the rail inside it from propping it open. The
   * window doesn't scroll, so the rail simply fills it.
   */
  .sidebar {
    flex: 0 0 var(--w-sidebar);
    width: var(--w-sidebar);
    background: var(--c-chrome-glass);
    border-right: 1px solid var(--c-hairline);
    contain: size;
  }
  .rail {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Who this is. The homepage's voice, carried onto every page. */
  .id {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-3) var(--s-3) var(--s-4);
  }
  .me {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: inherit;
  }
  /* The site's mark: it brings its own gloss and rim, so the glass adds
     only the glint. */
  .mark {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
  }
  .mark img { width: 100%; height: 100%; }
  .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: var(--lh-snug);
  }
  .name {
    font-size: var(--t-sans-sm);
    font-weight: 600;
    letter-spacing: var(--track-snug);
    color: var(--c-text);
    transition: color var(--dur-state) var(--ease);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--c-accent);
    white-space: nowrap;
  }
  .status i {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  @media (hover: hover) {
    .me:hover .name { color: var(--c-link); }
  }

  .close {
    display: none;
    flex: 0 0 auto;
    width: 36px; height: 36px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--c-muted);
    font-size: var(--t-sans-lg);
    line-height: 1;
    cursor: pointer;
  }

  .searchbar {
    position: relative;
    padding-inline: var(--s-3);
    margin-bottom: var(--s-2);
  }
  .searchbar svg {
    position: absolute;
    left: calc(var(--s-3) + 10px);
    top: 50%;
    translate: 0 -50%;
    color: var(--c-dim);
    pointer-events: none;
  }
  .searchbar input {
    width: 100%;
    font-size: var(--t-sans-xs);
    color: var(--c-text);
    background: color-mix(in srgb, var(--c-text) 6%, transparent);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-sm);
    padding: 6px 10px 6px 30px;
    transition: border-color var(--dur-state) var(--ease);
  }
  .searchbar input:focus { border-color: var(--c-hairline-strong); }
  .searchbar input::-webkit-search-cancel-button { -webkit-appearance: none; }

  /* Files soften out under the search box and over the footer instead of
     being guillotined. The fades sit in the padding, so at rest nothing is
     faded; only a scrolled list passes through them. */
  .tree {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding-block: var(--s-2) var(--s-5);
    scrollbar-width: thin;
    scrollbar-color: var(--c-hairline-strong) transparent;
    -webkit-mask-image: linear-gradient(transparent, black var(--s-3), black calc(100% - var(--s-4)), transparent);
    mask-image: linear-gradient(transparent, black var(--s-3), black calc(100% - var(--s-4)), transparent);
  }

  ul { list-style: none; margin: 0; padding: 0; }

  /*
   * Rows, as a Finder sidebar sets them: an icon, the name in the system
   * face at 13px, and the item's tag as a dot at the far end. The name is
   * the title now, not a filename; the old meta — reading time, or what
   * kind of project — is in the tooltip.
   */
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-inline: var(--s-2);
    padding-inline: 6px var(--s-2);
    min-height: 28px;
    border-radius: var(--radius-sm);
    transition: background var(--dur-state) var(--ease);
  }
  .row[hidden],
  .row[data-folded] { display: none; }
  /* A search looks inside folded folders too. */
  .tree[data-searching] .row[data-folded]:not([hidden]) { display: flex; }

  /* The whole row is the target, not just the letters in it. */
  .row a::after { content: ""; position: absolute; inset: 0; }

  .row a {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--t-sans-xs);
    line-height: var(--lh-snug);
    color: var(--c-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Favorites: the top-level pages, each on its app icon. */
  .page { gap: var(--s-2); }
  .tile {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
  }

  /* A file's icon: the project's own app icon, or a document. */
  .ficon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    color: var(--c-muted);
  }

  /* Headers: Finder's — small, bold, quiet, sentence case. */
  .sbhead,
  .sectlabel a,
  .sectlabel .label {
    font-size: 11px;
    font-weight: 600;
    line-height: var(--lh-snug);
    color: var(--c-dim);
  }
  .sbhead { padding: var(--s-1) var(--s-4) var(--s-1); }
  .sect { margin-top: var(--s-4); }
  .sectlabel {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-4);
  }
  .sectlabel .count {
    font-size: 11px;
    color: var(--c-dim);
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  /*
   * The tag. Color is still category — blue servers, green apps, the
   * series' own hue — drawn the way Finder draws a tag. Files that
   * belong to nothing have none.
   */
  .dot {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--h);
  }
  .plain .dot { display: none; }

  /* A series: a folder that discloses its files. */
  .runlabel { margin-inline: var(--s-2); }
  .fold {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-height: 28px;
    padding-inline: 0 var(--s-2);
    border-radius: var(--radius-sm);
    font-size: var(--t-sans-xs);
    color: var(--c-text);
    text-align: left;
    cursor: pointer;
    transition: background var(--dur-state) var(--ease);
  }
  .chev {
    flex: 0 0 auto;
    width: 10px;
    margin-inline-start: -4px;
    color: var(--c-dim);
    transition: transform var(--dur-state) var(--ease);
  }
  .fold[aria-expanded="true"] .chev { transform: rotate(90deg); }
  .folder { flex: 0 0 auto; color: var(--h); }
  .runname {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .runcount {
    font-size: 11px;
    color: var(--c-dim);
    font-variant-numeric: tabular-nums;
  }
  .runlabel[hidden] { display: none; }
  /* Inside a folder, files sit one step in, under the folder's name. */
  .inrun { padding-inline-start: 26px; }

  @media (hover: hover) {
    .row:hover,
    .fold:hover { background: var(--c-raised); }
    .sectlabel a:hover { color: var(--c-link); }
  }

  /* The selection: Finder's tinted row, the name in the accent. */
  .row[data-active] { background: var(--c-tint-accent); }
  /* Color, not weight: a bolder title is a wider one, and it moved
     where a long title's ellipsis fell. Finder doesn't bold either. */
  .row[data-active] a { color: var(--c-accent); }

  /*
   * A hit in a file's text: the file, set like its row above, then the
   * heading it's under and the words around it. Built by script, so the
   * rules reach it through :global.
   */
  .hits ul { list-style: none; margin: 0; padding: 0; }
  .hits :global(.hit a) {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    column-gap: var(--s-2);
    align-items: center;
    margin-inline: var(--s-1);
    padding: var(--s-1) var(--s-2);
    border-radius: var(--radius-sm);
    color: var(--c-text);
    transition: background var(--dur-state) var(--ease);
  }
  .hits :global(.hit .dot) {
    grid-row: 1;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--h, var(--c-dim));
  }
  .hits :global(.hit .dot[data-plain]) { background: transparent; border: 1px solid var(--c-hairline-strong); }
  .hits :global(.hit .file) {
    min-width: 0;
    font-size: var(--t-sans-xs);
    font-weight: 600;
    line-height: var(--lh-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hits :global(.hit .where) { color: var(--c-dim); }
  .hits :global(.hit .excerpt) {
    grid-column: 2;
    font-size: var(--t-sans-xs);
    line-height: var(--lh-snug);
    color: var(--c-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hits :global(.hit mark) {
    color: var(--c-accent);
    background: var(--c-tint-accent);
    border-radius: 2px;
  }
  @media (hover: hover) {
    .hits :global(.hit a:hover) { background: var(--c-raised); }
  }

  .empty {
    padding: var(--s-3) var(--s-4);
    font-size: var(--t-sans-xs);
    color: var(--c-dim);
  }

  /* Where else to find him, pinned under the files. */
  .foot {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-3);
    border-top: 1px solid var(--c-hairline);
  }
  .resume {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--t-sans-xs);
    color: var(--c-text);
    padding: 4px var(--s-2);
    margin-inline-start: calc(var(--s-2) * -1 + var(--s-1));
    border-radius: var(--radius-sm);
    transition: background var(--dur-state) var(--ease);
  }
  .socials { display: flex; }
  .socials a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    color: var(--c-muted);
    transition: background var(--dur-state) var(--ease), color var(--dur-state) var(--ease);
  }
  .logo {
    width: 15px;
    height: 15px;
    background: currentColor;
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
  }
  @media (hover: hover) {
    .resume:hover,
    .socials a:hover { background: var(--c-raised); color: var(--c-text); }
  }

  /*
