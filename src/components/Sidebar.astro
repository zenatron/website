---
/**
 * The nav is an actual file listing — rows are real content-collection
 * slugs — which is what earns the file-tree presentation. That only
 * holds up if the names are readable, so the rail is wide enough to fit
 * the longest one and the drawer is wide enough on a phone.
 *
 * Persisted across navigation, so active state, expansion and the filter
 * are re-synced by scripts/sidebar.ts rather than re-rendered here.
 */
import { getAllBlogPosts } from "@/lib/blog";
import { getAllProjects, projectSlug } from "@/lib/projects";

const CAP = 8;

const posts = await getAllBlogPosts();
const projects = await getAllProjects();

const tree = [
  {
    name: "projects",
    href: "/projects",
    children: projects.map((p) => ({
      name: `${projectSlug(p)}.mdx`,
      href: `/projects/${projectSlug(p)}`,
    })),
  },
  {
    name: "blog",
    href: "/blog",
    children: posts.map((p) => ({
      name: `${p.slug}.mdx`,
      href: `/blog/${p.slug}`,
    })),
  },
];

const files = [
  { name: "about", href: "/about" },
  { name: "stack", href: "/stack" },
  { name: "desk", href: "/desk" },
  { name: "elsewhere", href: "/links" },
];
---

<nav id="sidebar" class="sidebar" aria-label="Site" transition:persist="sidebar">
  <div class="head">
    <p class="explorer" id="explorer-label">explorer</p>
    <button class="close" type="button" data-drawer-close>
      <span class="sr-only">Close menu</span>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <div class="filterbar">
    <label class="sr-only" for="tree-filter">Filter files</label>
    <input
      id="tree-filter"
      type="search"
      placeholder="filter"
      autocomplete="off"
      spellcheck="false"
      data-filter
    />
  </div>

  <ul class="tree" data-tree>
    <li class="row"><a href="/" data-nav>home</a></li>

    {
      tree.map((folder) => {
        // Every child is rendered; the ones past the cap are hidden until
        // the folder is expanded in full or the filter is searching. A
        // filter that can only see 8 of 20 posts isn't a filter.
        const overflow = Math.max(0, folder.children.length - CAP);
        return (
          <li>
            <div class="row" data-row>
              <button
                class="twisty"
                type="button"
                aria-expanded="false"
                aria-controls={`group-${folder.name}`}
                data-twisty={folder.name}
              >
                <span class="sr-only">Toggle {folder.name}</span>
                <span class="tri" aria-hidden="true" />
              </button>
              <a href={folder.href} data-nav>{folder.name}</a>
              <span class="count" aria-hidden="true">{folder.children.length}</span>
            </div>

            <ul class="group" id={`group-${folder.name}`} data-group={folder.name}>
              <li class="row index-row">
                <a href={folder.href} data-nav>All {folder.name}</a>
              </li>
              {folder.children.map((child, i) => (
                <li class="row" data-overflow={i >= CAP ? "" : undefined}>
                  <a href={child.href} data-nav>{child.name}</a>
                </li>
              ))}
              {overflow > 0 && (
                <li class="row more">
                  <button type="button" data-more={folder.name} aria-expanded="false">
                    <span data-more-label>{overflow} more…</span>
                  </button>
                </li>
              )}
            </ul>
          </li>
        );
      })
    }

    {files.map((f) => (
      <li class="row"><a href={f.href} data-nav>{f.name}</a></li>
    ))}
  </ul>

  <p class="empty" data-empty hidden>No match.</p>
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    flex: 0 0 var(--w-sidebar);
    width: var(--w-sidebar);
    background: var(--c-chrome);
    border-right: 1px solid var(--c-hairline);
    padding-block: var(--s-3) var(--s-4);
    overflow-y: auto;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--s-4) var(--s-3);
    margin-bottom: var(--s-2);
  }
  /* The only letter-spaced text on the site. */
  .explorer {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    letter-spacing: 0.08em;
  }
  .close {
    display: none;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--c-muted);
    font-size: var(--t-sans-lg);
    line-height: 1;
    cursor: pointer;
  }
  @media (hover: hover) {
    .close:hover {
    background: var(--c-raised); color: var(--c-text);
    }
  }

  .filterbar { padding-inline: var(--s-3); margin-bottom: var(--s-2); }
  .filterbar input {
    width: 100%;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-text);
    background: var(--c-bg);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-sm);
    padding: 5px 9px;
  }
  .filterbar input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .tree,
  .group {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Groups collapse only once JS has run; without it the whole site is
     still reachable from the sidebar. */
  :global(.js) .group:not([data-open="true"]) { display: none; }
  .twisty { display: none; }
  :global(.js) .twisty { display: grid; }

  .row {
    position: relative;
    display: flex;
    align-items: center;
    margin-inline: var(--s-2);
    padding-left: var(--s-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: 2.1;
    transition: background var(--dur-state) var(--ease);
  }
  .row[hidden] { display: none; }

  .row a {
    flex: 1 1 auto;
    min-width: 0;
    padding-left: var(--s-4);
    padding-right: var(--s-2);
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--dur-state) var(--ease);
  }
  .group .row a { padding-left: calc(var(--s-4) + var(--s-3)); }

  .count {
    flex: 0 0 auto;
    padding-right: var(--s-3);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
  }

  @media (hover: hover) {
    .row:hover {
    background: var(--c-raised);
    }
  }
  @media (hover: hover) {
    .row:hover a {
    color: var(--c-text);
    }
  }

  .row[data-active] { background: var(--c-tint-accent); }
  .row[data-active] a { color: var(--c-accent); }

  .twisty {
    position: absolute;
    z-index: 1;
    left: var(--s-2);
    top: 0;
    bottom: 0;
    width: var(--s-4);
    place-items: center;
    padding: 0;
    cursor: pointer;
  }
  .tri {
    width: 0;
    height: 0;
    border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent;
    border-left: 5px solid var(--c-dim);
    transition: transform var(--dur-state) var(--ease);
  }
  .twisty[aria-expanded="true"] .tri { transform: rotate(90deg); }
  @media (hover: hover) {
    .row:hover .tri {
    border-left-color: var(--c-text);
    }
  }

  /* Overflow rows exist in the document but are folded away until asked
     for, or until the filter needs to reach them. */
  :global(.js) .group:not([data-all="true"]) .row[data-overflow] { display: none; }
  :global(.js) .group[data-searching="true"] .row[data-overflow] { display: flex; }

  .more button {
    flex: 1 1 auto;
    text-align: left;
    padding-left: calc(var(--s-4) + var(--s-3));
    padding-right: var(--s-2);
    color: var(--c-dim);
    cursor: pointer;
    transition: color var(--dur-state) var(--ease);
  }
  @media (hover: hover) {
    .row:hover .more button,
    .more button:hover { color: var(--c-text); }
  }

  .empty {
    padding-inline: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-dim);
  }

  /* The index row is a touch affordance; a pointer has the folder row. */
  .index-row { display: none; }

  @media (max-width: 900px) {
    .sidebar {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 3;
      /* Wide enough for the longest real filename on a phone. */
      flex-basis: min(86vw, 320px);
      width: min(86vw, 320px);
      transform: translateX(-100%);
      transition: transform var(--dur-state) var(--ease);
    }
    .sidebar[data-open="true"] { transform: translateX(0); }
    .close { display: grid; }

    /* 16px or iOS zooms the page when the field takes focus. */
    .filterbar input {
      font-size: 16px;
      padding: 10px 12px;
    }

    /* Every row is a real touch target. */
    .row { line-height: 1.4; min-height: 46px; }
    .row a,
    .more button {
      display: flex;
      align-items: center;
      min-height: 46px;
    }

    /*
     * A 16x29 disclosure triangle is not a tap target. On touch the whole
     * folder row toggles, and the folder's index moves into the group as
     * an explicit "All blog" row — two targets stacked in one row is a
     * mouse idiom that a thumb can't resolve.
     */
    .twisty {
      inset: 0;
      width: 100%;
      z-index: 2;
      place-items: center start;
      padding-left: var(--s-2);
    }
    [data-row] a { pointer-events: none; }
    .tri {
      border-top-width: 4.5px;
      border-bottom-width: 4.5px;
      border-left-width: 6.5px;
    }

    .index-row { display: flex; }
    .index-row a { color: var(--c-link); }
  }
</style>
