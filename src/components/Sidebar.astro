---
/**
 * The nav is an actual file listing — rows are real content-collection
 * slugs — and it mirrors how the content is actually organised, so the
 * blog's two series are folders rather than twenty loose files.
 *
 * Persisted across navigation; active state, expansion and search are
 * re-synced by scripts/sidebar.ts rather than re-rendered here.
 */
import { getAllBlogPosts } from "@/lib/blog";
import { getAllProjects, projectSlug } from "@/lib/projects";

const CAP = 8;

const posts = await getAllBlogPosts();
const projects = await getAllProjects();

const HUES = ["violet", "orange", "blue", "green", "accent", "link"] as const;
function hue(s: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return HUES[(h >>> 0) % HUES.length];
}

interface Leaf { name: string; href: string; title: string }
interface Folder { name: string; href?: string; children: Leaf[] }

const bySeries = (key: string): Leaf[] =>
  posts
    .filter((p) => p.data.series === key)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
    .map((p) => ({ name: `${p.slug}.mdx`, href: `/blog/${p.slug}`, title: p.data.title }));

const projectLeaves: Leaf[] = projects.map((p) => ({
  name: `${projectSlug(p)}.mdx`,
  href: `/projects/${projectSlug(p)}`,
  title: p.data.title,
}));

const blogSubfolders: Folder[] = [
  { name: "homelab", children: bySeries("homelab-networking") },
  { name: "coursework", children: bySeries("data-mining") },
];
const blogLoose: Leaf[] = posts
  .filter((p) => !p.data.series)
  .map((p) => ({ name: `${p.slug}.mdx`, href: `/blog/${p.slug}`, title: p.data.title }));

const files = [
  { name: "about", href: "/about" },
  { name: "desk", href: "/desk" },
  { name: "elsewhere", href: "/links" },
];
---

<nav id="sidebar" class="sidebar" aria-label="Site" transition:persist="sidebar">
  <div class="head">
    <p class="explorer" id="explorer-label">explorer</p>
    <button class="close" type="button" data-drawer-close>
      <span class="sr-only">Close menu</span>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <div class="searchbar">
    <label class="sr-only" for="tree-search">Search files</label>
    <input id="tree-search" type="search" placeholder="search" autocomplete="off" spellcheck="false" data-search />
  </div>

  <ul class="tree" data-tree>
    <li class="row"><a href="/" data-nav>home</a></li>

    <!-- projects -->
    <li>
      <div class="row folder" data-row>
        <button class="twisty" type="button" aria-expanded="false" aria-controls="group-projects" data-twisty="projects">
          <span class="sr-only">Toggle projects</span><span class="tri" aria-hidden="true" />
        </button>
        <a href="/projects" data-nav>projects</a>
        <span class="count" aria-hidden="true">{projectLeaves.length}</span>
      </div>
      <ul class="children" id="group-projects" data-group="projects">
        <li class="row index-row"><a href="/projects" data-nav>All projects</a></li>
        {projectLeaves.map((c, i) => (
          <li class="row leaf" data-title={c.title} data-overflow={i >= CAP ? "" : undefined}>
            <span class="dot" aria-hidden="true" style={`--d: var(--c-hue-${hue(c.name)}, var(--c-${hue(c.name)}))`} />
            <a href={c.href} data-nav>{c.name}</a>
          </li>
        ))}
        {projectLeaves.length > CAP && (
          <li class="row more">
            <button type="button" data-more="projects" aria-expanded="false">
              <span data-more-label>{projectLeaves.length - CAP} more…</span>
            </button>
          </li>
        )}
      </ul>
    </li>

    <!-- blog, with its series as folders -->
    <li>
      <div class="row folder" data-row>
        <button class="twisty" type="button" aria-expanded="false" aria-controls="group-blog" data-twisty="blog">
          <span class="sr-only">Toggle blog</span><span class="tri" aria-hidden="true" />
        </button>
        <a href="/blog" data-nav>blog</a>
        <span class="count" aria-hidden="true">{posts.length}</span>
      </div>

      <ul class="children" id="group-blog" data-group="blog">
        <li class="row index-row"><a href="/blog" data-nav>All posts</a></li>
        {blogSubfolders.map((sub) => (
          <li>
            <div class="row folder sub" data-row>
              <button
                class="twisty"
                type="button"
                aria-expanded="false"
                aria-controls={`group-${sub.name}`}
                data-twisty={sub.name}
              >
                <span class="sr-only">Toggle {sub.name}</span><span class="tri" aria-hidden="true" />
              </button>
              <span class="foldername">{sub.name}/</span>
              <span class="count" aria-hidden="true">{sub.children.length}</span>
            </div>
            <ul class="children deep" id={`group-${sub.name}`} data-group={sub.name}>
              {sub.children.map((c, i) => (
                <li class="row leaf" data-title={c.title} data-overflow={i >= CAP ? "" : undefined}>
                  <span class="dot" aria-hidden="true" style={`--d: var(--c-hue-${hue(c.name)}, var(--c-${hue(c.name)}))`} />
                  <a href={c.href} data-nav>{c.name}</a>
                </li>
              ))}
              {sub.children.length > CAP && (
                <li class="row more">
                  <button type="button" data-more={sub.name} aria-expanded="false">
                    <span data-more-label>{sub.children.length - CAP} more…</span>
                  </button>
                </li>
              )}
            </ul>
          </li>
        ))}

        {blogLoose.map((c) => (
          <li class="row leaf" data-title={c.title}>
            <span class="dot" aria-hidden="true" style={`--d: var(--c-hue-${hue(c.name)}, var(--c-${hue(c.name)}))`} />
            <a href={c.href} data-nav>{c.name}</a>
          </li>
        ))}
      </ul>
    </li>

    {files.map((f) => (
      <li class="row"><a href={f.href} data-nav>{f.name}</a></li>
    ))}
  </ul>

  <p class="empty" data-empty hidden>No match.</p>
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    flex: 0 0 var(--w-sidebar);
    width: var(--w-sidebar);
    background: var(--c-chrome);
    border-right: 1px solid var(--c-hairline);
    padding-block: var(--s-3) var(--s-4);
    overflow-y: auto;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--s-4) var(--s-3);
    margin-bottom: var(--s-2);
  }
  .explorer {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
    letter-spacing: 0.08em;
  }
  .close {
    display: none;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--c-muted);
    font-size: var(--t-sans-lg);
    line-height: 1;
    cursor: pointer;
  }
  @media (hover: hover) {
    .close:hover { background: var(--c-raised); color: var(--c-text); }
  }

  .searchbar { padding-inline: var(--s-3); margin-bottom: var(--s-3); }
  .searchbar input {
    width: 100%;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-text);
    background: var(--c-bg);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
  }
  .searchbar input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .tree,
  .children {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.js) .children:not([data-open="true"]) { display: none; }
  .twisty { display: none; }
  :global(.js) .twisty { display: grid; }
  :global(.js) .children:not([data-all="true"]) .row[data-overflow] { display: none; }
  :global(.js) .children[data-searching="true"] .row[data-overflow] { display: flex; }

  .row {
    position: relative;
    display: flex;
    align-items: center;
    margin-inline: var(--s-2);
    padding-left: var(--s-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    line-height: 2.1;
    transition: background var(--dur-state) var(--ease);
  }
  .row[hidden] { display: none; }

  /* Folders carry weight; files don't. That's the rhythm the flat list
     was missing. */
  .folder a,
  .foldername {
    font-weight: 500;
    color: var(--c-text);
  }
  .folder + .children { margin-bottom: var(--s-1); }

  .row a,
  .foldername {
    flex: 1 1 auto;
    min-width: 0;
    padding-left: var(--s-4);
    padding-right: var(--s-2);
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--dur-state) var(--ease);
  }
  .children > .row a,
  .children > li > .row .foldername { padding-left: calc(var(--s-4) + var(--s-3)); }
  .children.deep > .row a { padding-left: calc(var(--s-4) + var(--s-5) + var(--s-2)); }

  /* A hue dot per file, from the same hash the tags and covers use. */
  .dot {
    position: absolute;
    left: calc(var(--s-4) + var(--s-2));
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--d);
    opacity: 0.85;
  }
  .children.deep .dot { left: calc(var(--s-4) + var(--s-3)); }
  .leaf a { padding-left: calc(var(--s-4) + var(--s-5)); }
  .children.deep > .leaf a { padding-left: calc(var(--s-4) + var(--s-5)); }

  .count {
    flex: 0 0 auto;
    padding-right: var(--s-3);
    font-size: var(--t-mono-xs);
    color: var(--c-dim);
  }

  @media (hover: hover) {
    .row:hover { background: var(--c-raised); }
    .row:hover a { color: var(--c-text); }
    .row:hover .tri { border-left-color: var(--c-text); }
    .more button:hover { color: var(--c-text); }
  }

  .row[data-active] { background: var(--c-tint-accent); }
  .row[data-active] a { color: var(--c-accent); font-weight: 500; }
  .row[data-active] .dot { opacity: 1; }

  .twisty {
    position: absolute;
    z-index: 1;
    left: var(--s-2);
    top: 0;
    bottom: 0;
    width: var(--s-4);
    place-items: center;
    padding: 0;
    cursor: pointer;
  }
  .sub .twisty { left: calc(var(--s-2) + var(--s-3)); }
  .tri {
    width: 0;
    height: 0;
    border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent;
    border-left: 5px solid var(--c-dim);
    transition: transform var(--dur-state) var(--ease);
  }
  .twisty[aria-expanded="true"] .tri { transform: rotate(90deg); }

  .more button {
    flex: 1 1 auto;
    text-align: left;
    padding-left: calc(var(--s-4) + var(--s-5));
    padding-right: var(--s-2);
    color: var(--c-dim);
    cursor: pointer;
    transition: color var(--dur-state) var(--ease);
  }
  .children.deep .more button { padding-left: calc(var(--s-4) + var(--s-5)); }

  .empty {
    padding-inline: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--c-dim);
  }

  /* A touch affordance: a pointer still has the folder row itself. */
  .index-row { display: none; }
  .index-row a { color: var(--c-link); padding-left: calc(var(--s-4) + var(--s-5)); }

  @media (max-width: 900px) {
    .sidebar {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 3;
      flex-basis: min(86vw, 320px);
      width: min(86vw, 320px);
      transform: translateX(-100%);
      transition: transform var(--dur-state) var(--ease);
    }
    .sidebar[data-open="true"] { transform: translateX(0); }
    .close { display: grid; }
    .searchbar input { font-size: 16px; padding: 10px 12px; }
    .row { line-height: 1.4; min-height: 46px; }
    .row a,
    .foldername,
    .more button { display: flex; align-items: center; min-height: 46px; }
    .twisty { inset: 0; width: 100%; z-index: 2; place-items: center start; padding-left: var(--s-2); }
    .sub .twisty { padding-left: calc(var(--s-2) + var(--s-3)); }
    [data-row] a { pointer-events: none; }
    .index-row { display: flex; }
    .tri { border-top-width: 4.5px; border-bottom-width: 4.5px; border-left-width: 6.5px; }
  }
</style>
