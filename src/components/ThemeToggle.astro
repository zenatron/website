---
/**
 * Three states: follow the system, force light, force dark.
 * Sits in the titlebar, at the window's right edge.
 *
 * One shape per state, in the titlebar's stroke style: a half-filled
 * disc for the system (both, undecided), the sun for light, the moon
 * for dark. Color alone couldn't carry the state at this size — a dim
 * sun and a lit one with pale rays read as the same icon.
 */
---
<button class="theme" type="button" data-theme-toggle aria-label="Theme: follow system">
  <span class="glyph" aria-hidden="true">
    <svg class="g g-system" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="8" cy="8" r="6" />
      <path d="M8 2v12a6 6 0 0 1 0-12Z" fill="currentColor" stroke="none" />
    </svg>
    <svg class="g g-light" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="8" cy="8" r="3.4" />
      <path class="rays" d="M8 .8v2M8 13.2v2M.8 8h2M13.2 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4" stroke-linecap="round" />
    </svg>
    <svg class="g g-dark" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
      <path d="M14 8.53A6 6 0 1 1 7.47 2A4.67 4.67 0 0 0 14 8.53Z" />
    </svg>
  </span>
</button>

<style>
  .theme {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    color: var(--c-muted);
    cursor: pointer;
    transition: background var(--dur-state) var(--ease), color var(--dur-state) var(--ease);
  }
  @media (hover: hover) {
    .theme:hover {
      background: var(--c-raised);
      color: var(--c-text);
    }
  }
  /* Where the drawer is, the titlebar is touched rather than clicked:
     the toggle takes its full height, as the menu button opposite does. */
  @media (max-width: 900px) {
    .theme {
      width: var(--h-titlebar);
      height: var(--h-titlebar);
      margin-inline-end: calc(var(--s-3) * -1);
    }
  }

  /* Explicit choice reads as "you are here"; following the system doesn't. */
  .theme[data-mode="light"],
  .theme[data-mode="dark"] { color: var(--c-accent); }

  /* The shape names the state; the color still grades it. Before the
     script first names a mode, the disc shows — following the system
     is where every visitor starts. */
  .g { display: none; }
  .theme:not([data-mode="light"]):not([data-mode="dark"]) .g-system { display: block; }
  .theme[data-mode="light"] .g-light { display: block; }
  .theme[data-mode="dark"] .g-dark { display: block; }
</style>
