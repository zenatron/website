---
/**
 * Spotlight: ⌘K (or Ctrl K, or the magnifier in the menu bar) from
 * anywhere, a search field floating over the desktop, and everything the
 * site has under it — its places, its projects and posts by title, a few
 * commands, and, on a built site, the words inside the posts.
 *
 * The results are read from the sidebar when the panel opens rather than
 * shipped twice, so the two always list the same things with the same
 * icons; scripts/spotlight.ts does the matching, the keyboard and the
 * Pagefind lookup. It doesn't dim the page, because Spotlight doesn't.
 */
---
<dialog class="spotlight" data-spotlight aria-label="Spotlight search" transition:persist="spotlight">
  <div class="field">
    <svg aria-hidden="true" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <circle cx="7" cy="7" r="4.5" /><path d="m10.4 10.4 3.1 3.1" />
    </svg>
    <input
      type="search"
      placeholder="Spotlight Search"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="spotlight-results"
      aria-autocomplete="list"
      data-spotlight-input
    />
    <kbd class="esc">esc</kbd>
  </div>
  <div class="results" id="spotlight-results" role="listbox" data-spotlight-results></div>
</dialog>

<style>
  .spotlight {
    position: fixed;
    inset: 16vh 0 auto;
    margin: 0 auto;
    padding: 0;
    width: min(640px, calc(100vw - var(--s-6)));
    max-height: 64vh;
    color: var(--c-text);
    background: color-mix(in srgb, var(--c-chrome) 82%, transparent);
    -webkit-backdrop-filter: blur(30px) saturate(1.8);
    backdrop-filter: blur(30px) saturate(1.8);
    border: 1px solid var(--c-hairline-strong);
    border-radius: 16px;
    box-shadow: var(--shadow-window);
    overflow: hidden;
  }
  .spotlight[open] { display: flex; flex-direction: column; }
  .spotlight::backdrop { background: transparent; }
  .spotlight:focus { outline: none; }
  @media (prefers-reduced-motion: no-preference) {
    .spotlight[open] { animation: spot-in 180ms var(--ease); }
  }
  @keyframes spot-in {
    from { opacity: 0; transform: scale(0.97); }
  }

  .field {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 0 var(--s-4);
    height: 56px;
    color: var(--c-muted);
  }
  .field input {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--t-sans-lg);
    color: var(--c-text);
    outline: none;
  }
  .field input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .esc {
    font-size: var(--t-sans-2xs);
    color: var(--c-dim);
    padding: 2px 6px;
    border: 1px solid var(--c-hairline-strong);
    border-radius: var(--radius-chip);
  }

  .results {
    overflow-y: auto;
    padding: 0 var(--s-2) var(--s-2);
    border-top: 1px solid var(--c-hairline);
  }
  .results:empty { display: none; }

  .results :global(.sp-head) {
    padding: var(--s-3) var(--s-2) var(--s-1);
    font-size: 11px;
    font-weight: 600;
    color: var(--c-dim);
  }
  .results :global(.sp-row) {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 38px;
    padding: 4px var(--s-2);
    border-radius: var(--radius-sm);
    color: var(--c-text);
    cursor: default;
  }
  .results :global(.sp-icon) {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    color: var(--c-muted);
  }
  .results :global(.sp-icon svg) { max-width: 100%; max-height: 100%; }
  .results :global(.sp-icon img) { width: 22px; height: 22px; }
  .results :global(.sp-text) {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .results :global(.sp-title) {
    font-size: var(--t-sans-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .results :global(.sp-sub) {
    font-size: var(--t-sans-xs);
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .results :global(.sp-sub mark) { background: none; color: inherit; font-weight: 600; }
  .results :global(.sp-kind) {
    flex: 0 0 auto;
    font-size: var(--t-sans-xs);
    color: var(--c-dim);
  }
  /* The selection, in the accent, as macOS draws a chosen row. */
  .results :global(.sp-row[aria-selected="true"]) {
    background: var(--c-accent);
    color: var(--c-bg);
  }
  .results :global(.sp-row[aria-selected="true"] .sp-sub),
  .results :global(.sp-row[aria-selected="true"] .sp-kind),
  .results :global(.sp-row[aria-selected="true"] .sp-icon) { color: inherit; opacity: 0.85; }
  .results :global(.sp-empty) {
    padding: var(--s-4) var(--s-2);
    color: var(--c-dim);
    font-size: var(--t-sans-sm);
  }
</style>
