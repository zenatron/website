---
/**
 * A window frame around terminal text, for CLI projects that have no
 * screenshots. The content is whatever the project's own README
 * documents — nothing here invents program output.
 */
import Window from "@/components/Window.astro";

interface Props { title?: string; }
const { title = "zsh" } = Astro.props;
---
<Window class="term" title={title}>
  <div class="body"><slot /></div>
</Window>

<style>
  .term {
    margin-block: var(--s-5);
    background: var(--c-sunken);
  }
  .body {
    padding: var(--s-4);
    overflow-x: auto;
  }
  /* The slot carries a fenced code block; strip its own chrome. */
  .body :global(pre) {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }
</style>
