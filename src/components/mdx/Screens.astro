---
/**
 * A row of phone screenshots. The images are 786x1704 exports, so they
 * are shown at device proportions rather than cropped into cards.
 */
interface Shot { src: string; alt: string; caption?: string; }
interface Props { shots: Shot[]; }
const { shots } = Astro.props;
---
<div class="screens">
  {/* Focusable, so a keyboard can scroll the row when it overflows. */}
  <ul tabindex="0" aria-label="Screenshots">
    {shots.map((s) => (
      <li>
        <img src={s.src} alt={s.alt} width="786" height="1704" loading="lazy" decoding="async" />
        {s.caption && <span class="cap">{s.caption}</span>}
      </li>
    ))}
  </ul>
</div>

<style>
  .screens {
    margin-block: var(--s-6);
    /* Wider than the prose measure: these want room. */
    width: min(100%, 1000px);
  }
  /* .screens-qualified: prose's list rules (markers, li + li spacing)
     would otherwise outrank these and stagger the phones. */
  .screens ul {
    list-style: none;
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: 0 0 var(--s-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  /* Sized by the column, not the viewport: the phones share whatever width
     the writing has, and only scroll once each would drop below 150px. */
  .screens li {
    margin: 0;
    flex: 1 1 0;
    min-width: 150px;
    max-width: 236px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  img {
    width: 100%;
    height: auto;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius-card);
    background: var(--c-chrome);
  }
  .cap {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--c-muted);
  }
</style>
