---
/**
 * One page rhythm: a rule, a heading, and on the right either a quiet
 * meta note or a link to the whole of it ("All projects →"). Used for
 * every section on every page — the homepage's bands too — so there's
 * one section heading on the site, not four.
 */
interface Props { title: string; meta?: string; blurb?: string; href?: string; link?: string }
const { title, meta, blurb, href, link } = Astro.props;
---
<div class="sectionhead">
  <div class="line">
    <h2>{title}</h2>
    {href && link ? (
      <a class="more" href={href}>{link} <span aria-hidden="true">&rarr;</span></a>
    ) : meta && <span class="meta">{meta}</span>}
  </div>
  {blurb && <p class="blurb">{blurb}</p>}
</div>

<style>
  .sectionhead {
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-hairline);
    margin-bottom: var(--s-5);
  }
  .line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }
  h2 {
    font-size: var(--t-sans-xl);
    font-weight: 600;
    letter-spacing: var(--track-head);
  }
  .meta {
    flex: 0 0 auto;
    font-size: var(--t-sans-2xs);
    color: var(--c-dim);
  }
  .more {
    flex: 0 0 auto;
    font-size: var(--t-sans-sm);
    color: var(--c-link);
  }
  @media (hover: hover) {
    .more:hover { text-decoration: underline; text-underline-offset: 3px; }
  }
  .blurb {
    margin-top: var(--s-2);
    max-width: 62ch;
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
  }

  /* A step under the page title, which is itself a step down on a phone. */
  @media (max-width: 640px) {
    h2 { font-size: var(--t-sans-lg); }
  }
</style>
