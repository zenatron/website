---
/**
 * One page rhythm: a rule, a heading, and a mono meta note on the right.
 * Used for every band on a listing page so the sections read as parts of
 * one document rather than three separate widgets.
 */
interface Props { title: string; meta?: string; blurb?: string; }
const { title, meta, blurb } = Astro.props;
---
<div class="sectionhead">
  <div class="line">
    <h2>{title}</h2>
    {meta && <span class="meta">{meta}</span>}
  </div>
  {blurb && <p class="blurb">{blurb}</p>}
</div>

<style>
  .sectionhead {
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-hairline);
    margin-bottom: var(--s-5);
  }
  .line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }
  h2 {
    font-size: var(--t-sans-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .meta {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    letter-spacing: 0.06em;
    color: var(--c-dim);
  }
  .blurb {
    margin-top: var(--s-2);
    max-width: 62ch;
    font-size: var(--t-sans-sm);
    color: var(--c-muted);
  }
</style>
